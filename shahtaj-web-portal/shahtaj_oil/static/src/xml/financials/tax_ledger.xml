<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-name="shahtaj_oil.FinancialsTaxLedger" owl="1">
            <t t-if="this.state.activeSubTab === 'tax_ledger'">
                
                <!-- Tax Ledger Header & Controls -->
                <div class="d-flex flex-wrap justify-content-between align-items-center p-3 bg-light border-bottom gap-3">
                    <div>
                        <h5 class="fw-bold text-dark mb-0">Tax Ledger</h5>
                        <small class="text-muted">Sales tax collected on posted shop invoices, reduced by tax on posted credit notes.</small>
                    </div>
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <div class="d-flex align-items-center bg-white p-1 rounded-3 shadow-sm border px-2">
                            <span class="text-muted fw-bold small text-uppercase me-2">Period:</span>
                            <input type="date" class="form-control form-control-sm border-0 bg-light" style="width: 130px;" t-model="this.state.taxLedger.date_from" t-att-max="this.todayStr"/>
                            <span class="text-muted small mx-2">to</span>
                            <input type="date" class="form-control form-control-sm border-0 bg-light" style="width: 130px;" t-model="this.state.taxLedger.date_to" t-att-max="this.todayStr"/>
                        </div>
                        <button class="btn btn-sm btn-dark fw-bold px-3 shadow-sm" t-on-click="() => this.fetchTaxLedgerData()" t-att-disabled="this.state.taxLedger.isLoading">
                            <span t-if="this.state.taxLedger.isLoading" class="spinner-border spinner-border-sm me-1"/>
                            <i t-else="" class="fa fa-refresh me-1"></i> Refresh
                        </button>
                        <div class="vr mx-1"></div>
                        <button class="btn btn-sm btn-outline-primary fw-bold shadow-sm bg-white" t-on-click="() => this.requestTabSwitch('warehouse', 'taxes')" title="Create or update global tax definitions">
                            <i class="fa fa-percent me-1"></i> Manage &amp; Create Taxes
                        </button>
                       <button class="btn btn-sm btn-outline-secondary fw-bold shadow-sm bg-white" t-on-click="() => this.requestTabSwitch('financials', 'customer_invoices')" title="Open the customer invoices list to view specific documents">
                            <i class="fa fa-file-text-o me-1"></i> Open Taxed Documents
                        </button>
                    </div>
                                    </div>

                <!-- KPI Cards -->
                <div class="p-4 bg-light">
                    <div class="row g-4 mb-4">
                        <!-- Tax on Invoices -->
                        <div class="col-md-4">
                            <div class="card bg-white border-0 shadow-sm h-100 rounded-4 overflow-hidden position-relative">
                                <div class="position-absolute top-0 start-0 w-100" style="height: 4px; background: linear-gradient(90deg, #3b82f6, #60a5fa);"></div>
                                <div class="card-body p-4">
                                    <div class="d-flex justify-content-between align-items-start mb-3">
                                        <div>
                                            <span class="fw-bold text-muted text-uppercase tracking-wider small d-block mb-1">Tax on Invoices</span>
                                            <h3 class="fw-bold text-dark mb-0">Rs. <t t-esc="this.state.taxLedger.stats.amount_tax_invoiced ? this.state.taxLedger.stats.amount_tax_invoiced.toLocaleString(undefined, {minimumFractionDigits: 2}) : '0.00'"/></h3>
                                    </div>
                                        <div class="text-white rounded-circle d-flex align-items-center justify-content-center bg-primary bg-opacity-10 shadow-sm" style="width: 45px; height: 45px;">
                                            <i class="fa fa-arrow-up fs-5"></i>
                                </div>
                            </div>
                                    <div class="pt-2 border-top mt-3">
                                        <small class="text-muted">Tax charged to shops in the period.</small>
                        </div>
                                </div>
                            </div>
                        </div>

                        <!-- Tax on Credit Notes -->
                        <div class="col-md-4">
                            <div class="card bg-white border-0 shadow-sm h-100 rounded-4 overflow-hidden position-relative">
                                <div class="position-absolute top-0 start-0 w-100" style="height: 4px; background: linear-gradient(90deg, #ef4444, #f87171);"></div>
                                <div class="card-body p-4">
                                    <div class="d-flex justify-content-between align-items-start mb-3">
                                        <div>
                                            <span class="fw-bold text-muted text-uppercase tracking-wider small d-block mb-1">Tax on Credit Notes</span>
                                            <h3 class="fw-bold text-danger mb-0">Rs. <t t-esc="this.state.taxLedger.stats.amount_tax_credited ? this.state.taxLedger.stats.amount_tax_credited.toLocaleString(undefined, {minimumFractionDigits: 2}) : '0.00'"/></h3>
                            </div>
                                        <div class="text-white rounded-circle d-flex align-items-center justify-content-center bg-danger bg-opacity-10 shadow-sm" style="width: 45px; height: 45px;">
                                            <i class="fa fa-arrow-down fs-5"></i>
                                        </div>
                                    </div>
                                    <div class="pt-2 border-top mt-3">
                                        <small class="text-muted">Tax reversed on returns / corrections.</small>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Net Tax Collected -->
                        <div class="col-md-4">
                            <div class="card bg-white border-0 shadow-sm h-100 rounded-4 overflow-hidden position-relative">
                                <div class="position-absolute top-0 start-0 w-100" t-attf-style="height: 4px; background: linear-gradient(90deg, #{this.state.taxLedger.stats.amount_tax_net &lt; 0 ? '#ef4444, #f87171' : '#10b981, #34d399'});"></div>
                                <div class="card-body p-4">
                                    <div class="d-flex justify-content-between align-items-start mb-3">
                                        <div>
                                            <span class="fw-bold text-muted text-uppercase tracking-wider small d-block mb-1">Net Tax Collected</span>
                                            <h3 t-attf-class="fw-bold mb-0 #{this.state.taxLedger.stats.amount_tax_net &lt; 0 ? 'text-danger' : 'text-success'}">
                                                Rs. <t t-esc="this.state.taxLedger.stats.amount_tax_net ? this.state.taxLedger.stats.amount_tax_net.toLocaleString(undefined, {minimumFractionDigits: 2}) : '0.00'"/>
                                            </h3>
                                        </div>
                                        <div t-attf-class="rounded-circle d-flex text-white align-items-center justify-content-center shadow-sm #{this.state.taxLedger.stats.amount_tax_net &lt; 0 ? 'bg-danger text-danger' : 'bg-success text-success'} bg-opacity-10" style="width: 45px; height: 45px;">
                                            <i class="fa fa-bank fs-5"></i>
                                        </div>
                                    </div>
                                    <div class="pt-2 border-top mt-3">
                                        <small class="text-muted">Invoices − credit notes (overall tax given).</small>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Summary Table -->
                    <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
                        <div class="card-header bg-white border-bottom py-3">
                            <h6 class="fw-bold text-dark mb-0"><i class="fa fa-pie-chart text-primary me-2"></i>Summary By Tax Type</h6>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="bg-light text-uppercase small fw-bold text-muted">
                                    <tr>
                                        <th class="ps-4">Tax Type</th>
                                        <th class="text-center">Rate</th>
                                        <th class="text-end">Taxable (Invoices)</th>
                                        <th class="text-end">Tax Invoiced</th>
                                        <th class="text-end">Taxable (Credit Notes)</th>
                                        <th class="text-end">Tax Credited</th>
                                        <th class="text-end">Net Tax</th>
                                        <th class="text-center pe-4">Entries</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-if="this.state.taxLedger.isLoading">
                                        <tr><td colspan="8" class="text-center py-5 text-muted"><span class="spinner-border spinner-border-sm text-secondary me-2"></span> Calculating Tax Ledger...</td></tr>
                                    </t>
                                    <t t-elif="this.state.taxLedger.summaries.length === 0">
                                        <tr><td colspan="8" class="text-center py-5 text-muted">
                                            <i class="fa fa-pie-chart fs-1 mb-3 opacity-50"></i>
                                            <p class="mb-1 fw-bold fs-5 text-dark">No tax summaries found.</p>
                                        </td></tr>
                                    </t>
                                    <t t-foreach="this.state.taxLedger.summaries" t-as="sum" t-key="sum.id">
                                        <tr>
                                            <td class="ps-4 fw-bold text-dark"><t t-esc="sum.tax_name"/></td>
                                            <td class="text-center"><span class="badge bg-light text-dark border shadow-sm"><t t-esc="sum.tax_rate"/>%</span></td>
                                            <td class="text-end">Rs. <t t-esc="sum.base_invoiced.toLocaleString(undefined, {minimumFractionDigits: 2})"/></td>
                                            <td class="text-end fw-bold text-dark">Rs. <t t-esc="sum.tax_invoiced.toLocaleString(undefined, {minimumFractionDigits: 2})"/></td>
                                            <td class="text-end">Rs. <t t-esc="sum.base_credited.toLocaleString(undefined, {minimumFractionDigits: 2})"/></td>
                                            <td class="text-end fw-bold text-danger">Rs. <t t-esc="sum.tax_credited.toLocaleString(undefined, {minimumFractionDigits: 2})"/></td>
                                            <td t-attf-class="text-end fw-bold #{sum.tax_net &lt; 0 ? 'text-danger' : 'text-success'}">Rs. <t t-esc="sum.tax_net.toLocaleString(undefined, {minimumFractionDigits: 2})"/></td>
                                            <td class="text-center pe-4"><span class="badge bg-secondary text-dark"><t t-esc="sum.line_count"/></span></td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- History Table -->
                    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                        <div class="card-header bg-white border-bottom py-3">
                            <h6 class="fw-bold text-dark mb-0"><i class="fa fa-history text-primary me-2"></i>Detailed Tax History</h6>
                        </div>
                        <div class="table-responsive" style="max-height: 400px; overflow-y: auto;">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="bg-light text-uppercase small fw-bold text-muted sticky-top" style="z-index: 1;">
                                    <tr>
                                        <th class="ps-4 py-3 border-bottom">Date</th>
                                        <th class="border-bottom">Document Type</th>
                                        <th class="border-bottom">Document #</th>
                                        <th class="border-bottom">Shop</th>
                                        <th class="border-bottom">Tax Applied</th>
                                        <th class="text-end border-bottom">Taxable Base</th>
                                        <th class="text-end pe-4 border-bottom">Tax Amount</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-if="this.state.taxLedger.isLoading">
                                        <tr><td colspan="7" class="text-center py-5 text-muted"><span class="spinner-border spinner-border-sm text-secondary me-2"></span> Loading ledger history...</td></tr>
                                    </t>
                                    <t t-elif="this.paginatedTaxHistory.length === 0">
                                        <tr><td colspan="7" class="text-center py-5 text-muted">
                                            <i class="fa fa-history fs-1 mb-3 opacity-50"></i>
                                            <p class="mb-1 fw-bold fs-5 text-dark">No detailed history found for this period.</p>
                                        </td></tr>
                                    </t>
                                    <t t-foreach="this.paginatedTaxHistory" t-as="hist" t-key="hist.id">
                                        <tr>
                                            <td class="ps-4"><t t-esc="hist.date"/></td>
                                            <td>
                                                <span t-attf-class="badge #{hist.document_type === 'Invoice' ? 'bg-primary' : 'bg-danger'} bg-opacity-10 text-white border shadow-sm">
                                                    <t t-esc="hist.document_type"/>
                                                </span>
                                            </td>
                                            <td class="fw-bold"><t t-esc="hist.move_name"/></td>
                                            <td><t t-esc="hist.partner_name"/></td>
                                            <td class="text-muted"><t t-esc="hist.tax_name"/></td>
                                            <td class="text-end">Rs. <t t-esc="hist.base_amount.toLocaleString(undefined, {minimumFractionDigits: 2})"/></td>
                                            <td t-attf-class="text-end pe-4 fw-bold #{hist.tax_amount &lt; 0 ? 'text-danger' : 'text-success'}">Rs. <t t-esc="hist.tax_amount.toLocaleString(undefined, {minimumFractionDigits: 2})"/></td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                            <div class="p-2 border-top d-flex justify-content-between align-items-center bg-light">
                            <small class="text-muted fw-bold">Pg <t t-esc="this.state.taxLedger.page"/> of <t t-esc="Math.max(1, Math.ceil(this.state.taxLedger.history.length / this.state.taxLedger.limit))"/></small>
                            <div class="btn-group shadow-sm">
                                <button class="btn btn-sm btn-light bg-white border fw-bold" t-on-click="() => this.changeTransientPage('taxLedger', -1)">Prev</button>
                                <button class="btn btn-sm btn-light bg-white border fw-bold" t-on-click="() => this.changeTransientPage('taxLedger', 1)">Next</button>
                            </div>
                        </div>
                        </div>
                    </div>
                </div>
            </t>
    </t>
</templates>
