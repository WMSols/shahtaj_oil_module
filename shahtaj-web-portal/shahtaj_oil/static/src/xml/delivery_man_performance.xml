<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-name="shahtaj_oil.DeliveryManPerformance" owl="1">
        <div class="card border-0 shadow-sm bg-white p-3 p-md-4 rounded-3">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 border-bottom pb-3 gap-3">
                <div>
                    <h2 class="h4 fw-bold text-dark mb-0">Delivery Men Performance</h2>
                    <small class="text-muted">Daily delivery progress. Pick a day to see that day's assigned jobs.</small>
                </div>
                <div class="d-flex flex-wrap gap-2 align-items-center">
                    <button class="btn btn-outline-secondary fw-bold" t-on-click="refreshActive" t-att-disabled="this.state.isLoading">
                        <i class="fa fa-refresh me-1" t-att-class="{'fa-spin': this.state.isLoading}"/> Refresh
                    </button>
                </div>
            </div>

            <t t-if="!this.state.selectedDm">
                <div class="d-flex flex-wrap gap-2 mb-3 align-items-center">
                    <div class="input-group input-group-sm shadow-sm" style="max-width: 260px;">
                        <span class="input-group-text bg-white border-end-0"><i class="fa fa-search text-muted"></i></span>
                        <input type="text" class="form-control border-start-0 ps-0" placeholder="Search name or code..."
                               t-att-value="this.state.filters.search"
                               t-on-input="onSearchInput"/>
                    </div>
                    <input type="date" class="form-control form-control-sm" style="max-width: 180px;" t-model="this.state.date" t-on-change="refreshActive"/>
                    <button class="btn btn-sm btn-outline-secondary fw-bold" t-on-click="printSummary" t-att-disabled="this.state.isPrinting or this.state.isLoading" title="Print the rows that match the current filters">
                        <i class="fa fa-print me-1"/> Print
                    </button>
                    <button class="btn btn-sm btn-outline-secondary fw-bold" t-on-click="() => this.clearFilters('performance')" t-att-disabled="this.state.isLoading" title="Clear all filters on this list">
                        <i class="fa fa-times me-1"/> Clear filters
                    </button>
                    <select class="form-select form-select-sm" style="max-width: 200px;" t-on-change="onDmFilterChange">
                        <option value="all" t-att-selected="this.state.filters.dm === 'all'">All delivery men</option>
                        <t t-foreach="this.state.deliveryMen" t-as="dm" t-key="dm.id">
                            <option t-att-value="dm.id" t-att-selected="this.isDmSelected(dm.id)"><t t-esc="dm.name"/></option>
                        </t>
                    </select>
                </div>
                <div class="position-relative">
                    <t t-if="this.state.isLoading">
                        <div class="position-absolute w-100 h-100 d-flex justify-content-center align-items-center bg-white" style="z-index: 10; opacity: 0.7;">
                            <div class="spinner-border text-primary" role="status"></div>
                        </div>
                    </t>
                    <div class="table-responsive">
                        <table class="table table-hover mb-0 align-middle">
                            <thead class="bg-light text-uppercase small fw-bold text-muted">
                                <tr>
                                    <th class="ps-3 border-top-0">Delivery man</th>
                                    <th class="border-top-0" style="width: 180px;">Progress %</th>
                                    <th class="text-center border-top-0">Done</th>
                                    <th class="text-center border-top-0">Pending</th>
                                    <th class="text-center border-top-0">Assigned</th>
                                    <th class="border-top-0">Online</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-if="!this.state.rows.length and !this.state.isLoading">
                                    <tr><td colspan="6" class="text-center py-5 text-muted fw-bold">No delivery men match these filters.</td></tr>
                                </t>
                                <t t-foreach="this.state.rows" t-as="row" t-key="row.id">
                                    <tr class="cursor-pointer" style="cursor: pointer;" t-on-click="() => this.openDm(row)">
                                        <td class="ps-3">
                                            <div class="fw-bold"><t t-esc="row.name"/></div>
                                            <small class="text-muted" t-if="row.code"><t t-esc="row.code"/></small>
                                        </td>
                                        <td>
                                            <div class="progress" style="height: 8px;">
                                                <div class="progress-bar bg-primary" role="progressbar"
                                                     t-att-style="'width: ' + Math.min(100, Math.max(0, row.progress)) + '%;'"/>
                                            </div>
                                            <small class="text-muted"><t t-esc="Math.round(row.progress)"/>%</small>
                                        </td>
                                        <td class="text-center"><t t-esc="row.done"/></td>
                                        <td class="text-center"><t t-esc="row.pending"/></td>
                                        <td class="text-center"><t t-esc="row.assigned"/></td>
                                        <td><span t-attf-class="badge #{this.statusClass(row.status)}"><t t-esc="this.statusLabel(row.status)"/></span></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                    <div class="p-3 border-top d-flex justify-content-between align-items-center bg-light">
                        <small class="text-muted fw-bold">
                            Showing <t t-esc="this.state.pagination.total === 0 ? 0 : ((this.state.pagination.page - 1) * this.state.pagination.limit) + 1"/>
                            to <t t-esc="Math.min(this.state.pagination.page * this.state.pagination.limit, this.state.pagination.total)"/>
                            of <t t-esc="this.state.pagination.total"/>
                        </small>
                        <div class="btn-group shadow-sm">
                            <button class="btn btn-sm btn-white border fw-bold" t-on-click="() => this.changePage(-1)" t-att-disabled="this.state.pagination.page === 1">Prev</button>
                            <button class="btn btn-sm btn-light border px-3 fw-bold disabled text-dark"><t t-esc="this.state.pagination.page"/> / <t t-esc="Math.max(1, Math.ceil(this.state.pagination.total / this.state.pagination.limit))"/></button>
                            <button class="btn btn-sm btn-white border fw-bold" t-on-click="() => this.changePage(1)" t-att-disabled="this.state.pagination.page &gt;= Math.ceil(this.state.pagination.total / this.state.pagination.limit)">Next</button>
                        </div>
                    </div>
                </div>
            </t>

            <t t-if="this.state.selectedDm">
                <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                    <div>
                        <button class="btn btn-sm btn-outline-secondary me-2" t-on-click="closeDm">← Back</button>
                        <span class="fw-bold"><t t-esc="this.state.selectedDm.name"/></span>
                    </div>
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <button class="btn btn-sm btn-outline-secondary fw-bold"
                                t-on-click="printDayActivity"
                                t-att-disabled="this.state.isPrinting or this.state.isLoading"
                                title="Print this delivery man's jobs for the selected day">
                            <i class="fa fa-print me-1"/> Print Day
                        </button>
                        <span class="badge bg-primary text-white">
                            <t t-esc="this.state.selectedDm.done"/> / <t t-esc="this.state.selectedDm.assigned"/> done
                            · <t t-esc="Math.round(this.state.selectedDm.progress)"/>%
                        </span>
                    </div>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover mb-0 align-middle">
                        <thead class="bg-light text-uppercase small fw-bold text-muted">
                            <tr>
                                <th class="ps-3 border-top-0">Date</th>
                                <th class="border-top-0">Order</th>
                                <th class="border-top-0">Shop</th>
                                <th class="border-top-0">Stock</th>
                                <th class="border-top-0">Stop</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-if="!this.state.jobs.length and !this.state.isLoading">
                                <tr><td colspan="5" class="text-center py-4 text-muted">No delivery jobs.</td></tr>
                            </t>
                            <t t-foreach="this.state.jobs" t-as="job" t-key="job.id">
                                <tr>
                                    <td class="ps-3 text-nowrap"><t t-esc="job.date"/></td>
                                    <td class="fw-bold"><t t-esc="job.order"/></td>
                                    <td>
                                        <t t-esc="job.shop"/>
                                        <span t-if="job.isWalkIn" class="badge bg-warning text-dark ms-2">Walk-in</span>
                                    </td>
                                    <td><span t-attf-class="badge #{this.stockClass(job.state)}"><t t-esc="this.stockLabel(job.state)"/></span></td>
                                    <td><span t-attf-class="badge #{this.stopClass(job.fieldState)}"><t t-esc="this.stopLabel(job.fieldState)"/></span></td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>

                <h6 class="fw-bold text-muted text-uppercase small mt-4 mb-3">Recent Pick &amp; Deliver</h6>
                <div class="table-responsive bg-white rounded-3 border">
                    <table class="table table-hover table-striped mb-0 align-middle">
                        <thead class="bg-light text-uppercase small fw-bold text-muted">
                            <tr>
                                <th class="ps-3 border-top-0">Updated</th>
                                <th class="border-top-0">Order</th>
                                <th class="border-top-0">Shop</th>
                                <th class="text-end border-top-0">Picked</th>
                                <th class="text-end border-top-0">Delivered</th>
                                <th class="text-end border-top-0">On Van</th>
                                <th class="pe-3 border-top-0">Stock</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-if="!this.state.recentActivity.length and !this.state.isLoading">
                                <tr><td colspan="7" class="text-center py-4 text-muted">No pick or deliver activity yet.</td></tr>
                            </t>
                            <t t-foreach="this.state.recentActivity" t-as="row" t-key="row.id">
                                <tr>
                                    <td class="ps-3 text-nowrap"><t t-esc="row.updated"/></td>
                                    <td class="fw-bold"><t t-esc="row.order"/></td>
                                    <td><t t-esc="row.shop"/></td>
                                    <td class="text-end"><t t-esc="this.formatQty(row.picked)"/></td>
                                    <td class="text-end"><t t-esc="this.formatQty(row.delivered)"/></td>
                                    <td class="text-end fw-bold"><t t-esc="this.formatQty(row.onVan)"/></td>
                                    <td class="pe-3"><span t-attf-class="badge #{this.stockClass(row.state)}"><t t-esc="this.stockLabel(row.state)"/></span></td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
                <p class="small text-muted mt-2 mb-0">Shows the latest jobs with pick or deliver quantities. <b>On Van</b> = picked minus delivered for that stop.</p>
            </t>
        </div>
    </t>
</templates>
