<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-name="shahtaj_oil.TerritoryRouteList" owl="1">
        <div>
<!-- Routes Tab -->
                        <t t-if="this.state.activeSubTab === 'routes'">
                <!-- ROUTE LIST VIEW -->
                <t t-if="!this.state.selectedRouteDetails">
                    <div class="p-4 bg-white border-bottom d-flex justify-content-between align-items-center flex-wrap gap-3">
                        <div>
                            <h2 class="fw-bold mb-0">Route Configurations</h2>
                            <small class="text-muted">Routes are specific paths within a Zone.</small>
                            <small class="text-muted d-block mt-1">
                                Total assigned shops: <strong class="text-dark" t-esc="this.state.totalAssignedShops"/>
                            </small>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                           <div class="input-group input-group-sm shadow-sm" style="width: 250px;">
                                <span class="input-group-text bg-white text-muted border-end-0"><i class="fa fa-search"></i></span>
                                <input type="text" class="form-control border-start-0 ps-0" placeholder="Search route name..." 
                                       t-model="this.state.routeSearchQuery" t-on-input="() => this.onSearchInput('routes')" />
                            </div>
                            <div class="d-flex gap-2">
                                <select class="form-select form-select-sm shadow-sm" style="width: 150px;" t-model="this.state.routeFilterZone" t-on-change="() => this.onFilterChange('routes')">
                                <option value="all">All Zones</option>
                                <t t-foreach="this.state.areas.filter(a => a.active)" t-as="a" t-key="a.id">
                                        <option t-att-value="a.id">
                                            <t t-esc="a.name"/>
                                        </option>
                                    </t>
                            </select>
                            </div>
                            
                            <button class="btn btn-sm btn-dark d-flex align-items-center text-white ms-2 shadow-sm" t-on-click="() => this.state.showRouteForm = true" title="Create a new travel route">
                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-plus me-1">
                                    <path d="M5 12h14"/>
                                    <path d="M12 5v14"/>
                                </svg>
                            New Route
                            </button>
                        </div>
                    </div>

                    <t t-if="this.state.showRouteForm">
                        <div class="p-4 bg-light border-bottom">
                            <div class="row align-items-end">
                                <div class="col-md-4">
                                    <label class="small fw-bold">Route Name</label>
                                    <input type="text" class="form-control" t-model="this.state.routeForm.name" placeholder="e.g. Main Market North"/>
                                </div>
                                <div class="col-md-4">
                                <label class="small fw-bold">Parent Zone</label>
                                <select class="form-control" t-model="this.state.routeForm.zone_id">
                                    <option value="">Select a Zone...</option>
                                    <t t-foreach="this.state.areas.filter(a => a.active)" t-as="a" t-key="a.id">
                                        <option t-att-value="a.id">
                                            <t t-esc="a.name"/>
                                        </option>
                                    </t>
                                </select>
                            </div>
                                <div class="col-md-2">
                                    <div class="form-check form-switch" title="Disable to temporarily pause visits on this route">
                                        <input class="form-check-input cursor-pointer" type="checkbox" id="routeActiveSwitch" t-model="this.state.routeForm.is_active"/>
                                        <label class="form-check-label small fw-bold cursor-pointer" for="routeActiveSwitch">Active Status</label>
                                    </div>
                                </div>
                                <div class="col-md-2 d-flex pb-3">
                                    <button class="btn btn-outline-secondary me-2 w-100" t-on-click="cancelForms">Cancel</button>
                                    <button class="btn btn-success w-100 text-white fw-bold" t-on-click="saveRoute">
                                        <t t-esc="this.state.editingRouteId ? 'Update' : 'Save'"/>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </t>
                    <div class="position-relative">
                        <t t-if="this.state.isLoadingList">
                            <div class="position-absolute w-100 h-100 d-flex justify-content-center align-items-center bg-white" style="z-index: 10; opacity: 0.7;">
                                <div class="spinner-border text-primary" role="status"></div>
                            </div>
                        </t>
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead class="bg-light text-uppercase small fw-bold text-muted">
                                    <tr>
                                        <th class="border-top-0 ps-4">Route Info</th>
                                        <th class="border-top-0 text-center" title="Total number of shops assigned to this route">Assigned Shops</th>
                                        <th class="border-top-0 text-center">Status</th>
                                        <th class="border-top-0 text-end pe-4">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-if="this.state.tableRoutes.length === 0">
                                        <tr>
                                            <td colspan="4" class="text-center py-5 text-muted fw-bold">No routes found.</td>
                                        </tr>
                                    </t>
                                    <t t-foreach="this.state.tableRoutes" t-as="route" t-key="route.id">
                                        <tr>
                                            <td class="ps-4 align-middle">
                                                <div class="text-dark fw-bold"><t t-esc="route.name"/></div>
                                                <small class="text-muted d-flex align-items-center mt-1">
                                                    <i class="fa fa-map-marker me-1"></i> <t t-esc="route.zone_id ? route.zone_id[1] : 'Unassigned'"/>
                                                </small>
                                            </td>
                                            <td class="align-middle text-center">
                                                <span class="badge bg-light text-dark border px-2 py-1"><t t-esc="route.shop_count"/></span>
                                            </td>
                                            <td class="align-middle text-center">
                                                <span t-attf-class="small fw-bold #{route.active ? 'text-success' : 'text-secondary'}">
                                                    <t t-esc="route.active ? 'Active' : 'Inactive'"/>
                                                </span>
                                            </td>
                                            <td class="align-middle text-end pe-4">
                                                <button class="btn btn-sm btn-outline-primary me-2" t-on-click="() => this.editRoute(route)" title="Edit Route Details">Edit</button>
                                                <button class="btn btn-sm btn-outline-dark fw-bold me-2" t-on-click="() => this.viewRouteDetails(route)">Manage Checklist →</button>
                                                <button class="btn btn-sm btn-outline-danger" t-on-click="() => this.toggleArchive('shahtaj.route', route.id, false)" title="Move to Archive">Archive</button>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                        <!-- PAGINATION FOOTER -->
                        <div class="p-3 border-top d-flex justify-content-between align-items-center bg-light">
                            <small class="text-muted fw-bold">
                                Showing <t t-esc="this.state.pagination.routes.total === 0 ? 0 : ((this.state.pagination.routes.page - 1) * this.state.pagination.routes.limit) + 1"/>
                                to <t t-esc="Math.min(this.state.pagination.routes.page * this.state.pagination.routes.limit, this.state.pagination.routes.total)"/>
                                of <t t-esc="this.state.pagination.routes.total"/>
                            </small>
                            <div class="btn-group shadow-sm">
                                <button class="btn btn-sm btn-white border fw-bold" t-on-click="() => this.changePage('routes', -1)" t-att-disabled="this.state.pagination.routes.page === 1">Prev</button>
                                <button class="btn btn-sm btn-light border px-3 fw-bold disabled text-dark"><t t-esc="this.state.pagination.routes.page"/> / <t t-esc="Math.max(1, Math.ceil(this.state.pagination.routes.total / this.state.pagination.routes.limit))"/></button>
                                <button class="btn btn-sm btn-white border fw-bold" t-on-click="() => this.changePage('routes', 1)" t-att-disabled="this.state.pagination.routes.page &gt;= Math.ceil(this.state.pagination.routes.total / this.state.pagination.routes.limit)">Next</button>
                            </div>
                        </div>
                    </div>
                </t>

                <!-- NEW ROUTE DETAIL & CHECKLIST VIEW -->
                <t t-else="">
                    <div class="p-4 bg-light h-100">
                        <button class="btn btn-sm btn-light border shadow-sm fw-bold text-dark d-flex align-items-center mb-4" t-on-click="closeRouteDetails">
                            <i class="fa fa-arrow-left me-2"></i> Back to Routes
                        </button>
                        
                        <div class="row g-4 mb-4">
                            <!-- Left: Route Info -->
                            <div class="col-md-6">
                                <div class="card border-0 shadow-sm rounded-3 h-100 p-4">
                                    <h4 class="fw-bold text-dark mb-4">Route: <t t-esc="this.state.selectedRouteDetails.name"/></h4>
                                    
                                    <label class="small fw-bold text-muted mb-2">Parent Zone</label>
                                    <div class="d-flex flex-column gap-2">
                                        <select class="form-select shadow-sm" t-model="this.state.selectedRouteDetails.edit_zone_id">
                                            <t t-foreach="this.state.areas.filter(a => a.active)" t-as="a" t-key="a.id">
                                                <option t-att-value="a.id"><t t-esc="a.name"/></option>
                                            </t>
                                        </select>
                                        
                                        <button class="btn btn-outline-success fw-bold  shadow-sm px-2" t-on-click="saveRouteZone">Save Zone</button>
                                    </div>
                                </div>
                            </div>
                            
                            <!-- Right: Stats -->
                            <div class="col-md-6">
                                <div class="card border-0 shadow-sm rounded-3 h-100 p-4  text-dark">
                                    <h6 class="fw-bold text-uppercase mb-4 text-dark-50">Assignment Overview</h6>
                                    <div class="d-flex justify-content-between align-items-center mb-3 pb-3 border-bottom border-secondary">
                                        <span class="fs-5">Mapped Shops on this Route</span>
                                        <span class="badge bg-info text-white fs-5"><t t-esc="this.state.selectedRouteDetails.shop_count"/></span>
                                    </div>
                                    <!-- <div class="d-flex justify-content-between align-items-center">
                                        <span class="fs-5">Total Unassigned Shops</span>
                                        <span class="badge bg-warning text-dark fs-5"><t t-esc="this.state.selectedRouteDetails.unassigned_shop_count"/></span>
                                    </div> -->
                                </div>
                            </div>
                        </div>

                        <!-- Assigned shops on this route -->
                        <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
                            <div class="p-3 bg-white border-bottom d-flex justify-content-between align-items-center flex-wrap gap-2">
                                <h6 class="fw-bold mb-0 text-dark"><i class="fa fa-list-ul text-primary me-2"></i> Assigned Shops</h6>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="input-group input-group-sm shadow-sm" style="width: 220px;">
                                        <span class="input-group-text bg-white border-end-0"><i class="fa fa-search text-muted"></i></span>
                                        <input type="text" class="form-control border-start-0 ps-0" placeholder="Search assigned shops..."
                                               t-model="this.state.routeChecklistSearchQuery" t-on-input="onChecklistSearchInput" />
                                    </div>
                                    <button class="btn btn-sm btn-dark fw-bold text-white shadow-sm d-flex align-items-center"
                                            t-on-click="openAddShopModal"
                                            title="Add shops to this route">
                                        <i class="fa fa-plus me-1"></i> Add Shop
                                    </button>
                                </div>
                            </div>
                            <div class="px-3 py-2 bg-light border-bottom small text-muted">
                                Only shops on this route. Use <strong>Add Shop</strong> to assign more (a shop may already be on other routes).
                            </div>

                            <div class="position-relative">
                                <t t-if="this.state.isLoadingList">
                                    <div class="position-absolute w-100 h-100 d-flex justify-content-center align-items-center bg-white" style="z-index: 10; opacity: 0.7;">
                                        <div class="spinner-border text-primary" role="status"></div>
                                    </div>
                                </t>
                                <div class="table-responsive" style="min-height: 300px;">
                                    <table class="table table-hover align-middle mb-0">
                                        <thead class="bg-light text-uppercase small fw-bold text-muted">
                                            <tr>
                                                <th class="ps-4">Shop Name</th>
                                                <th>Owner</th>
                                                <th class="text-end pe-4">Actions</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-if="this.state.tableRouteChecklist.length === 0 and !this.state.isLoadingList">
                                                <tr>
                                                    <td colspan="3" class="text-center py-4 text-muted fw-bold">
                                                        No shops assigned to this route yet. Click <strong>Add Shop</strong> to assign.
                                                    </td>
                                                </tr>
                                            </t>
                                            <t t-foreach="this.state.tableRouteChecklist" t-as="cshop" t-key="cshop.id">
                                                <tr>
                                                    <td class="ps-4 fw-bold text-dark"><t t-esc="cshop.name"/></td>
                                                    <td class="text-muted"><t t-esc="cshop.owner_name || 'N/A'"/></td>
                                                    <td class="text-end pe-4">
                                                        <button class="btn btn-sm btn-outline-danger fw-bold"
                                                                t-on-click="() => this.removeShopFromRoute(cshop)"
                                                                title="Remove from this route only">
                                                            Remove
                                                        </button>
                                                    </td>
                                                </tr>
                                            </t>
                                        </tbody>
                                    </table>
                                </div>
                                <div class="p-3 border-top d-flex justify-content-between align-items-center bg-light">
                                    <small class="text-muted fw-bold">
                                        Showing <t t-esc="this.state.pagination.routeChecklist.total === 0 ? 0 : ((this.state.pagination.routeChecklist.page - 1) * this.state.pagination.routeChecklist.limit) + 1"/>
                                        to <t t-esc="Math.min(this.state.pagination.routeChecklist.page * this.state.pagination.routeChecklist.limit, this.state.pagination.routeChecklist.total)"/>
                                        of <t t-esc="this.state.pagination.routeChecklist.total"/>
                                    </small>
                                    <div class="btn-group shadow-sm">
                                        <button class="btn btn-sm btn-white border fw-bold" t-on-click="() => this.changeChecklistPage(-1)" t-att-disabled="this.state.pagination.routeChecklist.page === 1">Prev</button>
                                        <button class="btn btn-sm btn-light border px-3 fw-bold disabled text-dark"><t t-esc="this.state.pagination.routeChecklist.page"/> / <t t-esc="Math.max(1, Math.ceil(this.state.pagination.routeChecklist.total / this.state.pagination.routeChecklist.limit))"/></button>
                                        <button class="btn btn-sm btn-white border fw-bold" t-on-click="() => this.changeChecklistPage(1)" t-att-disabled="this.state.pagination.routeChecklist.page &gt;= Math.ceil(this.state.pagination.routeChecklist.total / this.state.pagination.routeChecklist.limit)">Next</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </t>
            </t>


        <!-- Add shops to route (multi-select) -->
        <t t-if="this.state.showAddShopModal">
            <div class="position-fixed top-0 start-0 w-100 h-100 d-flex justify-content-center align-items-center"
                 style="background-color: rgba(0, 0, 0, 0.55); z-index: 1060; padding: 1rem;"
                 t-on-click="closeAddShopModal">
                <div class="bg-white rounded-3 shadow-lg border-0 w-100 d-flex flex-column"
                     style="max-width: 720px; max-height: 85vh;"
                     t-on-click.stop="">
                    <div class="p-3 border-bottom d-flex justify-content-between align-items-center bg-light rounded-top-3">
                        <div>
                            <h5 class="fw-bold text-dark mb-0">Add Shops to Route</h5>
                            <small class="text-muted">
                                Select shops not yet on
                                <strong><t t-esc="this.state.selectedRouteDetails and this.state.selectedRouteDetails.name"/></strong>
                            </small>
                        </div>
                        <button type="button" class="btn-close" t-on-click="closeAddShopModal" aria-label="Close"></button>
                    </div>
                    <div class="p-3 border-bottom d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <div class="input-group input-group-sm shadow-sm" style="max-width: 280px;">
                            <span class="input-group-text bg-white border-end-0"><i class="fa fa-search text-muted"></i></span>
                            <input type="text" class="form-control border-start-0 ps-0"
                                   placeholder="Search shop or owner..."
                                   t-model="this.state.addShopSearchQuery"
                                   t-on-input="onAddShopSearchInput"/>
                        </div>
                        <small class="text-muted fw-bold">
                            <t t-esc="this.addShopSelectedCount"/> selected
                        </small>
                    </div>
                    <div class="position-relative flex-grow-1 overflow-auto" style="min-height: 280px;">
                        <t t-if="this.state.isLoadingAddShops">
                            <div class="position-absolute w-100 h-100 d-flex justify-content-center align-items-center bg-white" style="z-index: 10; opacity: 0.7;">
                                <div class="spinner-border text-primary" role="status"></div>
                            </div>
                        </t>
                        <table class="table table-hover align-middle mb-0">
                            <thead class="bg-light text-uppercase small fw-bold text-muted sticky-top">
                                <tr>
                                    <th class="ps-4 text-center" style="width: 56px;">
                                        <input class="form-check-input cursor-pointer shadow-sm" type="checkbox"
                                               title="Select all on this page"
                                               t-att-checked="this.isAllAddShopPageSelected"
                                               t-on-change="toggleSelectAllAddShopPage"/>
                                    </th>
                                    <th>Shop Name</th>
                                    <th class="pe-4">Owner</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-if="this.state.tableAddShopCandidates.length === 0 and !this.state.isLoadingAddShops">
                                    <tr>
                                        <td colspan="3" class="text-center py-5 text-muted fw-bold">
                                            No shops available to add. All approved shops may already be on this route.
                                        </td>
                                    </tr>
                                </t>
                                <t t-foreach="this.state.tableAddShopCandidates" t-as="ashop" t-key="ashop.id">
                                    <tr class="cursor-pointer" t-on-click="() => this.toggleAddShopSelection(ashop.id)">
                                        <td class="ps-4 text-center" t-on-click.stop="">
                                            <input class="form-check-input fs-5 cursor-pointer shadow-sm" type="checkbox"
                                                   t-att-checked="!!this.state.addShopSelectedIds[ashop.id]"
                                                   t-on-change="() => this.toggleAddShopSelection(ashop.id)"/>
                                        </td>
                                        <td class="fw-bold text-dark"><t t-esc="ashop.name"/></td>
                                        <td class="text-muted pe-4"><t t-esc="ashop.owner_name || 'N/A'"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                    <div class="p-3 border-top d-flex justify-content-between align-items-center bg-light flex-wrap gap-2 rounded-bottom-3">
                        <div class="btn-group shadow-sm">
                            <button class="btn btn-sm btn-white border fw-bold"
                                    t-on-click="() => this.changeAddShopPage(-1)"
                                    t-att-disabled="this.state.pagination.addShops.page === 1 or this.state.isLoadingAddShops">Prev</button>
                            <button class="btn btn-sm btn-light border px-3 fw-bold disabled text-dark">
                                <t t-esc="this.state.pagination.addShops.page"/>
                                /
                                <t t-esc="Math.max(1, Math.ceil(this.state.pagination.addShops.total / this.state.pagination.addShops.limit))"/>
                            </button>
                            <button class="btn btn-sm btn-white border fw-bold"
                                    t-on-click="() => this.changeAddShopPage(1)"
                                    t-att-disabled="this.state.pagination.addShops.page &gt;= Math.ceil(this.state.pagination.addShops.total / this.state.pagination.addShops.limit) or this.state.isLoadingAddShops">Next</button>
                        </div>
                        <div class="d-flex gap-2">
                            <button class="btn btn-light border fw-bold px-4" t-on-click="closeAddShopModal"
                                    t-att-disabled="this.state.isAddingShops">Cancel</button>
                            <button class="btn btn-success fw-bold text-white px-4 shadow-sm"
                                    t-on-click="confirmAddSelectedShops"
                                    t-att-disabled="this.state.isAddingShops or !this.addShopSelectedCount">
                                <t t-if="this.state.isAddingShops">Adding…</t>
                                <t t-else="">Add Selected (<t t-esc="this.addShopSelectedCount"/>)</t>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </t>
        <!-- Custom Confirm Modal -->
        <t t-if="this.state.confirmModal.isOpen">
            <ConfirmModal 
                title="this.state.confirmModal.title" 
                message="this.state.confirmModal.message" 
                onConfirm="this.state.confirmModal.onConfirm" 
                onCancel="() => this.closeConfirm()" 
            />
        </t>
        </div>
    </t>
</templates>
