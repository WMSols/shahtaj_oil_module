<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-name="shahtaj_oil.OperationsShopCheckins" owl="1">
        <div>
<style>
                .so-checkin-dm-row {
                    background-color: #eef6ff !important;
                }
                .list-group-item-action.so-checkin-dm-row:hover,
                .list-group-item-action.so-checkin-dm-row:focus {
                    background-color: #e0effe !important;
                }
                .so-gps-tag {
                    font-size: 0.68rem;
                    font-weight: 600;
                    line-height: 1.15;
                    padding: 0.15rem 0.45rem;
                    letter-spacing: 0.01em;
                }
                .so-gps-tag-ok {
                    background: #ccfbf1;
                    color: #0f766e;
                    border: 1px solid #5eead4;
                }
                .so-gps-tag-far {
                    background: #ffe4e6;
                    color: #be123c;
                    border: 1px solid #fecdd3;
                }
                .so-gps-tag-warn {
                    background: #ffedd5;
                    color: #c2410c;
                    border: 1px solid #fed7aa;
                }
            </style>
        <!-- Shop Checkins Tab (GPS attempts: success + blocked) -->
        <t t-if="this.state.activeSubTab === 'checkins'">
            <t t-if="!this.state.selectedCheckin">
                        <div class="p-3 bg-light border-bottom d-flex flex-wrap gap-2 align-items-center">
                    <input type="text" class="form-control form-control-sm" style="max-width: 280px;" placeholder="Search by Shop, User, or Message..." 
                           t-att-value="this.state.filters.checkins.search" 
                           t-on-input="(ev) => this.onSearchInput(ev, 'checkins')"/>
                     <small class="fw-bold text-muted" title="Filters for required data">Filters: </small>
                    <select class="form-select form-select-sm" style="max-width: 200px;"
                            t-model="this.state.filters.checkins.booker"
                            t-on-change="() => this.onFilterChange('checkins')">
                        <option value="all">All Field Users</option>
                        <t t-foreach="this.state.lookupFieldUsers" t-as="b" t-key="b.id">
                            <option t-att-value="b.id"><t t-esc="b.name"/></option>
                        </t>
                    </select>
                    <input type="date" class="form-control form-control-sm" style="max-width: 160px;"
                           t-model="this.state.filters.checkins.date"
                           t-on-change="() => this.onFilterChange('checkins')"
                           title="Optional: show GPS attempts for this date only"/>
                    <select class="form-select form-select-sm" style="max-width: 180px;"
                            t-model="this.state.filters.checkins.purpose"
                            t-on-change="() => this.onFilterChange('checkins')">
                        <option value="all">All Purposes</option>
                        <option value="check_in">Check-in</option>
                        <option value="place_order">Place Order</option>
                        <option value="deliver">Deliver to Shop</option>
                    </select>
                    <select class="form-select form-select-sm" style="max-width: 180px;"
                            t-model="this.state.filters.checkins.role"
                            t-on-change="() => this.onFilterChange('checkins')">
                        <option value="all">All Roles</option>
                        <option value="order_booker">Order Bookers</option>
                        <option value="delivery_man">Delivery Men</option>
                    </select>
                    <select class="form-select form-select-sm" style="max-width: 240px;" 
                            t-model="this.state.filters.checkins.status" 
                            t-on-change="() => this.onFilterChange('checkins')">
                        <option value="">All GPS Results</option>
                        <option value="ok">GPS OK</option>
                        <option value="blocked">All Blocked</option>
                        <option value="blocked_too_far">Blocked — Too Far</option>
                        <option value="blocked_too_close">Blocked — Too Close</option>
                        <option value="blocked_missing">Blocked — Missing / Invalid GPS</option>
                    </select>
                </div>

                <div class="position-relative">
                    <t t-if="this.state.isLoadingList">
                        <div class="position-absolute w-100 h-100 d-flex justify-content-center align-items-center bg-white" style="z-index: 10; opacity: 0.7;">
                            <div class="spinner-border text-primary" role="status"></div>
                        </div>
                    </t>
                    <div class="list-group list-group-flush">
                        <t t-if="this.state.tableCheckins.length === 0 and !this.state.isLoadingList">
                            <div class="p-5 text-center text-muted">
                                <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-map-pin opacity-50 mb-3"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
                                <p class="mb-1 fw-bold fs-5 text-dark">No GPS check-in activity found.</p>
                                <p class="mb-0 small">Successful and blocked attempts both appear here.</p>
                            </div>
                        </t>
                        <t t-foreach="this.state.tableCheckins" t-as="log" t-key="log.id">
                            <div t-attf-class="list-group-item list-group-item-action d-flex justify-content-between align-items-center p-3 #{log.isDeliveryCheckin ? 'so-checkin-dm-row' : ''}">
                                <div class="d-flex align-items-center">
                                    <div t-attf-class="rounded-circle d-flex justify-content-center align-items-center me-3 shadow-sm border #{log.isOk ? 'bg-light' : 'bg-danger'}" style="width: 45px; height: 45px;">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" t-attf-class="lucide lucide-map-pin #{log.isOk ? 'text-primary' : 'text-white'}"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
                                    </div>
                                    <div>
                                        <h6 class="mb-0 fw-bold"><t t-esc="log.shop"/></h6>
                                        <small class="text-muted">
                                            <t t-esc="log.purposeLabel"/> · <t t-esc="log.roleLabel"/> ·
                                            Shop ID: <t t-esc="log.shopId"/> ·
                                            <t t-esc="log.booker"/> · <t t-esc="log.time"/>
                                        </small>
                                    </div>
                                </div>
                                <div class="text-end d-flex align-items-center">
                                    <div class="me-3 text-end">
                                        <span t-attf-class="badge so-gps-tag mb-1 d-inline-block #{this._gpsListTagClass(log.result)}"><t t-esc="log.status"/></span>
                                        <div class="text-muted fw-bold small"><t t-esc="log.distLabel"/></div>
                                        <div class="text-muted fw-bold small" title="Total time spent at the shop">
                                            <t t-esc="log.duration"/>
                                        </div>
                                    </div>
                                    <div t-if="log.isOk" class="me-3 text-end" style="min-width: 7.5rem;">
                                        <span t-attf-class="badge p-2 fs-6 d-inline-block #{log.hasOrder ? 'bg-success text-white' : 'bg-light text-dark border'}">
                                            <t t-esc="log.orderLabel"/>
                                        </span>
                                    </div>
                                    <button class="btn btn-sm btn-outline-dark fw-bold ms-2" t-on-click="() => this.viewCheckin(log)">View Details</button>
                                </div>
                            </div>
                        </t>
                    </div>
                    <!-- Pagination -->
                    <div class="p-3 border-top d-flex justify-content-between align-items-center bg-light">
                        <small class="text-muted fw-bold">
                            Showing <t t-esc="this.state.pagination.checkins.total === 0 ? 0 : ((this.state.pagination.checkins.page - 1) * this.state.pagination.checkins.limit) + 1"/>
                            to <t t-esc="Math.min(this.state.pagination.checkins.page * this.state.pagination.checkins.limit, this.state.pagination.checkins.total)"/>
                            of <t t-esc="this.state.pagination.checkins.total"/>
                        </small>
                        <div class="btn-group shadow-sm">
                            <button class="btn btn-sm btn-light bg-white border fw-bold" t-on-click="() => this.changePage('checkins', -1)" t-att-disabled="this.state.pagination.checkins.page === 1">Prev</button>
                            <button class="btn btn-sm btn-light border px-3 fw-bold disabled text-dark"><t t-esc="this.state.pagination.checkins.page"/> / <t t-esc="Math.max(1, Math.ceil(this.state.pagination.checkins.total / this.state.pagination.checkins.limit))"/></button>
                            <button class="btn btn-sm btn-light bg-white border fw-bold" t-on-click="() => this.changePage('checkins', 1)" t-att-disabled="this.state.pagination.checkins.page &gt;= Math.ceil(this.state.pagination.checkins.total / this.state.pagination.checkins.limit)">Next</button>
                        </div>
                    </div>
                </div>

</t>

<t t-else="">
    <div class="p-4" style="background-color: #f8fafc;">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <button class="btn btn-sm btn-light border shadow-sm fw-bold text-dark d-flex align-items-center" t-on-click="closeCheckin" title="Return to the GPS check-in feed">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-left me-1">
                    <path d="m12 19-7-7 7-7"/>
                    <path d="M19 12H5"/>
                </svg>
                                Back to List
            </button>
            <div>
                <span t-attf-class="badge #{this._gpsStatusBadgeClass(this.state.selectedCheckin.result)} p-2 fs-6 text-uppercase shadow-sm" style="letter-spacing: 1px;">
                    <t t-esc="this.state.selectedCheckin.status"/>
                </span>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3 mb-md-0">
                <div class="card border-0 shadow-sm p-4 h-100 rounded-3">
                    <h6 class="text-muted text-uppercase small fw-bold mb-3">GPS Attempt</h6>
                    <h5 class="fw-bold text-dark mb-1">
                        <t t-esc="this.state.selectedCheckin.shop"/>
                    </h5>
                    <p class="text-muted mb-1 small">
                        <strong>Shop ID:</strong>
                        <t t-esc="this.state.selectedCheckin.shopId"/>
                    </p>
                    <p class="text-muted mb-1 small">
                        <strong>User:</strong>
                        <t t-esc="this.state.selectedCheckin.booker"/>
                        <span class="ms-1">(ID: <t t-esc="this.state.selectedCheckin.bookerId"/>)</span>
                    </p>
                    <p class="text-muted mb-1 small">
                        <strong>Role:</strong>
                        <t t-esc="this.state.selectedCheckin.roleLabel"/>
                    </p>
                    <p class="text-muted mb-1 small">
                        <strong>Purpose:</strong>
                        <t t-esc="this.state.selectedCheckin.purposeLabel"/>
                    </p>
                    <p class="text-muted mb-0 small" title="Linked task or delivery job">
                        <strong>Reference:</strong>
                        <t t-esc="this.state.selectedCheckin.taskRef"/>
                    </p>
                    <p class="bg-info text-white mb-0 p-2 small mt-3" t-if="this.state.selectedCheckin.isOk" title="Linked visit notes">
                        <strong>Notes: </strong>
                        <t t-esc="this.state.selectedCheckin.notes || 'No notes'"/>
                    </p>
                    <p class="bg-info text-white mb-0 p-2 small mt-3" t-elif="this.state.selectedCheckin.notes" title="Linked visit notes">
                        <strong>Notes: </strong>
                        <t t-esc="this.state.selectedCheckin.notes"/>
                    </p>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card border-0 shadow-sm p-4 h-100 rounded-3">
                    <h6 class="text-muted text-uppercase small fw-bold mb-3">Distance &amp; Result</h6>
                    <div class="d-flex justify-content-between mb-2 pb-2 border-bottom">
                        <span class="text-muted small">Attempted At:</span>
                        <span class="fw-bold text-dark">
                            <t t-esc="this.state.selectedCheckin.time"/>
                        </span>
                    </div>
                    <div class="d-flex justify-content-between mb-2 pb-2 border-bottom">
                        <span class="text-muted small">Ended At:</span>
                        <span class="fw-bold text-dark">
                            <t t-esc="this.state.selectedCheckin.endTime || '—'"/>
                        </span>
                    </div>
                    <div class="d-flex justify-content-between mb-2 pb-2 border-bottom">
                        <span class="text-muted small">Time Spent:</span>
                        <span class="fw-bold text-dark" title="Total time spent at the shop">
                            <t t-esc="this.state.selectedCheckin.duration || '—'"/>
                        </span>
                    </div>
                    <div class="d-flex justify-content-between mb-2 pb-2 border-bottom">
                        <span class="text-muted small">Distance:</span>
                        <span class="fw-bold text-dark">
                            <t t-esc="this.state.selectedCheckin.distLabel"/>
                        </span>
                    </div>
                    <div class="d-flex justify-content-between mb-2 pb-2 border-bottom">
                        <span class="text-muted small">Allowed Range:</span>
                        <span class="fw-bold text-dark">
                            <t t-esc="Math.round(this.state.selectedCheckin.min_distance_m || 0)"/>–
                            <t t-esc="Math.round(this.state.selectedCheckin.max_distance_m || 0)"/> m
                        </span>
                    </div>
                    <div class="d-flex justify-content-between mb-2 pb-2 border-bottom" t-if="this.state.selectedCheckin.isOk and this.state.selectedCheckin.visitOutcome">
                        <span class="text-muted small">Visit Outcome:</span>
                        <span t-attf-class="fw-bold #{this.state.selectedCheckin.visitOutcome === 'Order Placed' or this.state.selectedCheckin.visitOutcome === 'Delivered' ? 'text-success' : 'text-warning'}">
                            <t t-esc="this.state.selectedCheckin.visitOutcome"/>
                        </span>
                    </div>
                    <div class="mt-2">
                        <span class="text-muted small d-block mb-1">System Message:</span>
                        <p t-attf-class="mb-0 small p-2 rounded #{this.state.selectedCheckin.isOk ? 'bg-success text-white' : 'bg-danger text-white'}">
                            <t t-esc="this.state.selectedCheckin.message || '—'"/>
                        </p>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top" t-if="this.state.selectedCheckin.isOk">
                        <span class="text-muted small"><t t-esc="this.state.selectedCheckin.isDeliveryCheckin ? 'Delivery:' : 'Order:'"/></span>
                        <t t-if="this.state.selectedCheckin.sale_order_id">
                            <button class="btn btn-sm btn-primary shadow-sm fw-bold" t-on-click="() => this.viewOrderFromCheckin(this.state.selectedCheckin)" title="Open the sales order linked to this visit">
                                <t t-esc="this.state.selectedCheckin.sale_order_id[1]"/>
 ➔
                            </button>
                        </t>
                        <t t-else="">
                            <span class="fw-bold text-muted"><t t-esc="this.state.selectedCheckin.isDeliveryCheckin ? 'No delivery linked' : 'No orders placed'"/></span>
                        </t>
                    </div>

                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm rounded-3 mb-4 mt-3 overflow-hidden">
            <button type="button" class="btn w-100 text-start d-flex align-items-center justify-content-between p-3 bg-white border-0"
                    t-on-click="toggleShopSnapshot" title="Show or hide shop credit and sales history">
                <div class="d-flex align-items-center flex-wrap gap-2">
                    <h6 class="mb-0 fw-bold text-dark text-uppercase small">Shop Snapshot</h6>
                    <t t-if="this.state.selectedCheckin.shopCategory">
                        <span t-attf-class="badge text-white #{this.state.selectedCheckin.shopCategory === 'cash' ? 'bg-success' : 'bg-info'}">
                            <t t-esc="this.state.selectedCheckin.shopCategory === 'cash' ? 'Cash' : 'Credit'"/>
                        </span>
                    </t>
                    <t t-if="this.state.selectedCheckin.verificationLabel">
                        <span t-attf-class="badge #{this.state.selectedCheckin.approvalState === 'approved' ? 'bg-success text-white' : this.state.selectedCheckin.approvalState === 'rejected' ? 'bg-danger text-white' : this.state.selectedCheckin.approvalState === 'to_approve' ? 'bg-warning text-dark' : 'bg-light text-dark border'}">
                            <t t-esc="this.state.selectedCheckin.verificationLabel"/>
                        </span>
                    </t>
                </div>
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-muted"
                     t-att-style="this.state.shopSnapshotOpen ? 'transform: rotate(180deg); transition: transform 0.15s ease;' : 'transition: transform 0.15s ease;'">
                    <path d="m6 9 6 6 6-6"/>
                </svg>
            </button>
            <t t-if="this.state.shopSnapshotOpen">
                <div class="border-top p-4">
                    <div class="row g-4">
                        <div class="col-md-6">
                            <h6 class="text-muted text-uppercase small fw-bold mb-3">Credit &amp; Balance</h6>
                            <div class="d-flex justify-content-between mb-2 pb-2 border-bottom">
                                <span class="text-muted small">Shop Category</span>
                                <span t-attf-class="badge text-white #{this.state.selectedCheckin.shopCategory === 'cash' ? 'bg-success' : 'bg-info'}">
                                    <t t-esc="this.state.selectedCheckin.shopCategory === 'cash' ? 'Cash' : 'Credit'"/>
                                </span>
                            </div>
                            <t t-if="this.state.selectedCheckin.shopCategory === 'credit'">
                                <div class="d-flex justify-content-between mb-2 pb-2 border-bottom">
                                    <span class="text-muted small">Shop Credit Limit</span>
                                    <span class="fw-bold"><t t-esc="this._formatRs(this.state.selectedCheckin.creditLimit)"/></span>
                                </div>
                            </t>
                            <div class="d-flex justify-content-between mb-2 pb-2 border-bottom">
                                <span class="text-muted small">Posted Outstanding</span>
                                <span t-attf-class="fw-bold #{this.state.selectedCheckin.outstanding &gt; 0 ? 'text-danger' : ''}">
                                    <t t-esc="this._formatRs(this.state.selectedCheckin.outstanding)"/>
                                </span>
                            </div>
                            <t t-if="this.state.selectedCheckin.shopCategory === 'credit'">
                                <div class="d-flex justify-content-between mb-2 pb-2 border-bottom">
                                    <span class="text-muted small">Shop Pending Orders</span>
                                    <span class="fw-bold"><t t-esc="this._formatRs(this.state.selectedCheckin.pendingExposure)"/></span>
                                </div>
                                <div class="d-flex justify-content-between mb-2 pb-2 border-bottom">
                                    <span class="text-muted small">Shop Confirmed (Not Invoiced)</span>
                                    <span class="fw-bold"><t t-esc="this._formatRs(this.state.selectedCheckin.uninvoicedExposure)"/></span>
                                </div>
                                <div class="d-flex justify-content-between mb-2 pb-2 border-bottom">
                                    <span class="text-muted small">Shop Effective Outstanding</span>
                                    <span t-attf-class="fw-bold #{this.state.selectedCheckin.creditWouldExceed ? 'text-danger' : ''}">
                                        <t t-esc="this._formatRs(this.state.selectedCheckin.effectiveOutstanding)"/>
                                    </span>
                                </div>
                                <div class="d-flex justify-content-between mb-2 pb-2 border-bottom">
                                    <span class="text-muted small">Shop Credit Remaining</span>
                                    <span t-attf-class="fw-bold #{this.state.selectedCheckin.creditWouldExceed ? 'text-warning' : ''}">
                                        <t t-esc="this._formatRs(this.state.selectedCheckin.creditRemaining)"/>
                                    </span>
                                </div>
                                <t t-if="this.state.selectedCheckin.creditWouldExceed">
                                    <div class="d-flex justify-content-between mb-2 pb-2 border-bottom">
                                        <span class="text-muted small">Over Credit Limit By</span>
                                        <span class="fw-bold text-danger"><t t-esc="this._formatRs(this.state.selectedCheckin.creditShortfall)"/></span>
                                    </div>
                                </t>
                            </t>
                            <div class="d-flex justify-content-between">
                                <span class="text-muted small">Verification Status</span>
                                <span t-attf-class="badge #{this.state.selectedCheckin.approvalState === 'approved' ? 'bg-success text-white' : this.state.selectedCheckin.approvalState === 'rejected' ? 'bg-danger text-white' : this.state.selectedCheckin.approvalState === 'to_approve' ? 'bg-warning text-dark' : 'bg-light text-dark border'}">
                                    <t t-esc="this.state.selectedCheckin.verificationLabel || 'Standard'"/>
                                </span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <h6 class="text-muted text-uppercase small fw-bold mb-3">Sales &amp; Discount History</h6>
                            <div class="d-flex justify-content-between mb-2 pb-2 border-bottom">
                                <span class="text-muted small">Shop Lifetime Sales</span>
                                <span class="fw-bold"><t t-esc="this._formatRs(this.state.selectedCheckin.lifetimeSales)"/></span>
                            </div>
                            <div class="d-flex justify-content-between mb-2 pb-2 border-bottom">
                                <span class="text-muted small">Shop Confirmed Orders</span>
                                <span class="fw-bold"><t t-esc="this.state.selectedCheckin.confirmedOrderCount || 0"/></span>
                            </div>
                            <div class="d-flex justify-content-between mb-2 pb-2 border-bottom">
                                <span class="text-muted small">Past Discounts Total</span>
                                <span t-attf-class="fw-bold #{this.state.selectedCheckin.pastDiscountTotal &gt; 0 ? 'text-danger' : ''}">
                                    <t t-esc="this._formatRs(this.state.selectedCheckin.pastDiscountTotal)"/>
                                </span>
                            </div>
                            <div class="d-flex justify-content-between mb-2 pb-2 border-bottom">
                                <span class="text-muted small">Past Discounted Orders</span>
                                <span class="fw-bold"><t t-esc="this.state.selectedCheckin.pastDiscountCount || 0"/></span>
                            </div>
                            <t t-if="this.state.selectedCheckin.lastDiscountDate">
                                <div class="d-flex justify-content-between mb-2 pb-2 border-bottom">
                                    <span class="text-muted small">Last Discount Date</span>
                                    <span class="fw-bold"><t t-esc="this.state.selectedCheckin.lastDiscountDate"/></span>
                                </div>
                                <div class="d-flex justify-content-between mb-2 pb-2 border-bottom">
                                    <span class="text-muted small">Last Discount Amount</span>
                                    <span class="fw-bold"><t t-esc="this._formatRs(this.state.selectedCheckin.lastDiscountAmount)"/></span>
                                </div>
                            </t>
                            <div class="d-flex justify-content-between">
                                <span class="text-muted small">Payment Terms</span>
                                <span class="fw-bold text-muted"><t t-esc="this.state.selectedCheckin.paymentTerms || 'Immediate'"/></span>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </div>

        <div class="row mt-3">
            <div class="col-12">
                <div class="card border-0 shadow-sm p-4 rounded-3">
                    <h6 class="fw-bold text-info d-flex align-items-center mb-3">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-map me-2">
                            <path d="M14.106 5.553a2 2 0 0 0 1.788 0l3.659-1.83A1 1 0 0 1 21 4.619v12.764a1 1 0 0 1-.553.894l-4.553 2.277a2 2 0 0 1-1.788 0l-4.212-2.106a2 2 0 0 0-1.788 0l-3.659 1.83A1 1 0 0 1 3 19.381V6.618a1 1 0 0 1 .553-.894l4.553-2.277a2 2 0 0 1 1.788 0z"/>
                            <path d="M15 5.764v15"/>
                            <path d="M9 3.236v15"/>
                        </svg>
                        Live Map View
                    </h6>
                    <div class="d-flex flex-wrap gap-3 mb-2 small text-muted">
                        <span><span class="d-inline-block rounded-circle me-1" style="width:10px;height:10px;background:#0d6efd;"></span> Shop</span>
                        <span><span class="d-inline-block rounded-circle me-1" style="width:10px;height:10px;background:#198754;"></span> GPS OK attempt</span>
                        <span><span class="d-inline-block rounded-circle me-1" style="width:10px;height:10px;background:#dc3545;"></span> Blocked attempt</span>
                        <span class="text-muted">Dashed blue circle = max allowed distance</span>
                    </div>
                    <div t-ref="checkinMapContainer" class="w-100 rounded-3 shadow-sm border border-2" style="height: 300px; z-index: 1; position: relative; background-color: #f8f9fa;">
                        <t t-if="(!this.state.selectedCheckin.shop_latitude or !this.state.selectedCheckin.shop_longitude) and (!this.state.selectedCheckin.attempt_latitude or !this.state.selectedCheckin.attempt_longitude)">
                            <div class="d-flex flex-column h-100 justify-content-center align-items-center text-muted px-4 text-center gap-1">
                                <strong>No map coordinates for this attempt.</strong>
                                <small>Shop or user GPS was missing when this attempt was logged.</small>
                            </div>
                        </t>
                    </div>
                    <div class="row mt-3 small text-muted">
                        <div class="col-md-6">
                            <strong class="text-dark">Shop GPS:</strong>
                            <t t-esc="this.state.selectedCheckin.shop_latitude || '—'"/>,
                            <t t-esc="this.state.selectedCheckin.shop_longitude || '—'"/>
                        </div>
                        <div class="col-md-6">
                            <strong class="text-dark">Attempt GPS:</strong>
                            <t t-esc="this.state.selectedCheckin.attempt_latitude || '—'"/>,
                            <t t-esc="this.state.selectedCheckin.attempt_longitude || '—'"/>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</t>
</t>
        </div>
    </t>
</templates>
