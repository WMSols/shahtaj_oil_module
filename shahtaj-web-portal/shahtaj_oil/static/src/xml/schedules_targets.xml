<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-name="shahtaj_oil.SchedulesTargets" owl="1">
        <div class="card border-0 shadow-sm bg-white rounded-3 position-relative">

            <div class="p-4 border-bottom bg-light d-flex justify-content-between align-items-center rounded-top">
                <div>
                    <h2 class="h4 fw-bold text-dark mb-0">Schedules &amp; Targets Hub</h2>
                    <small class="text-muted">Manage weekly routes and performance KPIs for field staff.</small>
                </div>
                <div>
                    <button class="btn btn-outline-secondary fw-bold shadow-sm d-inline-flex align-items-center bg-white" t-on-click="refreshData" t-att-disabled="this.state.isRefreshing" title="Refresh Live Data">
                        <i class="fa fa-refresh me-2" t-att-class="{'fa-spin': this.state.isRefreshing}"></i> Refresh
                    </button>
                </div>
            </div>

            <!-- ========================================== -->
            <!-- BOOKERS LIST VIEW (PAGINATED)              -->
            <!-- ========================================== -->
            <t t-if="this.state.viewMode === 'list'">
                <div class="p-4 border-bottom d-flex align-items-center" 
                     t-attf-style="#{this.state.activeMainTab === 'schedules' ? 'background-color: rgba(26, 115, 232, 0.08);' : 'background-color: rgba(25, 135, 84, 0.1);'}">
                    <div class="p-3 rounded-circle me-3 shadow-sm text-white" 
                         t-attf-style="#{this.state.activeMainTab === 'schedules' ? 'background-color: #1a73e8;' : 'background-color: #198754;'}">
                        <t t-if="this.state.activeMainTab === 'schedules'">
                            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 2v4"/><path d="M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/><path d="M8 14h.01"/><path d="M12 14h.01"/><path d="M16 14h.01"/><path d="M8 18h.01"/><path d="M12 18h.01"/><path d="M16 18h.01"/></svg>
                        </t>
                        <t t-else="">
                            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg>
                        </t>
                    </div>
                    <div>
                        <h3 class="fw-bold mb-1" 
                            t-attf-style="#{this.state.activeMainTab === 'schedules' ? 'color: #1a73e8;' : 'color: #198754;'}">
                            <t t-esc="this.state.activeMainTab === 'schedules' ? 'Weekly Schedules Management' : 'Performance Targets Management'"/>
                        </h3>
                        <p class="mb-0 text-dark fw-bold opacity-75">
                            <t t-esc="this.state.activeMainTab === 'schedules' ? 'Select an order booker below to assign and monitor their weekly operational routes.' : 'Select an order booker below to set, track, and evaluate their sales and volume goals.'"/>
                        </p>
                    </div>
                </div>


                <div class="p-3 bg-light border-bottom d-flex justify-content-between align-items-center">
                    <div class="input-group input-group-sm w-50 shadow-sm">
                        <span class="input-group-text bg-white border-end-0">
                            <i class="fa fa-search text-muted"></i>
                        </span>
                        <input type="text" class="form-control border-start-0 ps-0" placeholder="Search bookers by name or code..." 
                               t-att-value="this.state.filters.bookers.search" 
                               t-on-input="onSearchInput"/>
                    </div>
                </div>
                
                <div class="position-relative">
                    <t t-if="this.state.isLoadingList">
                        <div class="position-absolute w-100 h-100 d-flex justify-content-center align-items-center bg-white" style="z-index: 10; opacity: 0.7;">
                            <div class="spinner-border text-primary" role="status"></div>
                        </div>
                    </t>

                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="bg-light text-uppercase small fw-bold text-muted">
                                <tr>
                                    <th class="border-top-0 ps-4">Order Booker</th>
                                    <th class="border-top-0">Login Info</th>
                                    <th class="border-top-0 text-end pe-4">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-if="this.state.tableBookers.length === 0 and !this.state.isLoadingList">
                                    <tr>
                                        <td colspan="3" class="text-center py-5 text-muted">
                                            <i class="fa fa-users fs-1 mb-3 opacity-50"></i>
                                            <p class="mb-0 fw-bold">No order bookers found.</p>
                                        </td>
                                    </tr>
                                </t>
                                <t t-foreach="this.state.tableBookers" t-as="booker" t-key="booker.id">
                                    <tr style="cursor: pointer;" class="transition-all" t-on-click="() => this.openBookerDetails(booker)">
                                        <td class="ps-4 align-middle fw-bold text-dark">
                                            <t t-esc="booker.name"/>
                                            <small class="d-block text-muted fw-normal">
                                                ID: <t t-esc="booker.id"/> <t t-if="booker.employee_code"> | Code: <t t-esc="booker.employee_code"/></t>
                                            </small>
                                        </td>
                                        <td class="align-middle">
                                            <div class="fw-bold text-dark"><t t-esc="booker.login"/></div>
                                        </td>
                                        <td class="align-middle text-end pe-4">
                                            <button class="btn btn-sm btn-outline-dark fw-bold d-inline-flex align-items-center" t-on-click.stop="() => this.openBookerDetails(booker)">
                                                <t t-if="this.state.activeMainTab === 'schedules'">View Schedules</t>
                                                <t t-else="">View Targets</t>
                                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right ms-2"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                                            </button>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>

                    <div class="p-3 border-top d-flex justify-content-between align-items-center bg-light">
                        <small class="text-muted fw-bold">
                            Showing <t t-esc="this.state.pagination.bookers.total === 0 ? 0 : ((this.state.pagination.bookers.page - 1) * this.state.pagination.bookers.limit) + 1"/>
                            to <t t-esc="Math.min(this.state.pagination.bookers.page * this.state.pagination.bookers.limit, this.state.pagination.bookers.total)"/>
                            of <t t-esc="this.state.pagination.bookers.total"/>
                        </small>
                        <div class="btn-group shadow-sm">
                            <button class="btn btn-sm btn-white border fw-bold" t-on-click="() => this.changePage(-1)" t-att-disabled="this.state.pagination.bookers.page === 1">Prev</button>
                            <button class="btn btn-sm btn-light border px-3 fw-bold disabled text-dark">
                                <t t-esc="this.state.pagination.bookers.page"/> / <t t-esc="Math.max(1, Math.ceil(this.state.pagination.bookers.total / this.state.pagination.bookers.limit))"/>
                            </button>
                            <button class="btn btn-sm btn-white border fw-bold" t-on-click="() => this.changePage(1)" t-att-disabled="this.state.pagination.bookers.page &gt;= Math.ceil(this.state.pagination.bookers.total / this.state.pagination.bookers.limit)">Next</button>
                        </div>
                    </div>
                </div>
            </t>


            <!-- ========================================== -->
            <!-- DETAIL VIEW (SCHEDULES & TARGETS)          -->
            <!-- ========================================== -->
            <t t-if="this.state.viewMode === 'detail'">

                <div class="p-3 bg-light border-bottom d-flex justify-content-between align-items-center">
                    <div>
                        <button class="btn btn-sm btn-link text-muted fw-bold px-0 text-decoration-none d-flex align-items-center" t-on-click="goBackToList">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-left me-1"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
                            Back to List
                        </button>
                        <h5 class="fw-bold text-dark mb-0 mt-1">
                            <t t-if="this.state.activeMainTab === 'schedules'">Weekly Schedules: </t>
                            <t t-else="">Performance Targets: </t>
                            <span class="text-primary"><t t-esc="this.state.selectedBooker.name"/></span>
                            <small class="text-muted ms-2">(Booker ID: <t t-esc="this.state.selectedBooker.id"/>)</small>
                        </h5>
                    </div>
                    <t t-if="!this.state.showForm">
                        <button class="btn btn-dark shadow-sm fw-bold d-flex align-items-center text-white" t-on-click="openForm">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-plus me-1"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
                            <t t-if="this.state.activeMainTab === 'schedules'">Add Schedule</t>
                            <t t-else="">Add Target</t>
                        </button>
                    </t>
                </div>

                <t t-if="this.state.errorMessage">
                    <div class="alert alert-danger m-3 py-2 small fw-bold d-flex align-items-center rounded-3" role="alert">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-alert-triangle me-2"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><line x1="12" x2="12" y1="9" y2="13"/><line x1="12" x2="12.01" y1="17" y2="17"/></svg>
                        <t t-esc="this.state.errorMessage"/>
                    </div>
                </t>

                <!-- Schedule Form -->
                <t t-if="this.state.showForm and this.state.activeMainTab === 'schedules'">
                    <div class="p-4 bg-white border-bottom">
                        <h6 class="fw-bold text-dark mb-3 border-bottom pb-2">
                            <t t-esc="this.state.editingScheduleId ? 'Edit Schedule Configuration' : 'New Schedule Configuration'"/>
                        </h6>

                        <div class="row align-items-end mb-4">
                            <div class="col-md-3">
                                <label class="small fw-bold">Day of the Week</label>
                                <select class="form-select form-control" t-model="this.state.scheduleForm.day">
                                    <option value="">-- Select Day --</option>
                                    <option value="0">Monday</option>
                                    <option value="1">Tuesday</option>
                                    <option value="2">Wednesday</option>
                                    <option value="3">Thursday</option>
                                    <option value="4">Friday</option>
                                    <option value="5">Saturday</option>
                                    <option value="6">Sunday</option>
                                </select>
                            </div>
                            <div class="col-md-3">
                                <label class="small fw-bold">Zone</label>
                                <select class="form-select form-control" t-model="this.state.scheduleForm.zone_name">
                                    <option value="">-- Select Zone --</option>
                                    <t t-foreach="this.uniqueZones" t-as="z" t-key="z">
                                        <option t-att-value="z"><t t-esc="z"/></option>
                                    </t>
                                </select>
                            </div>
                            <div class="col-md-4">
                                 <t t-if="this.state.scheduleForm.route_id and this.state.scheduleForm.operational_shop_count !== null">
                                    <small t-att-class="this.state.scheduleForm.operational_shop_count === 0 ? 'text-warning fw-bold d-block ' : 'text-muted d-block' ">
                                        <t t-if="this.state.scheduleForm.operational_shop_count === 0">
                                           (No active approved shops on this route — order booker will see no visits.)
                                        </t>
                                        <t t-else="">
                                            ( <span class="fw-bold fs-4 text-black"><t t-esc="this.state.scheduleForm.operational_shop_count"/></span> active approved shop(s) on this route.)
                                        </t>
                                    </small>
                                </t>
                                <label class="small fw-bold">Route</label>
                                <select class="form-select form-control" t-model="this.state.scheduleForm.route_id" t-on-change="onScheduleRouteChange">
                                    <option value="">-- Select Route --</option>
                                    <t t-foreach="this.filteredRoutes" t-as="r" t-key="r.id">
                                        <option t-att-value="r.id"><t t-esc="r.name"/></option>
                                    </t>
                                </select>
                            </div>
                            <div class="col-md-2 pb-2">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" role="switch" id="schedActiveSwitch" t-model="this.state.scheduleForm.is_active"/>
                                    <label class="form-check-label small fw-bold cursor-pointer" for="schedActiveSwitch">Active</label>
                                </div>
                            </div>
                        </div>

                        <div class="alert alert-light border small text-muted mb-3 mb-md-2">
                            <i class="fa fa-info-circle me-1 text-primary"></i>
                            Changes apply from the <strong>next</strong> selected weekday (for example next Monday).
                            Completed visits for this week stay as they are. Today's schedule stays locked only while visits are in progress or completed.
                        </div>

                        <div class="d-flex justify-content-end mt-3">
                            <button class="btn btn-outline-secondary me-2 fw-bold" t-on-click="() => this.state.showForm = false">Cancel</button>
                            <button class="btn btn-dark px-4 fw-bold text-white" t-on-click="saveSchedule" t-att-disabled="this.state.isLoading">
                                <t t-if="this.state.isLoading"><i class="fa fa-spinner fa-spin me-1"></i> Saving...</t>
                                <t t-else=""><t t-esc="this.state.editingScheduleId ? 'Update Schedule' : 'Save Schedule'"/></t>
                            </button>
                        </div>
                    </div>
                </t>

                <!-- Target Form -->
                <t t-if="this.state.showForm and this.state.activeMainTab === 'targets'">
                    <div class="p-4 bg-white border-bottom">
                        <h6 class="fw-bold text-dark mb-3 border-bottom pb-2">
                            <t t-esc="this.state.editingTargetId ? 'Edit Target Configuration' : 'New Target Configuration'"/>
                        </h6>

                        <div class="row mb-3">
                            <div class="col-md-3">
                                <label class="small fw-bold">Start Period</label>
                                <input type="date" class="form-control" t-model="this.state.targetForm.startDate"/>
                            </div>
                            <div class="col-md-3">
                                <label class="small fw-bold">End Period</label>
                                <input type="date" class="form-control" t-model="this.state.targetForm.endDate"/>
                            </div>
                            <div class="col-md-4">
                                <label class="small fw-bold">Target Type</label>
                                <select class="form-select form-control" t-model="this.state.targetForm.type">
                                    <option value="">-- Select Type --</option>
                                    <option value="collective_qty">Collective Quantity (multi-product)</option>
                                    <option value="collective_weight">Collective Weight (multi-product)</option>
                                    <option value="product_bundle">Combined Product Targets</option>
                                </select>
                            </div>
                            <div class="col-md-2 pt-4 mt-1">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" role="switch" id="targetActiveSwitch" t-model="this.state.targetForm.is_active"/>
                                    <label class="form-check-label small fw-bold cursor-pointer" for="targetActiveSwitch">Active</label>
                                </div>
                            </div>
                        </div>

                        <div class="row mb-4">
                            <t t-if="this.state.targetForm.type !== 'product_bundle'">
                                <div class="col-md-4">
                                    <label class="small fw-bold">Target Amount / Value</label>
                                    <input type="number" class="form-control" t-model="this.state.targetForm.target_value" placeholder="e.g. 500"/>
                                </div>
                            </t>
                            <t t-else="">
                                <div class="col-md-8">
                                    <div class="alert alert-info mb-0 py-2 small">
                                        Combined targets use <b>per-product goals</b> below. Headline progress is the <b>average %</b> of those lines (0–100).
                                    </div>
                                </div>
                            </t>

                            <t t-if="this.state.targetForm.type === 'collective_weight'">
                                <div class="col-md-4">
                                    <label class="small fw-bold text-info">Weight Unit</label>
                                    <select class="form-select form-control border-info" t-model="this.state.targetForm.target_weight_uom">
                                        <option value="kg">Kilogram (kg)</option>
                                        <option value="ton">Ton</option>
                                    </select>
                                </div>
                            </t>
                        </div>

                        <t t-if="this.isMultiProductTargetType(this.state.targetForm.type)">
                            <div class="border rounded-3 p-3 mb-3 bg-light">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <h6 class="fw-bold mb-0 small text-uppercase text-muted">Products</h6>
                                    <button type="button" class="btn btn-sm btn-outline-primary fw-bold" t-on-click="addTargetLine">+ Add Product</button>
                                </div>
                                <t t-if="!this.state.targetForm.lines.length">
                                    <p class="small text-muted mb-0">Add the products that count toward this target.</p>
                                </t>
                                <t t-foreach="this.state.targetForm.lines" t-as="line" t-key="line_index">
                                    <div class="row g-2 align-items-end mb-2">
                                        <div t-attf-class="#{this.state.targetForm.type === 'product_bundle' ? 'col-md-4' : 'col-md-10'}">
                                            <label class="small fw-bold">Product</label>
                                            <select class="form-select form-select-sm" t-model="line.product_id">
                                                <option value="">-- Select --</option>
                                                <t t-foreach="this.state.products" t-as="p" t-key="p.id">
                                                    <option t-att-value="p.id"><t t-esc="p.name"/></option>
                                                </t>
                                            </select>
                                        </div>
                                        <t t-if="this.state.targetForm.type === 'product_bundle'">
                                            <div class="col-md-2">
                                                <label class="small fw-bold">Measure</label>
                                                <select class="form-select form-select-sm" t-model="line.measure_type">
                                                    <option value="qty">Quantity</option>
                                                    <option value="weight">Weight</option>
                                                </select>
                                            </div>
                                            <div class="col-md-2">
                                                <label class="small fw-bold">Target</label>
                                                <input type="number" class="form-control form-control-sm" t-model="line.target_value" placeholder="e.g. 100"/>
                                            </div>
                                            <div class="col-md-2">
                                                <label class="small fw-bold">Unit</label>
                                                <t t-if="line.measure_type === 'weight'">
                                                    <select class="form-select form-select-sm" t-model="line.target_weight_uom">
                                                        <option value="kg">kg</option>
                                                        <option value="ton">ton</option>
                                                    </select>
                                                </t>
                                                <t t-else="">
                                                    <input type="text" class="form-control form-control-sm" value="units" disabled="1"/>
                                                </t>
                                            </div>
                                        </t>
                                        <div class="col-md-2">
                                            <button type="button" class="btn btn-sm btn-outline-danger w-100" t-on-click="() => this.removeTargetLine(line_index)">Remove</button>
                                        </div>
                                    </div>
                                </t>
                            </div>
                        </t>

                        <div class="d-flex justify-content-end mt-3">
                            <button class="btn btn-outline-secondary me-2 fw-bold" t-on-click="() => this.state.showForm = false">Cancel</button>
                            <button class="btn btn-dark px-4 fw-bold text-white" t-on-click="saveTarget" t-att-disabled="this.state.isLoading">
                                <t t-if="this.state.isLoading"><i class="fa fa-spinner fa-spin me-1"></i> Saving...</t>
                                <t t-else=""><t t-esc="this.state.editingTargetId ? 'Update Target' : 'Save Target'"/></t>
                            </button>
                        </div>
                    </div>
                </t>

                <!-- Inner Detail Views -->
                <t t-if="!this.state.showForm and this.state.activeMainTab === 'schedules'">
                    <div class="px-4 pt-3">
                        <div class="alert alert-light border small text-muted mb-0">
                            <i class="fa fa-info-circle me-1 text-primary"></i>
                            Editing a weekday updates the plan from the <strong>next</strong> that weekday.
                            Today's row is locked only if visits are already in progress or completed.
                        </div>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="bg-light text-uppercase small fw-bold text-muted">
                                <tr>
                                    <th class="ps-4 border-top-0">Day</th>
                                    <th class="border-top-0">Route Info</th>
                                    <th class="text-center border-top-0">Shops</th>
                                    <th class="border-top-0">Status</th>
                                    <th class="text-end pe-4 border-top-0">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-if="currentBookerSchedules.length === 0">
                                    <tr>
                                        <td colspan="5" class="text-center py-4 text-muted">No schedules configured for this booker.</td>
                                    </tr>
                                </t>
                                <t t-foreach="currentBookerSchedules" t-as="sched" t-key="sched.id">
                                    <tr>
                                        <td class="ps-4 align-middle fw-bold">
                                            <t t-esc="sched.day"/>
                                            <t t-if="sched.isLocked"><span class="badge bg-warning text-dark ms-2">Locked today</span></t>
                                        </td>
                                        <td class="align-middle">
                                            <div class="text-dark"><t t-esc="sched.route"/></div>
                                            <small class="text-muted"><t t-esc="sched.zone"/></small>
                                        </td>
                                        <td class="align-middle text-center"><t t-esc="sched.shops"/></td>
                                        <td class="align-middle">
                                            <span t-attf-class="badge #{sched.status === 'Active' ? 'bg-success text-white' : 'bg-secondary text-white'} px-2 py-1 shadow-sm"><t t-esc="sched.status"/></span>
                                        </td>
                                        <td class="align-middle text-end pe-4">
                                            <button class="btn btn-sm btn-outline-primary me-2" t-on-click="() => this.editSchedule(sched)" t-att-disabled="sched.isLocked" title="Edit schedule">Edit</button>
                                            <button class="btn btn-sm btn-outline-danger" t-on-click="() => this.promptDeleteSchedule(sched)" t-att-disabled="sched.isLocked" title="Delete schedule">Delete</button>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </t>

                <t t-if="!this.state.showForm and this.state.activeMainTab === 'targets'">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="bg-light text-uppercase small fw-bold text-muted">
                                <tr>
                                    <th class="ps-4 border-top-0">Period</th>
                                    <th class="border-top-0">Target Goal</th>
                                    <th class="border-top-0">Achieved</th>
                                    <th class="border-top-0">Status</th>
                                    <th class="text-end pe-4 border-top-0">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-if="currentBookerTargets.length === 0">
                                    <tr><td colspan="5" class="text-center py-4 text-muted">No targets configured for this booker.</td></tr>
                                </t>
                                <t t-foreach="currentBookerTargets" t-as="tgt" t-key="tgt.id">
                                    <tr>
                                        <td class="ps-4 align-middle">
                                            <div class="fw-bold small"><t t-esc="tgt.startDate"/></div>
                                            <div class="text-muted small">to <t t-esc="tgt.endDate"/></div>
                                        </td>
                                        <td class="align-middle">
                                            <div class="text-dark fw-bold text-capitalize">
                                                <t t-if="tgt.isExpandable">
                                                    <button type="button" class="btn btn-link p-0 text-decoration-none fw-bold text-dark text-capitalize" t-on-click="() => this.toggleTargetExpand(tgt)">
                                                        <i t-attf-class="fa #{tgt.expanded ? 'fa-chevron-down' : 'fa-chevron-right'} me-1"/>
                                                        <t t-esc="tgt.type.replace('_', ' ')"/>
                                                    </button>
                                                </t>
                                                <t t-else=""><t t-esc="tgt.type.replace('_', ' ')"/></t>
                                            </div>
                                            <small class="text-muted">
                                                <t t-if="tgt.type === 'product_bundle'">
                                                    Combined progress <t t-esc="tgt.progressPercentage"/> · <t t-esc="tgt.lines.length"/> products
                                                </t>
                                                <t t-else="">
                                                    <t t-esc="tgt.amount"/>
                                                    <t t-if="tgt.type === 'collective_weight' and tgt.weightUom"> <t t-esc="tgt.weightUom"/></t>
                                                    <t t-if="tgt.type === 'collective_qty' or tgt.type === 'collective_weight'"> · <t t-esc="tgt.lines.length"/> products</t>
                                                </t>
                                            </small>
                                            <div class="progress mt-1" style="height: 6px; max-width: 220px;">
                                                <div class="progress-bar" role="progressbar" t-attf-style="width: #{tgt.progressWidth}%"/>
                                            </div>
                                            <t t-if="tgt.expanded and tgt.lines.length">
                                                <div class="mt-2 ps-2 border-start border-2">
                                                    <t t-foreach="tgt.lines" t-as="line" t-key="line.id">
                                                        <div class="small mb-2">
                                                            <div class="fw-semibold"><t t-esc="line.product_name"/></div>
                                                            <div class="text-muted">
                                                                <t t-if="tgt.type === 'product_bundle'">
                                                                    Goal <t t-esc="line.target_value"/>
                                                                    <t t-if="line.measure_type === 'weight'"> <t t-esc="line.target_weight_uom"/></t><t t-else=""> units</t>
                                                                    · achieved <t t-esc="line.achieved_value"/>
                                                                </t>
                                                                <t t-else="">
                                                                    Contribution achieved <t t-esc="line.achieved_value"/>
                                                                </t>
                                                                · <t t-esc="line.progress_percent"/>%
                                                            </div>
                                                            <div class="progress mt-1" style="height: 4px; max-width: 200px;">
                                                                <div class="progress-bar bg-info" role="progressbar" t-attf-style="width: #{line.progressWidth}%"/>
                                                            </div>
                                                        </div>
                                                    </t>
                                                </div>
                                            </t>
                                        </td>
                                        <td class="align-middle fw-bold">
                                            <t t-esc="tgt.achievedAmount"/>
                                            <t t-if="tgt.type === 'collective_weight' and tgt.weightUom">
                                                <small class="d-block text-muted fw-normal"><t t-esc="tgt.remainingAmount"/> <t t-esc="tgt.weightUom"/> left</small>
                                            </t>
                                            <t t-elif="tgt.type === 'product_bundle'">
                                                <small class="d-block text-muted fw-normal"><t t-esc="tgt.progressPercentage"/> complete</small>
                                            </t>
                                            <t t-else="">
                                                <small class="d-block text-muted fw-normal"><t t-esc="tgt.remainingAmount"/> left</small>
                                            </t>
                                        </td>
                                        <td class="align-middle">
                                            <span t-attf-class="badge #{tgt.status === 'Active' ? 'bg-success text-white' : 'bg-secondary text-white'} px-2 py-1 shadow-sm"><t t-esc="tgt.status"/></span>
                                        </td>
                                        <td class="align-middle text-end pe-4">
                                            <button class="btn btn-sm btn-outline-primary me-2" t-on-click="() => this.editTarget(tgt)">Edit</button>
                                            <button class="btn btn-sm btn-outline-danger" t-on-click="() => this.promptDeleteTarget(tgt)">Delete</button>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>

            <!-- ========================================== -->
            <!-- CUSTOM DELETE CONFIRMATION MODAL           -->
            <!-- ========================================== -->
            <t t-if="this.state.showDeleteModal">
                <div class="position-fixed top-0 start-0 w-100 h-100 d-flex justify-content-center align-items-center" style="background: rgba(15, 23, 42, 0.6); z-index: 1055; backdrop-filter: blur(4px);">
                    <div class="card border-0 shadow-lg rounded-4 overflow-hidden" style="width: 100%; max-width: 480px; animation: fadeIn 0.2s ease-out;">
                        <div class="bg-danger text-white p-3 d-flex justify-content-between align-items-center">
                            <h5 class="mb-0 fw-bold text-white d-flex align-items-center">
                                <i class="fa fa-exclamation-triangle me-2"></i> Confirm Deletion
                            </h5>
                            <button class="btn btn-sm text-black btn-light bg-opacity-25 border-0 text-white rounded-circle d-flex align-items-center justify-content-center p-1" style="width: 28px; height: 28px;" t-on-click="closeDeleteModal">
                                <i class="fa fa-times"></i>
                            </button>
                        </div>
                        <div class="p-4 bg-light">
                            <p class="text-dark mb-2 fs-6">
                                Are you sure you want to delete <strong class="text-danger"><t t-esc="this.state.deleteTitle"/></strong>?
                            </p>
                            <p class="text-muted small mb-4">This action cannot be undone and will permanently remove this record from Odoo.</p>
                            
                            <div class="d-flex justify-content-end gap-2">
                                <button class="btn btn-light border fw-bold px-4" t-on-click="closeDeleteModal" t-att-disabled="this.state.isLoading">Cancel</button>
                                <button class="btn btn-danger fw-bold px-4 text-white d-flex align-items-center" t-on-click="confirmDelete" t-att-disabled="this.state.isLoading">
                                    <t t-if="this.state.isLoading"><i class="fa fa-spinner fa-spin me-2"></i> Deleting...</t>
                                    <t t-else=""><i class="fa fa-trash me-2"></i> Confirm Delete</t>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </t>

        </div>
    </t>
</templates>
