<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="seq_shahtaj_field_report" model="ir.sequence">
        <field name="name">Shahtaj Field Report</field>
        <field name="code">shahtaj.field.report</field>
        <field name="prefix">RPT/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

    <!-- App error tags -->
    <record id="tag_report_app_crash" model="shahtaj.field.report.tag">
        <field name="name">App Crash</field>
        <field name="code">app_crash</field>
        <field name="kind">app_error</field>
        <field name="sequence">10</field>
        <field name="color">1</field>
    </record>
    <record id="tag_report_sync_issue" model="shahtaj.field.report.tag">
        <field name="name">Sync Issue</field>
        <field name="code">sync_issue</field>
        <field name="kind">app_error</field>
        <field name="sequence">20</field>
        <field name="color">2</field>
    </record>
    <record id="tag_report_api_error" model="shahtaj.field.report.tag">
        <field name="name">API / Login Error</field>
        <field name="code">api_error</field>
        <field name="kind">app_error</field>
        <field name="sequence">30</field>
        <field name="color">3</field>
    </record>
    <record id="tag_report_app_other" model="shahtaj.field.report.tag">
        <field name="name">Other App Issue</field>
        <field name="code">app_other</field>
        <field name="kind">app_error</field>
        <field name="sequence">90</field>
        <field name="color">4</field>
    </record>

    <!-- Field activity tags -->
    <record id="tag_report_road_block" model="shahtaj.field.report.tag">
        <field name="name">Road Block</field>
        <field name="code">road_block</field>
        <field name="kind">field_activity</field>
        <field name="sequence">10</field>
        <field name="color">5</field>
    </record>
    <record id="tag_report_phone_damaged" model="shahtaj.field.report.tag">
        <field name="name">Phone Damaged</field>
        <field name="code">phone_damaged</field>
        <field name="kind">field_activity</field>
        <field name="sequence">20</field>
        <field name="color">6</field>
    </record>
    <record id="tag_report_vehicle_issue" model="shahtaj.field.report.tag">
        <field name="name">Vehicle Issue</field>
        <field name="code">vehicle_issue</field>
        <field name="kind">field_activity</field>
        <field name="sequence">30</field>
        <field name="color">7</field>
    </record>
    <record id="tag_report_shop_issue" model="shahtaj.field.report.tag">
        <field name="name">Shop / Customer Issue</field>
        <field name="code">shop_issue</field>
        <field name="kind">field_activity</field>
        <field name="sequence">40</field>
        <field name="color">8</field>
    </record>
    <record id="tag_report_field_other" model="shahtaj.field.report.tag">
        <field name="name">Other Field Issue</field>
        <field name="code">field_other</field>
        <field name="kind">field_activity</field>
        <field name="sequence">90</field>
        <field name="color">9</field>
    </record>

</odoo>
