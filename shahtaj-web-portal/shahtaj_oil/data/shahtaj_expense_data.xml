<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="seq_shahtaj_expense" model="ir.sequence">
        <field name="name">Shahtaj Expense</field>
        <field name="code">shahtaj.expense</field>
        <field name="prefix">EXP/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="shahtaj_expense_category_fuel" model="shahtaj.expense.category">
        <field name="name">Fuel</field>
        <field name="sequence">10</field>
    </record>
    <record id="shahtaj_expense_category_salary" model="shahtaj.expense.category">
        <field name="name">Salary / Wages</field>
        <field name="sequence">20</field>
    </record>
    <record id="shahtaj_expense_category_rent" model="shahtaj.expense.category">
        <field name="name">Rent</field>
        <field name="sequence">30</field>
    </record>
    <record id="shahtaj_expense_category_phone" model="shahtaj.expense.category">
        <field name="name">Phone / Internet</field>
        <field name="sequence">40</field>
    </record>
    <record id="shahtaj_expense_category_vehicle" model="shahtaj.expense.category">
        <field name="name">Vehicle Maintenance</field>
        <field name="sequence">50</field>
    </record>
    <record id="shahtaj_expense_category_misc" model="shahtaj.expense.category">
        <field name="name">Misc / Other</field>
        <field name="sequence">90</field>
    </record>

</odoo>
