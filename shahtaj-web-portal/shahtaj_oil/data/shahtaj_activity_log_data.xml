<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Separate from noupdate cron file so upgrades on existing DBs always get this job. -->
    <record id="ir_cron_shahtaj_purge_activity_logs" model="ir.cron">
        <field name="name">Shahtaj: Purge activity logs older than 2 days</field>
        <field name="model_id" ref="model_shahtaj_activity_log"/>
        <field name="state">code</field>
        <field name="code">model._cron_purge_old_logs()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
