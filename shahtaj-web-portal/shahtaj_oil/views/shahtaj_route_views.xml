<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_shahtaj_route_list" model="ir.ui.view">
        <field name="name">shahtaj.route.list</field>
        <field name="model">shahtaj.route</field>
        <field name="arch" type="xml">
            <list>
                <header>
                    <button name="action_open_assign_shops_wizard" type="object"
                            string="Assign Shops"
                            display="always"/>
                </header>
                <field name="name"/>
                <field name="zone_id"/>
                <field name="shop_count"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_shahtaj_route_form" model="ir.ui.view">
        <field name="name">shahtaj.route.form</field>
        <field name="model">shahtaj.route</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button string="Save" special="save" class="oe_highlight" data-hotkey="s"/>
                    <button string="Discard" special="cancel" data-hotkey="j"/>
                    <button name="action_open_assign_shops_wizard" type="object"
                            string="Assign Shops"
                            class="oe_highlight"/>
                </header>
                <sheet>
                    <div class="alert alert-info" role="alert">
                        <strong>Recommended flow:</strong>
                        1) Create the route → 2) Create shops (name only is enough) →
                        3) Click <b>Assign Shops</b> to link them →
                        4) Set Weekly Schedules for order bookers.
                        Unassigned shops do not get visit tasks.
                    </div>
                    <div class="oe_title">
                        <label for="name" string="Route Name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Route A" required="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Zone">
                            <field name="zone_id" required="1" options="{'no_create': False}"/>
                        </group>
                        <group string="Status">
                            <field name="shop_count"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Shops on this route" name="shops">
                            <field name="shop_ids"
                                   context="{
                                       'shahtaj_shop_form': True,
                                       'default_is_shahtaj_shop': True,
                                       'default_shop_approval_state': 'approved',
                                       'default_company_type': 'company',
                                       'default_route_id': id,
                                       'default_zone_id': zone_id,
                                       'form_view_ref': 'shahtaj_oil.view_shahtaj_shop_form'
                                   }">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="owner_name"/>
                                    <field name="owner_phone"/>
                                    <field name="registered_by_name" string="Registered By" optional="show"/>
                                    <field name="route_id" column_invisible="1"/>
                                    <field name="zone_id" column_invisible="1"/>
                                    <field name="shop_approval_state" widget="badge"
                                           decoration-success="shop_approval_state == 'approved'"
                                           decoration-warning="shop_approval_state == 'pending'"/>
                                    <field name="shahtaj_visit_tag" widget="badge" optional="show"/>
                                    <field name="partner_latitude" optional="hide"/>
                                    <field name="partner_longitude" optional="hide"/>
                                </list>
                            </field>
                            <p class="text-muted">
                                Prefer <b>Assign Shops</b> for bulk linking.
                                You can still add/create a shop here if needed.
                            </p>
                        </page>
                    </notebook>
                </sheet>
                <footer>
                    <button string="Save" special="save" class="btn-primary" data-hotkey="s"/>
                    <button string="Discard" special="cancel" class="btn-secondary" data-hotkey="j"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_shahtaj_route" model="ir.actions.act_window">
        <field name="name">Routes</field>
        <field name="res_model">shahtaj.route</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a sales route
            </p>
            <p>
                Routes and shops are separate. Create the route, create shops,
                then use <b>Assign Shops</b> to link them. Order bookers are
                assigned per weekday under Weekly Schedules.
            </p>
        </field>
    </record>

    <record id="action_shahtaj_route_by_zone" model="ir.actions.act_window">
        <field name="name">Routes</field>
        <field name="res_model">shahtaj.route</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('zone_id', '=', active_id)]</field>
        <field name="context">{'default_zone_id': active_id}</field>
    </record>

</odoo>
