<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_shahtaj_route_list" model="ir.ui.view">
        <field name="name">shahtaj.route.list</field>
        <field name="model">shahtaj.route</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="zone_id"/>
                <field name="shop_count"/>
                <field name="unassigned_shop_count" optional="show"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_shahtaj_route_form" model="ir.ui.view">
        <field name="name">shahtaj.route.form</field>
        <field name="model">shahtaj.route</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button string="Save" special="save" class="oe_highlight" data-hotkey="s"/>
                    <button string="Discard" special="cancel" data-hotkey="j"/>
                </header>
                <sheet>
                    <div class="alert alert-info" role="alert">
                        <b>Checked</b> = shop is on this route.
                        <b>Unchecked</b> = Unassigned (can be assigned here).
                        Only Unassigned shops and shops already on this route are shown.
                        Click <b>Save</b> after changing checks. Visit tasks follow assigned shops;
                        weekly schedules stay on the route.
                    </div>
                    <div class="oe_title">
                        <label for="name" string="Route Name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Route A" required="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Zone">
                            <field name="zone_id" required="1" options="{'no_create': False}"/>
                        </group>
                        <group string="Status">
                            <field name="shop_count"/>
                            <field name="unassigned_shop_count"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Shops checklist" invisible="not id">
                        <field name="assign_shop_ids"
                               widget="many2many_checkboxes"
                               nolabel="1"
                               class="o_shahtaj_route_shop_checklist"
                               context="{'shahtaj_route_checklist': True}"
                               domain="[
                                   ('is_shahtaj_shop', '=', True),
                                   ('active', '=', True),
                                   ('shop_approval_state', '=', 'approved'),
                                   '|',
                                   ('route_id', '=', False),
                                   ('route_id', '=', id),
                               ]"
                               options="{'no_create': True}"/>
                    </group>
                    <div class="alert alert-warning" role="alert"
                         invisible="id">
                        Save this route first, then assign shops with the checklist.
                    </div>
                    <!-- Keep One2many loaded for counts/sync; hide from UI -->
                    <field name="shop_ids" invisible="1"/>
                </sheet>
                <footer>
                    <button string="Save" special="save" class="btn-primary" data-hotkey="s"/>
                    <button string="Discard" special="cancel" class="btn-secondary" data-hotkey="j"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_shahtaj_route" model="ir.actions.act_window">
        <field name="name">Routes</field>
        <field name="res_model">shahtaj.route</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a sales route
            </p>
            <p>
                Open a route and check shops to assign them. Unchecked shops stay Unassigned.
            </p>
        </field>
    </record>

    <record id="action_shahtaj_route_by_zone" model="ir.actions.act_window">
        <field name="name">Routes</field>
        <field name="res_model">shahtaj.route</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('zone_id', '=', active_id)]</field>
        <field name="context">{'default_zone_id': active_id}</field>
    </record>

</odoo>
