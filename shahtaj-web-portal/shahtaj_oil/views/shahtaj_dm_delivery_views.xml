<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Read-only invoice list for DM / distributor shop balance sharing -->
    <record id="view_shahtaj_dm_shop_invoice_list" model="ir.ui.view">
        <field name="name">account.move.list.shahtaj.dm.shop</field>
        <field name="model">account.move</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <list string="Shop Invoices" create="false" edit="false" delete="false"
                  decoration-danger="payment_state == 'not_paid'"
                  decoration-warning="payment_state == 'partial'"
                  decoration-info="payment_state == 'in_payment'"
                  decoration-success="payment_state == 'paid'"
                  default_order="payment_state, invoice_date desc">
                <field name="name" string="Number"/>
                <field name="partner_id" string="Shop"/>
                <field name="move_type" string="Type"/>
                <field name="invoice_date" string="Date"/>
                <field name="invoice_date_due" string="Due"/>
                <field name="amount_total_signed" string="Total" sum="Total"/>
                <field name="amount_residual_signed" string="Remaining" sum="Remaining"/>
                <field name="payment_state" string="Payment" widget="badge"
                       decoration-danger="payment_state == 'not_paid'"
                       decoration-warning="payment_state == 'partial'"
                       decoration-info="payment_state == 'in_payment'"
                       decoration-success="payment_state == 'paid'"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="company_id" optional="hide" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_shahtaj_dm_shop_invoice_search" model="ir.ui.view">
        <field name="name">account.move.search.shahtaj.dm.shop</field>
        <field name="model">account.move</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <search string="Shop Invoices">
                <field name="name"/>
                <field name="partner_id"/>
                <filter name="unpaid" string="Unpaid"
                        domain="[('payment_state', '=', 'not_paid')]"/>
                <filter name="partial" string="Partial"
                        domain="[('payment_state', '=', 'partial')]"/>
                <filter name="in_payment" string="In Payment"
                        domain="[('payment_state', '=', 'in_payment')]"/>
                <filter name="paid" string="Fully Paid"
                        domain="[('payment_state', '=', 'paid')]"/>
                <filter name="open_due" string="Still Due"
                        domain="[('payment_state', 'in', ('not_paid', 'partial', 'in_payment'))]"/>
                <separator/>
                <filter name="group_payment_state" string="Group by Payment"
                        context="{'group_by': 'payment_state'}"/>
                <filter name="group_partner" string="Group by Shop"
                        context="{'group_by': 'partner_id'}"/>
            </search>
        </field>
    </record>

    <!-- ── LIST VIEW ── -->
    <record id="view_shahtaj_dm_delivery_list" model="ir.ui.view">
        <field name="name">shahtaj.dm.delivery.list</field>
        <field name="model">shahtaj.dm.delivery</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'not_ready'"
                  decoration-info="state == 'ready'"
                  decoration-warning="state in ('picked', 'partial') or field_state in ('not_attended', 'failed')"
                  decoration-success="state == 'delivered' or field_state == 'done'"
                  decoration-danger="state == 'returned' or field_state == 'failed' or is_overdue">
                <header>
                    <button name="action_refresh_for_current_user" type="object"
                            string="Refresh" class="btn-secondary" icon="fa-refresh"
                            groups="shahtaj_oil.group_shahtaj_delivery_man"/>
                    <button name="action_bulk_pick_stock" type="object"
                            string="Today's Load" class="btn-primary" icon="fa-truck"
                            groups="shahtaj_oil.group_shahtaj_delivery_man"/>
                </header>
                <field name="scheduled_date" optional="show"/>
                <field name="schedule_status" string="Schedule" widget="badge" optional="show"
                       decoration-danger="schedule_status in ('overdue', 'unscheduled')"
                       decoration-warning="schedule_status == 'future'"
                       decoration-info="schedule_status == 'today'"
                       decoration-muted="schedule_status == 'closed'"/>
                <field name="is_overdue" column_invisible="1"/>
                <field name="picked_at" optional="hide"/>
                <field name="delivered_at" optional="show"/>
                <field name="receiver_name" optional="hide"/>
                <field name="has_delivery_proof" string="Proof" optional="hide"/>
                <field name="sale_order_id"/>
                <field name="partner_id"/>
                <field name="is_walk_in" string="Walk-in" optional="show"/>
                <field name="order_booker_id"/>
                <field name="delivery_man_id" optional="hide"
                       groups="shahtaj_oil.group_shahtaj_distributor"/>
                <field name="assignment_mode" optional="hide"
                       groups="shahtaj_oil.group_shahtaj_distributor"/>
                <field name="order_date" optional="hide"/>
                <field name="amount_total" sum="Total"/>
                <field name="shop_outstanding_balance" string="Shop Due" optional="show"
                       decoration-danger="shop_outstanding_balance &gt; 0"
                       groups="shahtaj_oil.group_shahtaj_delivery_man,shahtaj_oil.group_shahtaj_distributor,shahtaj_oil.group_shahtaj_native_distributor_ui"/>
                <field name="shop_unpaid_invoice_count" string="Open Inv." optional="hide"
                       groups="shahtaj_oil.group_shahtaj_delivery_man,shahtaj_oil.group_shahtaj_distributor,shahtaj_oil.group_shahtaj_native_distributor_ui"/>
                <field name="qty_assigned_total" string="Assigned Qty" optional="show"
                       groups="shahtaj_oil.group_shahtaj_distributor"/>
                <field name="is_split_share" optional="hide"
                       groups="shahtaj_oil.group_shahtaj_distributor"/>
                <field name="state" string="Stock" widget="badge"
                       decoration-danger="state in ('not_ready', 'returned')"
                       decoration-info="state == 'ready'"
                       decoration-warning="state in ('picked', 'partial')"
                       decoration-success="state == 'delivered'"/>
                <field name="field_state" string="Stop" widget="badge"
                       decoration-muted="field_state == 'pending'"
                       decoration-info="field_state == 'in_transit'"
                       decoration-warning="field_state == 'not_attended'"
                       decoration-danger="field_state == 'failed'"
                       decoration-success="field_state == 'done'"/>
                <button name="action_pick_stock" type="object"
                        string="Pick Stock" icon="fa-cube"
                        invisible="is_walk_in or state not in ('ready', 'picked', 'partial')"
                        groups="shahtaj_oil.group_shahtaj_delivery_man,shahtaj_oil.group_shahtaj_distributor,shahtaj_oil.group_shahtaj_native_distributor_ui"/>
                <button name="action_field_in_transit" type="object"
                        string="Heading to Shop" icon="fa-road"
                        invisible="is_walk_in or state not in ('picked', 'partial') or field_state in ('in_transit', 'done')"
                        groups="shahtaj_oil.group_shahtaj_delivery_man"/>
                <button name="action_deliver_to_shop" type="object"
                        string="Deliver (GPS)" icon="fa-map-marker"
                        invisible="is_walk_in or state not in ('picked', 'partial')"
                        groups="shahtaj_oil.group_shahtaj_delivery_man"/>
                <button name="action_return_to_warehouse" type="object"
                        string="Return WH" icon="fa-undo"
                        invisible="is_walk_in or state not in ('picked', 'partial')"
                        groups="shahtaj_oil.group_shahtaj_delivery_man,shahtaj_oil.group_shahtaj_distributor,shahtaj_oil.group_shahtaj_native_distributor_ui"/>
                <button name="action_undo_delivery_to_shop" type="object"
                        string="Undo Deliver" icon="fa-reply"
                        invisible="is_walk_in or state not in ('partial', 'delivered', 'ready', 'picked') or (state in ('ready', 'picked') and field_state != 'done')"
                        groups="shahtaj_oil.group_shahtaj_distributor"
                        confirm="Reverse shop handoff or repair Stop/visit? Only before invoicing."/>
                <button name="action_print_invoice" type="object"
                        string="Print Invoice" icon="fa-print"
                        invisible="state == 'not_ready'"
                        groups="shahtaj_oil.group_shahtaj_delivery_man"/>
                <button name="action_view_shop_invoices" type="object"
                        string="Shop Due" icon="fa-money"
                        invisible="not partner_id"
                        groups="shahtaj_oil.group_shahtaj_delivery_man,shahtaj_oil.group_shahtaj_distributor,shahtaj_oil.group_shahtaj_native_distributor_ui"/>
                <button name="action_collect_shop_payment" type="object"
                        string="Collect" icon="fa-university"
                        invisible="not partner_id"
                        groups="shahtaj_oil.group_shahtaj_delivery_man,shahtaj_oil.group_shahtaj_distributor,shahtaj_oil.group_shahtaj_native_distributor_ui"/>
            </list>
        </field>
    </record>

    <!-- ── FORM VIEW ── -->
    <record id="view_shahtaj_dm_delivery_form" model="ir.ui.view">
        <field name="name">shahtaj.dm.delivery.form</field>
        <field name="model">shahtaj.dm.delivery</field>
        <field name="arch" type="xml">
            <form string="Delivery Order">
                <header>
                    <button name="action_pick_stock" type="object"
                            string="Pick Stock from Warehouse" class="oe_highlight"
                            invisible="is_walk_in or state not in ('ready', 'picked', 'partial')"
                            groups="shahtaj_oil.group_shahtaj_delivery_man,shahtaj_oil.group_shahtaj_distributor,shahtaj_oil.group_shahtaj_native_distributor_ui"/>
                    <button name="action_field_in_transit" type="object"
                            string="Heading to Shop" class="btn-secondary"
                            invisible="is_walk_in or state not in ('picked', 'partial') or field_state in ('in_transit', 'done')"
                            groups="shahtaj_oil.group_shahtaj_delivery_man"
                            confirm="Mark this shop stop as Heading to Shop? This does not change your day Left Office status."/>
                    <button name="action_field_not_attended" type="object"
                            string="Shop Closed" class="btn-warning"
                            invisible="is_walk_in or state not in ('picked', 'partial') or field_state == 'done'"
                            groups="shahtaj_oil.group_shahtaj_delivery_man"
                            confirm="Mark shop closed / not attended? Add a note first if empty."/>
                    <button name="action_field_failed" type="object"
                            string="Could Not Deliver" class="btn-danger"
                            invisible="is_walk_in or state not in ('picked', 'partial') or field_state == 'done'"
                            groups="shahtaj_oil.group_shahtaj_delivery_man"
                            confirm="Mark could not deliver? Stock stays on the van. Add a note first if empty."/>
                    <button name="action_deliver_to_shop" type="object"
                            string="Deliver to Shop (GPS)" class="oe_highlight"
                            invisible="is_walk_in or state not in ('picked', 'partial')"
                            groups="shahtaj_oil.group_shahtaj_delivery_man"/>
                    <button name="action_return_to_warehouse" type="object"
                            string="Return Undelivered to Warehouse" class="btn-warning"
                            invisible="is_walk_in or state not in ('picked', 'partial')"
                            groups="shahtaj_oil.group_shahtaj_delivery_man,shahtaj_oil.group_shahtaj_distributor,shahtaj_oil.group_shahtaj_native_distributor_ui"
                            confirm="Return undelivered van stock for this shop back to the warehouse?"/>
                    <button name="action_undo_delivery_to_shop" type="object"
                            string="Undo Delivery to Shop" class="btn-danger"
                            invisible="is_walk_in or state not in ('partial', 'delivered', 'ready', 'picked') or (state in ('ready', 'picked') and field_state != 'done')"
                            groups="shahtaj_oil.group_shahtaj_distributor"
                            confirm="Reverse this shop handoff (or repair Stop/visit if stock already cleared)? Only allowed before invoicing."/>
                    <button name="action_refresh_delivery_status" type="object"
                            string="Refresh Status" class="btn-secondary"
                            groups="shahtaj_oil.group_shahtaj_distributor,shahtaj_oil.group_shahtaj_native_distributor_ui"
                            icon="fa-refresh"/>
                    <button name="action_field_reset_pending" type="object"
                            string="Reset Stop" class="btn-secondary"
                            invisible="field_state not in ('in_transit', 'not_attended', 'failed', 'done') or state in ('delivered', 'returned')"
                            groups="shahtaj_oil.group_shahtaj_distributor"/>
                    <button name="action_print_invoice" type="object"
                            string="Print Invoice" class="btn-secondary"
                            invisible="state == 'not_ready'"
                            groups="shahtaj_oil.group_shahtaj_delivery_man"/>
                    <button name="action_view_shop_invoices" type="object"
                            string="Shop Invoices &amp; Balance" class="btn-secondary"
                            icon="fa-money"
                            invisible="not partner_id"
                            groups="shahtaj_oil.group_shahtaj_delivery_man,shahtaj_oil.group_shahtaj_distributor,shahtaj_oil.group_shahtaj_native_distributor_ui"/>
                    <button name="action_collect_shop_payment" type="object"
                            string="Collect Payment" class="oe_highlight"
                            icon="fa-university"
                            invisible="not partner_id"
                            groups="shahtaj_oil.group_shahtaj_delivery_man,shahtaj_oil.group_shahtaj_distributor,shahtaj_oil.group_shahtaj_native_distributor_ui"/>
                    <button name="action_view_van_quants" type="object"
                            string="Open Van Stock" class="btn-secondary"
                            invisible="not van_location_id"
                            groups="shahtaj_oil.group_shahtaj_delivery_man,shahtaj_oil.group_shahtaj_distributor,shahtaj_oil.group_shahtaj_native_distributor_ui"/>
                    <button name="action_view_sale_order" type="object"
                            string="View Sale Order" class="btn-secondary"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="not_ready,ready,picked,partial,delivered,returned"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_shop_invoices" type="object"
                                class="oe_stat_button" icon="fa-file-text-o"
                                invisible="not partner_id"
                                groups="shahtaj_oil.group_shahtaj_delivery_man,shahtaj_oil.group_shahtaj_distributor,shahtaj_oil.group_shahtaj_native_distributor_ui">
                            <div class="o_stat_info">
                                <span class="o_stat_value">
                                    <field name="shop_unpaid_invoice_count" nolabel="1"/>
                                    / <field name="shop_invoice_count" nolabel="1"/>
                                </span>
                                <span class="o_stat_text">Open / All Inv.</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="display_name" readonly="1"/></h1>
                    </div>
                    <div class="alert alert-info" role="alert">
                        <b>Three different things</b>
                        <ul class="mb-0">
                            <li><b>Day Status</b> — My Day Session: At Office / Left Office (whole DM, not this shop)</li>
                            <li><b>Stock</b> (top bar) — warehouse: pick → van → shop / return</li>
                            <li><b>Stop</b> — this shop only: Not Started / Heading to Shop / Shop Closed / Could Not Deliver / Done</li>
                            <li><b>Heading to Shop</b> on this form = this stop only (not “left the warehouse”)</li>
                            <li><b>Deliver to Shop (GPS)</b> — at the shop: Use My GPS → set qty → confirm</li>
                            <li><b>Undo Delivery to Shop</b> (distributor) — before invoicing: stock back to van, clear Delivered</li>
                            <li>Shop Closed and Could Not Deliver need a <b>note</b> below</li>
                        </ul>
                    </div>
                    <group>
                        <group string="Order Details">
                            <field name="sale_order_id" readonly="1"/>
                            <field name="partner_id" readonly="1"/>
                            <field name="is_walk_in" readonly="1"/>
                            <field name="order_booker_id" readonly="1"
                                   invisible="is_walk_in"/>
                            <field name="order_date" readonly="1"/>
                        </group>
                        <group string="Delivery Info">
                            <field name="shahtaj_processing_locked" invisible="1"/>
                            <field name="shahtaj_can_edit_schedule" invisible="1"/>
                            <field name="delivery_man_id"
                                   readonly="shahtaj_processing_locked"/>
                            <field name="scheduled_date"
                                   readonly="not shahtaj_can_edit_schedule"/>
                            <field name="schedule_status" widget="badge" readonly="1"
                                   decoration-danger="schedule_status in ('overdue', 'unscheduled')"
                                   decoration-warning="schedule_status == 'future'"
                                   decoration-info="schedule_status == 'today'"
                                   decoration-muted="schedule_status == 'closed'"/>
                            <field name="is_overdue" invisible="1"/>
                            <field name="scheduled_time" widget="float_time"
                                   readonly="not shahtaj_can_edit_schedule"/>
                            <field name="picked_at" readonly="1"
                                   invisible="not picked_at"/>
                            <field name="delivered_at" readonly="1"
                                   invisible="not delivered_at"/>
                            <field name="field_state" widget="badge"
                                   decoration-muted="field_state == 'pending'"
                                   decoration-info="field_state == 'in_transit'"
                                   decoration-warning="field_state == 'not_attended'"
                                   decoration-danger="field_state == 'failed'"
                                   decoration-success="field_state == 'done'"
                                   readonly="1"/>
                            <field name="assignment_mode" readonly="1"
                                   groups="shahtaj_oil.group_shahtaj_distributor"/>
                            <field name="assigned_by_id" readonly="1"
                                   groups="shahtaj_oil.group_shahtaj_distributor"
                                   invisible="not assigned_by_id"/>
                            <field name="amount_total" readonly="1"/>
                            <field name="qty_assigned_total" readonly="1"/>
                            <field name="is_split_share" readonly="1"
                                   groups="shahtaj_oil.group_shahtaj_distributor"/>
                            <field name="invoice_status" readonly="1"/>
                            <field name="van_location_id" readonly="1"
                                   invisible="not van_location_id"/>
                            <field name="visit_task_id" readonly="1"
                                   invisible="not visit_task_id"/>
                        </group>
                    </group>
                    <group string="Shop Balance (share with shopkeeper)"
                           invisible="not partner_id">
                        <group>
                            <field name="shop_category" readonly="1"/>
                            <field name="shop_outstanding_balance" readonly="1"
                                   decoration-danger="shop_outstanding_balance &gt; 0"/>
                            <field name="shop_unpaid_invoice_amount" readonly="1"
                                   decoration-warning="shop_unpaid_invoice_amount &gt; 0"/>
                        </group>
                        <group>
                            <field name="shop_credit_limit" readonly="1"
                                   invisible="shop_category != 'credit'"/>
                            <field name="shop_unpaid_invoice_count" readonly="1"/>
                            <field name="shop_invoice_count" readonly="1"/>
                            <button name="action_view_shop_invoices" type="object"
                                    string="Open Invoice List" class="btn-link"
                                    icon="fa-external-link"
                                    groups="shahtaj_oil.group_shahtaj_delivery_man,shahtaj_oil.group_shahtaj_distributor,shahtaj_oil.group_shahtaj_native_distributor_ui"/>
                        </group>
                    </group>
                    <group string="Last GPS deliver" invisible="not gps_verified">
                        <group>
                            <field name="gps_verified" readonly="1"/>
                            <field name="delivered_at" string="Delivered At" readonly="1"/>
                            <field name="check_in_distance_m" string="Distance (m)" readonly="1"/>
                            <field name="receiver_name" readonly="1"
                                   invisible="not receiver_name"/>
                            <field name="has_delivery_proof" invisible="1"/>
                        </group>
                        <group>
                            <field name="check_in_latitude" string="Deliver lat" readonly="1"/>
                            <field name="check_in_longitude" string="Deliver lng" readonly="1"/>
                            <field name="delivery_proof_image" widget="image" readonly="1"
                                   invisible="not has_delivery_proof"
                                   options="{'size': [128, 128]}"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1"
                               placeholder="Required for Shop Closed / Could Not Deliver (e.g. shop closed, customer refused)…"/>
                    </group>
                    <notebook>
                        <page string="Products" name="lines">
                            <div class="alert alert-info" role="alert"
                                 invisible="not is_split_share">
                                This job is a <b>split share</b> of the sales order.
                                Pick and deliver only the <b>Assigned to DM</b> quantities.
                            </div>
                            <field name="line_ids" readonly="1">
                                <list>
                                    <field name="product_id"/>
                                    <field name="qty_ordered" string="SO Ordered"/>
                                    <field name="qty_assigned" string="Assigned to DM" sum="Assigned"/>
                                    <field name="qty_to_pick" string="Still to Pick"/>
                                    <field name="qty_picked" sum="Picked"/>
                                    <field name="qty_delivered" sum="Delivered"/>
                                    <field name="qty_remaining_on_van" sum="On van"/>
                                    <field name="product_uom_id"/>
                                </list>
                            </field>
                        </page>
                        <page string="Shop Balance" name="shop_balance"
                              invisible="not partner_id">
                            <div class="alert alert-secondary" role="alert">
                                Read-only invoice list — use <b>Collect Payment</b> in the header
                                to take cash into the DM wallet (DMCASH).
                            </div>
                            <div class="mb-3">
                                <button name="action_collect_shop_payment" type="object"
                                        string="Collect Payment to Wallet" class="btn-primary"
                                        icon="fa-university"
                                        groups="shahtaj_oil.group_shahtaj_delivery_man,shahtaj_oil.group_shahtaj_distributor,shahtaj_oil.group_shahtaj_native_distributor_ui"/>
                            </div>
                            <group>
                                <group string="Summary">
                                    <field name="partner_id" readonly="1" string="Shop"/>
                                    <field name="shop_outstanding_balance" readonly="1"
                                           decoration-danger="shop_outstanding_balance &gt; 0"/>
                                    <field name="shop_unpaid_invoice_amount" readonly="1"/>
                                </group>
                                <group string="Counts">
                                    <field name="shop_unpaid_invoice_count" readonly="1"/>
                                    <field name="shop_invoice_count" readonly="1"/>
                                    <field name="shop_credit_limit" readonly="1"
                                           invisible="shop_category != 'credit'"/>
                                </group>
                            </group>
                            <separator string="Invoices (Unpaid → Partial → Paid)"/>
                            <field name="shop_invoice_ids" readonly="1" nolabel="1"
                                   context="{'list_view_ref': 'shahtaj_oil.view_shahtaj_dm_shop_invoice_list'}">
                                <list create="false" edit="false" delete="false"
                                      decoration-danger="payment_state == 'not_paid'"
                                      decoration-warning="payment_state == 'partial'"
                                      decoration-info="payment_state == 'in_payment'"
                                      decoration-success="payment_state == 'paid'">
                                    <field name="name" string="Number"/>
                                    <field name="move_type" string="Type"/>
                                    <field name="invoice_date" string="Date"/>
                                    <field name="invoice_date_due" string="Due"/>
                                    <field name="amount_total_signed" string="Total" sum="Total"/>
                                    <field name="amount_residual_signed" string="Remaining" sum="Remaining"/>
                                    <field name="payment_state" string="Payment" widget="badge"
                                           decoration-danger="payment_state == 'not_paid'"
                                           decoration-warning="payment_state == 'partial'"
                                           decoration-info="payment_state == 'in_payment'"
                                           decoration-success="payment_state == 'paid'"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                            <separator string="Last 10 paid — who collected"/>
                            <field name="shop_paid_invoices_html" nolabel="1" colspan="2"/>
                            <separator string="Printable summary"/>
                            <field name="shop_invoices_html" nolabel="1" colspan="2"/>
                        </page>
                        <page string="Van Stock" name="van_stock"
                              invisible="not van_location_id">
                            <div class="mb-3">
                                <button name="action_view_van_quants" type="object"
                                        string="Open Full Van Inventory" class="btn-primary"
                                        icon="fa-cubes"
                                        groups="shahtaj_oil.group_shahtaj_delivery_man,shahtaj_oil.group_shahtaj_distributor,shahtaj_oil.group_shahtaj_native_distributor_ui"/>
                                <button name="action_pick_stock" type="object"
                                        string="Pick More to Van" class="btn-secondary"
                                        icon="fa-cube"
                                        invisible="is_walk_in or state not in ('ready', 'picked', 'partial')"
                                        groups="shahtaj_oil.group_shahtaj_delivery_man,shahtaj_oil.group_shahtaj_distributor,shahtaj_oil.group_shahtaj_native_distributor_ui"/>
                                <button name="action_return_to_warehouse" type="object"
                                        string="Return Leftover to Warehouse" class="btn-warning"
                                        icon="fa-undo"
                                        invisible="is_walk_in or state not in ('picked', 'partial')"
                                        groups="shahtaj_oil.group_shahtaj_delivery_man,shahtaj_oil.group_shahtaj_distributor,shahtaj_oil.group_shahtaj_native_distributor_ui"
                                        confirm="Return undelivered van stock for this shop back to the warehouse?"/>
                            </div>
                            <group string="This shop — quantities">
                                <field name="line_ids" nolabel="1" readonly="1">
                                    <list>
                                        <field name="product_id"/>
                                        <field name="qty_assigned" string="Assigned" sum="Assigned"/>
                                        <field name="qty_picked" sum="Picked"/>
                                        <field name="qty_delivered" sum="Delivered"/>
                                        <field name="qty_remaining_on_van" sum="Left on van"/>
                                        <field name="product_uom_id"/>
                                    </list>
                                </field>
                            </group>
                            <group string="Live van location + totals">
                                <field name="van_stock_html" nolabel="1" colspan="2"/>
                            </group>
                        </page>
                        <page string="Stock Transfers" name="transfers"
                              invisible="not pick_picking_id and not delivery_picking_id and not return_picking_id">
                            <group>
                                <field name="pick_picking_id" readonly="1"/>
                                <field name="delivery_picking_id" readonly="1"
                                       invisible="not delivery_picking_id"/>
                                <field name="return_picking_id" readonly="1"
                                       invisible="not return_picking_id"/>
                            </group>
                        </page>
                    </notebook>
                    <field name="currency_id" invisible="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ── SEARCH VIEW ── -->
    <record id="view_shahtaj_dm_delivery_search" model="ir.ui.view">
        <field name="name">shahtaj.dm.delivery.search</field>
        <field name="model">shahtaj.dm.delivery</field>
        <field name="arch" type="xml">
            <search>
                <field name="sale_order_id"/>
                <field name="partner_id"/>
                <field name="order_booker_id"/>
                <field name="delivery_man_id"/>
                <field name="scheduled_date"/>
                <filter string="Today" name="today"
                        domain="[('scheduled_date', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter string="Today Not Done" name="today_not_done"
                        domain="[('scheduled_date', '=', context_today().strftime('%Y-%m-%d')), ('state', 'in', ('not_ready', 'ready', 'picked', 'partial'))]"/>
                <filter string="Overdue / Not Done" name="overdue"
                        domain="[('is_overdue', '=', True)]"/>
                <filter string="Unscheduled" name="unscheduled"
                        domain="[('state', 'in', ('not_ready', 'ready', 'picked', 'partial')), ('scheduled_date', '=', False)]"/>
                <filter string="This Week" name="this_week"
                        domain="[('scheduled_date', '&gt;=', ((context_today() - datetime.timedelta(days=context_today().weekday())).strftime('%Y-%m-%d'))), ('scheduled_date', '&lt;=', ((context_today() + datetime.timedelta(days=6 - context_today().weekday())).strftime('%Y-%m-%d')))]"/>
                <separator/>
                <filter string="Manual Assign" name="manual_assign"
                        domain="[('assignment_mode', '=', 'manual')]"/>
                <filter string="Auto Assign" name="auto_assign"
                        domain="[('assignment_mode', '=', 'auto')]"/>
                <filter string="Walk-in" name="walk_in"
                        domain="[('is_walk_in', '=', True)]"/>
                <filter string="Shop deliveries" name="shop_deliveries"
                        domain="[('is_walk_in', '!=', True)]"/>
                <separator/>
                <filter string="Waiting Invoice" name="not_ready"
                        domain="[('state', '=', 'not_ready')]"/>
                <filter string="Ready to Pick" name="ready"
                        domain="[('state', '=', 'ready')]"/>
                <filter string="Loaded on Van" name="picked"
                        domain="[('state', '=', 'picked')]"/>
                <filter string="Part Delivered" name="partial"
                        domain="[('state', '=', 'partial')]"/>
                <filter string="Delivered" name="delivered"
                        domain="[('state', '=', 'delivered')]"/>
                <filter string="Returned to WH" name="returned"
                        domain="[('state', '=', 'returned')]"/>
                <separator/>
                <filter string="Not Started" name="stop_pending"
                        domain="[('field_state', '=', 'pending')]"/>
                <filter string="Heading to Shop" name="stop_in_transit"
                        domain="[('field_state', '=', 'in_transit')]"/>
                <filter string="Shop Closed" name="stop_not_attended"
                        domain="[('field_state', '=', 'not_attended')]"/>
                <filter string="Could Not Deliver" name="stop_failed"
                        domain="[('field_state', '=', 'failed')]"/>
                <filter string="Stop Done" name="stop_done"
                        domain="[('field_state', '=', 'done')]"/>
                <filter string="Needs Attention" name="stop_attention"
                        domain="[('field_state', 'in', ('not_attended', 'failed'))]"/>
                <separator/>
                <filter string="Stock" name="group_state"
                        context="{'group_by': 'state'}"/>
                <filter string="Stop" name="group_field_state"
                        context="{'group_by': 'field_state'}"/>
                <filter string="Day" name="group_day"
                        context="{'group_by': 'scheduled_date'}"/>
                <filter string="Open Jobs" name="open"
                        domain="[('state', 'in', ('not_ready', 'ready', 'picked', 'partial'))]"/>
            </search>
        </field>
    </record>

    <!-- ── ACTIONS ── -->

    <record id="action_shahtaj_dm_delivery_all" model="ir.actions.act_window">
        <field name="name">DM Delivery Orders</field>
        <field name="res_model">shahtaj.dm.delivery</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_shahtaj_dm_delivery_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No delivery orders yet
            </p>
            <p>
                Delivery jobs are assigned by the distributor (Assign Delivery Man),
                or created automatically when an invoiced booker order has a linked DM.
            </p>
        </field>
    </record>

    <delete model="ir.actions.server" id="action_shahtaj_dm_my_deliveries"/>
    <delete model="ir.actions.server" id="action_shahtaj_dm_all_delivery_orders"/>

    <record id="action_shahtaj_dm_my_deliveries" model="ir.actions.act_window">
        <field name="name">My Deliveries</field>
        <field name="res_model">shahtaj.dm.delivery</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '!=', 'not_ready')]</field>
        <field name="context">{
            'search_default_today': 1,
        }</field>
        <field name="search_view_id" ref="view_shahtaj_dm_delivery_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No deliveries for today
            </p>
            <p>
                Jobs assigned to you appear here after the distributor assigns
                a sales order (or after invoice sync). Default filter is
                <b>Today</b> — only jobs scheduled for today. Overdue jobs are
                handled by the distributor (reschedule Delivery Day).
                Stock: Ready → Loaded → Delivered. Stop: Heading to Shop / Shop Closed / Done. Day: Leave Office is on My Day Session.
            </p>
        </field>
    </record>

    <record id="action_shahtaj_dm_all_delivery_orders" model="ir.actions.act_window">
        <field name="name">All My Orders</field>
        <field name="res_model">shahtaj.dm.delivery</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_shahtaj_dm_delivery_search"/>
    </record>

    <!-- Distributor: all DM jobs -->
    <record id="action_shahtaj_dm_dispatch_jobs" model="ir.actions.act_window">
        <field name="name">Delivery Jobs</field>
        <field name="res_model">shahtaj.dm.delivery</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_shahtaj_dm_delivery_search"/>
        <field name="context">{'search_default_today': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No delivery jobs yet
            </p>
            <p>
                Assign confirmed sales orders to delivery men from Field Sales
                Orders or Dispatch Orders (Assign Delivery Man). <b>Walk-in</b>
                van cash sales also appear here as completed jobs (filter Walk-in).
                Use <b>Overdue / Not Done</b> for open jobs past their delivery day,
                then edit Delivery Day to reschedule. Stop filters cover Shop Closed /
                Could Not Deliver.
            </p>
        </field>
    </record>

    <!-- Distributor: overdue / not-done open jobs (reschedule from form) -->
    <record id="action_shahtaj_dm_overdue_jobs" model="ir.actions.act_window">
        <field name="name">Overdue / Not Done</field>
        <field name="res_model">shahtaj.dm.delivery</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_shahtaj_dm_delivery_search"/>
        <field name="context">{'search_default_overdue': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No overdue delivery jobs
            </p>
            <p>
                Open jobs with a past delivery day (or no day) appear here.
                Edit <b>Delivery Day</b> to put them back on a DM's today plan.
            </p>
        </field>
    </record>

    <record id="action_shahtaj_dm_my_van_stock" model="ir.actions.server">
        <field name="name">Today Load</field>
        <field name="model_id" ref="model_shahtaj_dm_delivery"/>
        <field name="state">code</field>
        <field name="code">action = env['shahtaj.dm.today.load'].action_open()</field>
    </record>

</odoo>
