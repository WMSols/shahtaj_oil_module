<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Expense Categories -->
    <record id="view_shahtaj_expense_category_list" model="ir.ui.view">
        <field name="name">shahtaj.expense.category.list</field>
        <field name="model">shahtaj.expense.category</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="account_id" optional="show"/>
                <field name="note" optional="hide"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_shahtaj_expense_category_form" model="ir.ui.view">
        <field name="name">shahtaj.expense.category.form</field>
        <field name="model">shahtaj.expense.category</field>
        <field name="arch" type="xml">
            <form string="Expense Category">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="sequence"/>
                        <field name="account_id"/>
                        <field name="active"/>
                        <field name="note"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_shahtaj_expense_category" model="ir.actions.act_window">
        <field name="name">Expense Categories</field>
        <field name="res_model">shahtaj.expense.category</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create categories like Fuel, Salary, Rent
            </p>
            <p>
                Categories are selected on each expense. Optionally link an expense account.
            </p>
        </field>
    </record>

    <!-- Expenses -->
    <record id="view_shahtaj_expense_list" model="ir.ui.view">
        <field name="name">shahtaj.expense.list</field>
        <field name="model">shahtaj.expense</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'cancelled'"
                  decoration-info="state == 'draft'"
                  decoration-success="state == 'posted'">
                <field name="name"/>
                <field name="date"/>
                <field name="category_id"/>
                <field name="description"/>
                <field name="amount" sum="Total"/>
                <field name="journal_id"/>
                <field name="partner_id" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-success="state == 'posted'"
                       decoration-danger="state == 'cancelled'"/>
                <field name="move_name" optional="show"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="company_id" column_invisible="1" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_shahtaj_expense_form" model="ir.ui.view">
        <field name="name">shahtaj.expense.form</field>
        <field name="model">shahtaj.expense</field>
        <field name="arch" type="xml">
            <form string="Expense">
                <header>
                    <button name="action_post" type="object" string="Post Expense"
                            class="oe_highlight"
                            invisible="state != 'draft'"
                            confirm="Post this expense? Cash/Bank will decrease and it will appear on Profit &amp; Loss."/>
                    <button name="action_cancel" type="object" string="Cancel Expense"
                            invisible="state not in ('draft', 'posted')"
                            confirm="Cancel this expense? If posted, the journal entry will be reversed."/>
                    <button name="action_reset_draft" type="object" string="Reset to Draft"
                            invisible="state != 'cancelled'"/>
                    <button name="action_open_move" type="object" string="Open Journal Entry"
                            invisible="not move_id"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,posted"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Expense">
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="category_id" readonly="state != 'draft'"/>
                            <field name="description" readonly="state != 'draft'"
                                   placeholder="e.g. Route A petrol"/>
                            <field name="amount" readonly="state != 'draft'"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group string="Payment">
                            <field name="journal_id" readonly="state != 'draft'"/>
                            <field name="partner_id" readonly="state != 'draft'"/>
                            <field name="company_id" groups="base.group_multi_company"
                                   readonly="1"/>
                            <field name="move_id" readonly="1"
                                   invisible="not move_id"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1" colspan="2"
                               placeholder="Optional notes / receipt details"/>
                    </group>
                    <div class="alert alert-info" role="alert"
                         invisible="state != 'draft'">
                        <b>Draft</b> — edit freely. Click <b>Post Expense</b> to
                        reduce Cash/Bank and include this amount in Profit &amp; Loss
                        (Operating Expenses → Net Profit). Does not change invoices,
                        shop payments, or tax.
                    </div>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_shahtaj_expense_search" model="ir.ui.view">
        <field name="name">shahtaj.expense.search</field>
        <field name="model">shahtaj.expense</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="description"/>
                <field name="category_id"/>
                <field name="journal_id"/>
                <field name="partner_id"/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Posted" name="posted" domain="[('state', '=', 'posted')]"/>
                <filter string="Cancelled" name="cancelled" domain="[('state', '=', 'cancelled')]"/>
                <separator/>
                <filter string="Date" name="filter_date" date="date"/>
                <separator/>
                <filter string="Category" name="group_category" context="{'group_by': 'category_id'}"/>
                <filter string="Journal" name="group_journal" context="{'group_by': 'journal_id'}"/>
                <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                <filter string="Day" name="group_day" context="{'group_by': 'date:day'}"/>
            </search>
        </field>
    </record>

    <record id="action_shahtaj_expense" model="ir.actions.act_window">
        <field name="name">Expenses</field>
        <field name="res_model">shahtaj.expense</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_posted': 0}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Record an operating expense
            </p>
            <p>
                Create a draft, pick a category and Cash/Bank journal, then Post.
                Posted expenses reduce Net Profit on the P&amp;L dashboard.
            </p>
        </field>
    </record>

</odoo>
