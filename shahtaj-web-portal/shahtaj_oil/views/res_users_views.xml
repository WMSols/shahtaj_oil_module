<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
      Custom Frontend toggle: Dist + Manager + KPO + Warehouse (stored flags — res.users
      needs stored fields for form metadata). Default OFF. Hidden for OB/DM.
      Financial Dist-only (hidden).
    -->

    <record id="view_users_form_shahtaj_ui_mode" model="ir.ui.view">
        <field name="name">res.users.form.shahtaj.ui.mode</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <group name="other_preferences" position="inside">
                <field name="shahtaj_is_distributor" invisible="1"/>
                <field name="shahtaj_is_manager" invisible="1"/>
                <field name="shahtaj_is_kpo" invisible="1"/>
                <field name="shahtaj_is_warehouse" invisible="1"/>
                <field name="shahtaj_custom_frontend" widget="boolean_toggle"
                         groups="base.group_system"
                         invisible="not shahtaj_is_distributor and not shahtaj_is_manager and not shahtaj_is_kpo and not shahtaj_is_warehouse"/>
                <field name="shahtaj_distributor_financial_access" invisible="1"/>
            </group>
        </field>
    </record>

    <record id="view_users_form_simple_modif_shahtaj_ui_mode" model="ir.ui.view">
        <field name="name">res.users.preferences.form.shahtaj.ui.mode</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form_simple_modif"/>
        <field name="arch" type="xml">
            <group name="other_preferences" position="inside">
                <field name="shahtaj_is_distributor" invisible="1"/>
                <field name="shahtaj_is_manager" invisible="1"/>
                <field name="shahtaj_is_kpo" invisible="1"/>
                <field name="shahtaj_is_warehouse" invisible="1"/>
                <field name="shahtaj_custom_frontend" widget="boolean_toggle"
                         groups="base.group_system"
                         invisible="not shahtaj_is_distributor and not shahtaj_is_manager and not shahtaj_is_kpo and not shahtaj_is_warehouse"/>
                <field name="shahtaj_distributor_financial_access" invisible="1"/>
            </group>
        </field>
    </record>

    <record id="view_users_simple_form_shahtaj_ui_mode" model="ir.ui.view">
        <field name="name">res.users.simplified.form.shahtaj.ui.mode</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_simple_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='access_groups']" position="after">
                <field name="shahtaj_is_distributor" invisible="1"/>
                <field name="shahtaj_is_manager" invisible="1"/>
                <field name="shahtaj_is_kpo" invisible="1"/>
                <field name="shahtaj_is_warehouse" invisible="1"/>
                <group string="Shahtaj Interface" groups="base.group_system"
                       invisible="not shahtaj_is_distributor and not shahtaj_is_manager and not shahtaj_is_kpo and not shahtaj_is_warehouse">
                    <field name="shahtaj_custom_frontend" widget="boolean_toggle"/>
                    <field name="shahtaj_distributor_financial_access" invisible="1"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
