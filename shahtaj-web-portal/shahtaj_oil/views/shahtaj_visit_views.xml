<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_shahtaj_visit_list" model="ir.ui.view">
        <field name="name">shahtaj.visit.list</field>
        <field name="model">shahtaj.visit</field>
        <field name="arch" type="xml">
            <list decoration-muted="outcome in ('no_order', 'incomplete', 'undone') or state == 'cancelled'"
                  decoration-success="outcome == 'order' and state == 'completed'">
                <field name="started_at"/>
                <field name="visit_kind" string="OB / DM" widget="badge"
                       decoration-info="visit_kind == 'order_booker'"
                       decoration-warning="visit_kind == 'delivery_man'"/>
                <field name="order_booker_id"/>
                <field name="delivery_man_id" optional="show"/>
                <field name="shop_id"/>
                <field name="route_id" optional="show"/>
                <field name="state" widget="badge"/>
                <field name="outcome" widget="badge"
                       decoration-success="outcome == 'order'"
                       decoration-warning="outcome == 'no_order'"
                       decoration-danger="outcome in ('incomplete', 'undone')"/>
                <field name="duration_minutes" string="Duration (min)"/>
                <field name="order_amount" optional="show"/>
                <field name="shahtaj_order_approval_state" string="Verification" widget="badge"
                       optional="hide"
                       decoration-warning="shahtaj_order_approval_state == 'to_approve'"
                       decoration-success="shahtaj_order_approval_state == 'approved'"
                       decoration-danger="shahtaj_order_approval_state == 'rejected'"/>
                <field name="shahtaj_order_approval_reasons_display" string="Verification Reasons"
                       optional="hide"/>
                <field name="shahtaj_visit_discount_total" string="Discount" widget="monetary"
                       optional="hide"
                       decoration-danger="shahtaj_order_has_discount"/>
                <field name="shahtaj_order_has_discount" column_invisible="1"/>
                <field name="check_in_distance_m" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_shahtaj_visit_form" model="ir.ui.view">
        <field name="name">shahtaj.visit.form</field>
        <field name="model">shahtaj.visit</field>
        <field name="arch" type="xml">
            <form string="Shop Visit">
                <header>
                    <button name="action_shahtaj_undo_completed_visit" type="object"
                            string="Undo Visit (Redo)"
                            class="btn-warning"
                            confirm="Undo this completed visit? The linked sales order will be cancelled (only if not invoiced/delivered), the visit will be marked undone, and the order booker will be asked to check in again."
                            invisible="state != 'completed' or visit_kind == 'delivery_man'"
                            groups="shahtaj_oil.group_shahtaj_distributor,base.group_system"/>
                    <field name="state" widget="statusbar" statusbar_visible="in_progress,completed,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="visit_kind" readonly="1"/>
                            <field name="order_booker_id" readonly="1"/>
                            <field name="delivery_man_id" readonly="1"
                                   invisible="visit_kind != 'delivery_man'"/>
                            <field name="shop_id" readonly="1"/>
                            <field name="route_id" readonly="1"/>
                            <field name="visit_task_id" readonly="1"/>
                            <field name="dm_delivery_id" readonly="1"
                                   invisible="visit_kind != 'delivery_man'"/>
                        </group>
                        <group string="Timing">
                            <field name="started_at" readonly="1"/>
                            <field name="ended_at" readonly="1"/>
                            <field name="duration_minutes" readonly="1"/>
                            <field name="outcome" readonly="1"/>
                        </group>
                    </group>
                    <group string="GPS Check-in">
                        <group>
                            <field name="check_in_latitude" readonly="1"/>
                            <field name="check_in_longitude" readonly="1"/>
                            <field name="check_in_distance_m" readonly="1"/>
                        </group>
                    </group>
                    <group string="GPS at Place Order" invisible="not place_order_distance_m">
                        <group>
                            <field name="place_order_latitude" readonly="1"/>
                            <field name="place_order_longitude" readonly="1"/>
                            <field name="place_order_distance_m" readonly="1"/>
                        </group>
                    </group>
                    <group string="Order" invisible="not sale_order_id">
                        <group>
                            <field name="sale_order_id" readonly="1"/>
                            <field name="order_amount" readonly="1"/>
                            <field name="shahtaj_order_approval_state" string="Verification Status"
                                   widget="badge" readonly="1"
                                   decoration-warning="shahtaj_order_approval_state == 'to_approve'"
                                   decoration-success="shahtaj_order_approval_state == 'approved'"
                                   decoration-danger="shahtaj_order_approval_state == 'rejected'"/>
                            <field name="shahtaj_order_approval_reasons_display" string="Verification Reasons"
                                   readonly="1"
                                   invisible="shahtaj_order_approval_state == 'none'"/>
                        </group>
                        <group>
                            <field name="shahtaj_order_has_discount" string="Discount Applied" readonly="1"/>
                            <field name="shahtaj_order_catalog_amount" string="Catalog Total"
                                   widget="monetary" readonly="1"
                                   invisible="not shahtaj_order_has_discount"/>
                            <field name="shahtaj_visit_discount_total" string="Discount Amount"
                                   widget="monetary" readonly="1"
                                   decoration-danger="shahtaj_order_has_discount"/>
                            <field name="shahtaj_order_discount_reasons" string="Discount Reasons"
                                   readonly="1" invisible="not shahtaj_order_has_discount"/>
                            <field name="shahtaj_order_rejection_reason" string="Rejection Reason"
                                   readonly="1"
                                   invisible="shahtaj_order_approval_state != 'rejected'"/>
                        </group>
                        <field name="currency_id" invisible="1"/>
                    </group>
                    <notebook invisible="state != 'in_progress'">
                        <page string="Products" name="lines">
                            <field name="line_ids" readonly="state != 'in_progress'">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="shahtaj_qty_unlimited" column_invisible="1"/>
                                    <field name="shahtaj_qty_bookable" string="Available"
                                           invisible="shahtaj_qty_unlimited"/>
                                    <field name="product_uom_qty"/>
                                    <field name="catalog_price" string="Catalog Price" readonly="1" optional="show"/>
                                    <field name="price_unit" string="Sale Price"/>
                                    <field name="total_discount" string="Discount" readonly="1" optional="show"
                                           decoration-danger="has_discount"/>
                                    <field name="discount_reason" string="Discount Reason" optional="show"
                                           placeholder="e.g. Loyalty, Bulk"/>
                                    <field name="subtotal"/>
                                    <field name="has_discount" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                    <notebook invisible="state == 'in_progress'">
                        <page string="Products Ordered" name="lines_done">
                            <field name="line_ids" readonly="1">
                                <list>
                                    <field name="product_id"/>
                                    <field name="product_uom_qty"/>
                                    <field name="catalog_price" string="Catalog Price" optional="show"/>
                                    <field name="price_unit" string="Sale Price"/>
                                    <field name="total_discount" string="Discount" optional="show"
                                           decoration-danger="has_discount"/>
                                    <field name="discount_reason" string="Discount Reason" optional="show"/>
                                    <field name="subtotal"/>
                                    <field name="has_discount" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                    <group string="Notes">
                        <field name="notes" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_shahtaj_visit_list_booker" model="ir.ui.view">
        <field name="name">shahtaj.visit.list.booker</field>
        <field name="model">shahtaj.visit</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <list string="My Shop Visits" create="false" edit="false" delete="false"
                  decoration-muted="outcome in ('no_order', 'incomplete')"
                  decoration-success="outcome == 'order'"
                  decoration-info="state == 'in_progress'">
                <field name="started_at" string="Check-in"/>
                <field name="shop_name" string="Shop"/>
                <field name="route_name" string="Route" optional="show"/>
                <field name="state" widget="badge"/>
                <field name="outcome" widget="badge"
                       decoration-success="outcome == 'order'"
                       decoration-warning="outcome == 'no_order'"
                       decoration-danger="outcome == 'incomplete'"/>
                <field name="duration_minutes" string="Duration (min)"/>
                <field name="order_amount" string="Order Total" optional="show"/>
                <field name="shahtaj_order_has_discount" string="Discount" widget="boolean"
                       optional="show" readonly="1"/>
                <field name="shahtaj_visit_discount_total" string="Discount Amount" widget="monetary"
                       optional="show" readonly="1"
                       decoration-danger="shahtaj_order_has_discount"/>
                <field name="shahtaj_order_approval_state" string="Verification" widget="badge"
                       optional="show" readonly="1"
                       decoration-warning="shahtaj_order_approval_state == 'to_approve'"
                       decoration-success="shahtaj_order_approval_state == 'approved'"
                       decoration-danger="shahtaj_order_approval_state == 'rejected'"/>
                <field name="shahtaj_order_approval_reasons_display" string="Verification Reasons"
                       optional="show" readonly="1"/>
                <field name="shahtaj_order_has_discount" column_invisible="1"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="shop_id" column_invisible="1"/>
                <field name="route_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <!-- Order booker: read-only visit history (no product entry here) -->
    <record id="view_shahtaj_visit_form_booker_history" model="ir.ui.view">
        <field name="name">shahtaj.visit.form.booker.history</field>
        <field name="model">shahtaj.visit</field>
        <field name="priority">25</field>
        <field name="arch" type="xml">
            <form string="Visit History" create="false" edit="false" delete="false">
                <header>
                    <button name="action_open_booker_form" type="object"
                            string="Continue Active Visit"
                            class="oe_highlight"
                            invisible="state != 'in_progress'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="in_progress,completed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <div class="alert alert-info" role="alert" invisible="state != 'in_progress'">
                        This visit is still active. Use <b>Continue Active Visit</b> above
                        (or the <b>Active Visit</b> menu) to add products and place an order.
                    </div>
                    <group>
                        <group string="Visit">
                            <field name="shop_name" string="Shop"/>
                            <field name="route_name" string="Route"/>
                            <field name="started_at" string="Check-in Time"/>
                            <field name="ended_at" string="End Time" invisible="state != 'completed'"/>
                        </group>
                        <group string="Summary">
                            <field name="outcome" string="Result"/>
                            <field name="duration_minutes" string="Duration (min)"/>
                            <field name="check_in_distance_m" string="Check-in Distance (m)"/>
                            <field name="order_amount" string="Order Total"
                                   invisible="outcome != 'order'"/>
                            <field name="sale_order_name" string="Order Reference"
                                   invisible="outcome != 'order'"/>
                        </group>
                    </group>
                    <div class="alert alert-warning mb-3" role="alert"
                         invisible="shahtaj_order_approval_state != 'to_approve'">
                        <strong>Order pending verification</strong>
                        <p class="mb-0 mt-1">
                            This order is waiting for distributor approval.
                            <span invisible="not shahtaj_order_approval_reason_discount">
                                Discount requested:
                                <field name="shahtaj_order_discount_amount" widget="monetary"
                                       nolabel="1" readonly="1" class="oe_inline fw-bold"/>
                            </span>
                            <span invisible="not shahtaj_order_approval_reason_credit">
                                Credit limit exceeded for this shop.
                            </span>
                        </p>
                    </div>
                    <div class="alert alert-success mb-3" role="alert"
                         invisible="shahtaj_order_approval_state != 'approved'">
                        <strong>Order verified</strong>
                        <p class="mb-0 mt-1">
                            Distributor approved this order.
                            <span invisible="not shahtaj_order_has_discount">
                                Discount:
                                <field name="shahtaj_order_discount_amount" widget="monetary"
                                       nolabel="1" readonly="1" class="oe_inline fw-bold"/>.
                            </span>
                        </p>
                    </div>
                    <div class="alert alert-danger mb-3" role="alert"
                         invisible="shahtaj_order_approval_state != 'rejected'">
                        <strong>Order rejected</strong>
                        <p class="mb-0 mt-1">
                            Reason:
                            <field name="shahtaj_order_rejection_reason" nolabel="1"
                                   readonly="1" class="oe_inline"/>
                        </p>
                    </div>
                    <group string="Order &amp; Verification" invisible="outcome != 'order'">
                        <group>
                            <field name="shahtaj_order_approval_state" string="Verification Status"
                                   widget="badge" readonly="1"
                                   decoration-warning="shahtaj_order_approval_state == 'to_approve'"
                                   decoration-success="shahtaj_order_approval_state == 'approved'"
                                   decoration-danger="shahtaj_order_approval_state == 'rejected'"/>
                            <field name="shahtaj_order_approval_reasons_display" string="Verification Reasons"
                                   readonly="1"
                                   invisible="shahtaj_order_approval_state == 'none'"/>
                            <field name="shahtaj_order_approval_reason_discount" invisible="1"/>
                            <field name="shahtaj_order_approval_reason_credit" invisible="1"/>
                            <field name="shahtaj_order_has_discount" string="Discount Applied"
                                   readonly="1" widget="boolean"/>
                            <field name="shahtaj_order_catalog_amount" string="Catalog Total"
                                   widget="monetary" readonly="1"
                                   invisible="not shahtaj_order_has_discount"/>
                            <field name="shahtaj_visit_discount_total" string="Discount Amount"
                                   widget="monetary" readonly="1"
                                   decoration-danger="shahtaj_order_has_discount"/>
                        </group>
                        <group>
                            <field name="order_amount" string="Net Order Total" readonly="1"/>
                            <field name="shahtaj_order_discount_reasons" string="Discount Reasons"
                                   readonly="1" invisible="not shahtaj_order_has_discount"/>
                            <field name="shahtaj_order_rejection_reason" string="Rejection Reason"
                                   readonly="1"
                                   invisible="shahtaj_order_approval_state != 'rejected'"/>
                        </group>
                    </group>
                    <group string="Products" invisible="not line_ids">
                        <field name="line_ids" nolabel="1" readonly="1">
                            <list>
                                <field name="product_name" string="Product"/>
                                <field name="product_uom_qty" string="Qty"/>
                                <field name="catalog_price" string="Catalog Price" optional="show"/>
                                <field name="price_unit" string="Sale Price"/>
                                <field name="total_discount" string="Discount" optional="show"
                                       decoration-danger="has_discount"/>
                                <field name="discount_reason" string="Discount Reason" optional="show"/>
                                <field name="subtotal" string="Subtotal"/>
                                <field name="has_discount" column_invisible="1"/>
                            </list>
                        </field>
                    </group>
                    <group string="Notes" invisible="not notes">
                        <field name="notes" nolabel="1" readonly="1"/>
                    </group>
                    <field name="shop_id" invisible="1"/>
                    <field name="route_id" invisible="1"/>
                    <field name="sale_order_id" invisible="1"/>
                    <field name="currency_id" invisible="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_shahtaj_visit_form_booker" model="ir.ui.view">
        <field name="name">shahtaj.visit.form.booker</field>
        <field name="model">shahtaj.visit</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <form string="Active Shop Visit" create="false" delete="false">
                <header>
                    <button name="action_place_order" type="object" string="Place Order"
                            class="oe_highlight"
                            invisible="state != 'in_progress'"/>
                    <button name="action_end_without_order" type="object"
                            string="End Visit (No Order)"
                            invisible="state != 'in_progress'"/>
                    <field name="state" widget="statusbar" statusbar_visible="in_progress,completed"/>
                </header>
                <sheet>
                    <div class="alert alert-warning" role="alert" invisible="state != 'in_progress'">
                        <strong>Active visit</strong> at
                        <field name="shop_name" readonly="1" nolabel="1" class="oe_inline"/>
                        (<field name="route_name" readonly="1" nolabel="1" class="oe_inline"/>).
                        Add products below, then place the order or end without order.
                        GPS at place-order is required on the mobile app; this screen uses the check-in already done.
                        Started <field name="started_at" readonly="1" nolabel="1" class="oe_inline"/>.
                    </div>
                    <group>
                        <group>
                            <field name="shop_name" string="Shop" readonly="1"/>
                            <field name="route_name" string="Route" readonly="1"/>
                            <field name="shop_id" invisible="1"/>
                            <field name="route_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="started_at" readonly="1"/>
                            <field name="duration_minutes" readonly="1" string="Elapsed (min)"/>
                            <field name="check_in_distance_m" readonly="1"/>
                        </group>
                    </group>
                    <div class="alert alert-info mb-3" role="alert"
                         invisible="state != 'in_progress' or not shahtaj_visit_cart_needs_approval">
                        <strong>Verification may be required</strong>
                        <p class="mb-0 mt-1">
                            <span invisible="not shahtaj_visit_cart_needs_discount_approval">
                                This cart includes a discount and will be sent for distributor approval.
                            </span>
                            <span invisible="not shahtaj_visit_cart_needs_credit_approval">
                                This cart exceeds the shop credit limit and will be sent for distributor approval.
                            </span>
                        </p>
                    </div>
                    <group string="Shop Credit" invisible="state != 'in_progress'">
                        <group>
                            <field name="shahtaj_shop_credit_limit" readonly="1"/>
                            <field name="shahtaj_shop_effective_outstanding" widget="monetary" readonly="1"/>
                        </group>
                        <group>
                            <field name="shahtaj_shop_cart_exposure" widget="monetary" readonly="1"
                                   string="Cart Total (this visit)"/>
                            <field name="shahtaj_shop_credit_remaining" widget="monetary" readonly="1"
                                   decoration-danger="shahtaj_shop_credit_remaining == 0"/>
                        </group>
                    </group>
                    <field name="visit_task_id" invisible="1"/>
                    <field name="order_booker_id" invisible="1"/>
                    <field name="outcome" invisible="1"/>
                    <field name="currency_id" invisible="1"/>
                    <field name="shahtaj_order_has_discount" invisible="1"/>
                    <field name="shahtaj_order_discount_amount" invisible="1"/>
                    <field name="shahtaj_order_approval_state" invisible="1"/>
                    <field name="shahtaj_order_approval_reason_discount" invisible="1"/>
                    <field name="shahtaj_order_approval_reason_credit" invisible="1"/>
                    <field name="shahtaj_visit_cart_needs_approval" invisible="1"/>
                    <field name="shahtaj_visit_cart_needs_discount_approval" invisible="1"/>
                    <field name="shahtaj_visit_cart_needs_credit_approval" invisible="1"/>
                    <group string="Order Lines" invisible="state != 'in_progress'">
                        <field name="line_ids" nolabel="1">
                            <list editable="bottom">
                                <field name="product_id" placeholder="Select product"/>
                                <field name="shahtaj_qty_unlimited" column_invisible="1"/>
                                <field name="shahtaj_qty_bookable" string="Available"
                                       invisible="shahtaj_qty_unlimited"/>
                                <field name="product_uom_qty"/>
                                <field name="catalog_price" string="Catalog Price" readonly="1" optional="show"/>
                                <field name="price_unit" string="Sale Price"/>
                                <field name="total_discount" string="Discount" readonly="1" optional="show"
                                       decoration-danger="has_discount"/>
                                <field name="discount_reason" string="Discount Reason" optional="show"
                                       placeholder="e.g. Loyalty, Bulk"/>
                                <field name="subtotal"/>
                                <field name="has_discount" column_invisible="1"/>
                            </list>
                        </field>
                    </group>
                    <group string="Notes" invisible="state != 'in_progress'">
                        <field name="notes" nolabel="1"
                               placeholder="Add visit notes (optional)..."/>
                    </group>
                    <group string="Result" invisible="state != 'completed'">
                        <field name="outcome" readonly="1"/>
                        <field name="ended_at" readonly="1"/>
                        <field name="duration_minutes" readonly="1" string="Total Visit (min)"/>
                        <field name="sale_order_name" readonly="1" invisible="outcome != 'order'"/>
                        <field name="shahtaj_order_approval_state" string="Verification Status"
                               widget="badge" readonly="1"
                               invisible="outcome != 'order'"
                               decoration-warning="shahtaj_order_approval_state == 'to_approve'"
                               decoration-success="shahtaj_order_approval_state == 'approved'"
                               decoration-danger="shahtaj_order_approval_state == 'rejected'"/>
                        <field name="shahtaj_order_approval_reasons_display" string="Verification Reasons"
                               readonly="1"
                               invisible="outcome != 'order' or shahtaj_order_approval_state == 'none'"/>
                        <field name="shahtaj_visit_discount_total" string="Discount Amount"
                               widget="monetary" readonly="1"
                               invisible="outcome != 'order' or not shahtaj_order_has_discount"
                               decoration-danger="shahtaj_order_has_discount"/>
                        <field name="sale_order_id" invisible="1"/>
                        <field name="order_amount" readonly="1" invisible="outcome != 'order'"/>
                    </group>
                    <div class="alert alert-warning mb-3" role="alert"
                         invisible="shahtaj_order_approval_state != 'to_approve'">
                        <strong>Order pending verification</strong>
                        <p class="mb-0 mt-1">
                            <span invisible="not shahtaj_order_approval_reason_discount">
                                Distributor is reviewing this order's discount of
                                <field name="shahtaj_order_discount_amount" widget="monetary"
                                       nolabel="1" readonly="1" class="oe_inline fw-bold"/>.
                            </span>
                            <span invisible="not shahtaj_order_approval_reason_credit">
                                Distributor is reviewing this order because the shop credit limit is exceeded.
                            </span>
                        </p>
                    </div>
                    <div class="alert alert-success mb-3" role="alert"
                         invisible="shahtaj_order_approval_state != 'approved'">
                        <strong>Order verified</strong>
                        Your order was approved by the distributor.
                    </div>
                    <div class="alert alert-danger mb-3" role="alert"
                         invisible="shahtaj_order_approval_state != 'rejected'">
                        <strong>Order rejected</strong>
                        <field name="shahtaj_order_rejection_reason" nolabel="1"
                               readonly="1" class="mt-1"/>
                    </div>
                    <group string="Notes" invisible="state != 'completed' or not notes">
                        <field name="notes" nolabel="1" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_shahtaj_visit_search_booker" model="ir.ui.view">
        <field name="name">shahtaj.visit.search.booker</field>
        <field name="model">shahtaj.visit</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <search string="My Shop Visits">
                <field name="shop_name" string="Shop"/>
                <field name="route_name" string="Route"/>
                <filter string="In Progress" name="in_progress"
                        domain="[('state', '=', 'in_progress')]"/>
                <filter string="Completed" name="completed"
                        domain="[('state', '=', 'completed')]"/>
                <filter string="Today" name="today"
                        domain="[('started_at', '&gt;=', context_today().strftime('%Y-%m-%d 00:00:00'))]"/>
                <filter string="Order Placed" name="with_order"
                        domain="[('outcome', '=', 'order')]"/>
                <filter string="No Order" name="no_order"
                        domain="[('outcome', '=', 'no_order')]"/>
                <filter string="Incomplete" name="incomplete"
                        domain="[('outcome', '=', 'incomplete')]"/>
                <separator/>
                <filter string="Verification Pending" name="verification_pending"
                        domain="[('shahtaj_order_approval_state', '=', 'to_approve')]"/>
                <filter string="Credit Approval Required" name="credit_approval"
                        domain="[('shahtaj_order_approval_reason_credit', '=', True)]"/>
                <filter string="Discount Approval Required" name="discount_approval"
                        domain="[('shahtaj_order_approval_reason_discount', '=', True)]"/>
                <filter string="Verified Orders" name="verified_orders"
                        domain="[('shahtaj_order_approval_state', '=', 'approved')]"/>
                <filter string="Rejected Orders" name="rejected_orders"
                        domain="[('shahtaj_order_approval_state', '=', 'rejected')]"/>
                <separator/>
                <filter string="Day" name="group_day"
                        context="{'group_by': 'started_at:day'}"/>
            </search>
        </field>
    </record>

    <record id="view_shahtaj_visit_search" model="ir.ui.view">
        <field name="name">shahtaj.visit.search</field>
        <field name="model">shahtaj.visit</field>
        <field name="arch" type="xml">
            <search>
                <field name="shop_id"/>
                <field name="order_booker_id"/>
                <field name="delivery_man_id"/>
                <field name="route_id"/>
                <filter string="Today" name="today"
                        domain="[('started_at', '&gt;=', context_today().strftime('%Y-%m-%d 00:00:00'))]"/>
                <filter string="Order Booker" name="kind_ob"
                        domain="[('visit_kind', '=', 'order_booker')]"/>
                <filter string="Delivery Man" name="kind_dm"
                        domain="[('visit_kind', '=', 'delivery_man')]"/>
                <separator/>
                <filter string="In Progress" name="in_progress" domain="[('state', '=', 'in_progress')]"/>
                <filter string="Order Placed" name="with_order" domain="[('outcome', '=', 'order')]"/>
                <filter string="No Order" name="no_order" domain="[('outcome', '=', 'no_order')]"/>
                <filter string="Incomplete" name="incomplete" domain="[('outcome', '=', 'incomplete')]"/>
                <filter string="Undone" name="undone" domain="[('outcome', '=', 'undone')]"/>
                <filter string="Cancelled" name="cancelled" domain="[('state', '=', 'cancelled')]"/>
                <separator/>
                <filter string="Order Booker" name="group_booker" context="{'group_by': 'order_booker_id'}"/>
                <filter string="Delivery Man" name="group_dm" context="{'group_by': 'delivery_man_id'}"/>
                <filter string="Staff Type" name="group_kind" context="{'group_by': 'visit_kind'}"/>
                <filter string="Shop" name="group_shop" context="{'group_by': 'shop_id'}"/>
                <filter string="Route" name="group_route" context="{'group_by': 'route_id'}"/>
                <filter string="Day" name="group_day" context="{'group_by': 'started_at:day'}"/>
            </search>
        </field>
    </record>

    <record id="view_shahtaj_visit_graph" model="ir.ui.view">
        <field name="name">shahtaj.visit.graph</field>
        <field name="model">shahtaj.visit</field>
        <field name="arch" type="xml">
            <graph string="Visit Duration" type="bar">
                <field name="order_booker_id"/>
                <field name="duration_minutes" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_shahtaj_visit_pivot" model="ir.ui.view">
        <field name="name">shahtaj.visit.pivot</field>
        <field name="model">shahtaj.visit</field>
        <field name="arch" type="xml">
            <pivot string="Shop Visits">
                <field name="order_booker_id" type="row"/>
                <field name="outcome" type="col"/>
                <field name="duration_minutes" type="measure"/>
                <field name="order_amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_shahtaj_visit" model="ir.actions.act_window">
        <field name="name">Shop Visits</field>
        <field name="res_model">shahtaj.visit</field>
        <field name="view_mode">list,form,graph,pivot</field>
        <field name="search_view_id" ref="view_shahtaj_visit_search"/>
        <field name="context">{'search_default_today': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No shop visits recorded yet
            </p>
            <p>
                Visits are created when order bookers check in at a shop with GPS.
                Duration and orders are tracked here for distributor reporting.
            </p>
        </field>
    </record>

    <record id="action_shahtaj_my_visits" model="ir.actions.server">
        <field name="name">My Shop Visits</field>
        <field name="model_id" ref="model_shahtaj_visit"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open_my_visits()</field>
    </record>

    <record id="action_shahtaj_active_visit" model="ir.actions.server">
        <field name="name">Active Visit</field>
        <field name="model_id" ref="model_shahtaj_visit"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open_my_active_visit()</field>
    </record>

</odoo>
