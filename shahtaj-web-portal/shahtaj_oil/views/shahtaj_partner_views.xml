<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Shared shop list -->
    <record id="view_shahtaj_shop_list" model="ir.ui.view">
        <field name="name">res.partner.list.shahtaj.shop</field>
        <field name="model">res.partner</field>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <list decoration-warning="shahtaj_route_tag == 'unassigned'"
                  decoration-muted="shahtaj_route_tag == 'unassigned'">
                <header>
                    <button name="action_shahtaj_open_assign_to_route" type="object"
                            string="Assign to Route"
                            display="always"
                            groups="shahtaj_oil.group_shahtaj_distributor"/>
                    <button name="action_shahtaj_unassign_route" type="object"
                            string="Clear all routes"
                            confirm="Remove this shop from all routes? It will get no visit tasks until assigned again from a route."
                            groups="shahtaj_oil.group_shahtaj_distributor"/>
                </header>
                <field name="id" string="Shop ID" optional="show"/>
                <field name="name" string="Shop Name"/>
                <field name="owner_name"/>
                <field name="owner_phone"/>
                <field name="owner_cnic_number" optional="hide"/>
                <field name="shop_approval_state" widget="badge"
                       decoration-success="shop_approval_state == 'approved'"
                       decoration-warning="shop_approval_state == 'pending'"
                       decoration-danger="shop_approval_state == 'rejected'"/>
                <field name="shahtaj_visit_tag" string="Visit" widget="badge"
                       decoration-warning="shahtaj_visit_tag == 'not_visited'"
                       decoration-success="shahtaj_visit_tag == 'visited'"/>
                <field name="shahtaj_route_tag" string="Route" widget="badge"
                       decoration-warning="shahtaj_route_tag == 'unassigned'"
                       decoration-success="shahtaj_route_tag == 'assigned'"/>
                <field name="shahtaj_field_verified" optional="hide"/>
                <field name="shahtaj_routes_display" string="Zones / Routes" optional="show"/>
                <field name="route_ids" widget="many2many_tags" optional="hide"
                       options="{'no_create': True}"/>
                <field name="shahtaj_shop_category" widget="badge"
                       decoration-info="shahtaj_shop_category == 'cash'"
                       decoration-primary="shahtaj_shop_category == 'credit'"/>
                <field name="credit_limit" optional="hide"/>
                <field name="legacy_balance" optional="hide"/>
                <field name="outstanding_balance" optional="show"/>
                <field name="registered_by_name" string="Registered By" optional="show"/>
                <field name="registered_by_booker_id" string="Booker ID" optional="show"/>
                <field name="registered_by_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_shahtaj_shop_search" model="ir.ui.view">
        <field name="name">res.partner.search.shahtaj.shop</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <search string="Shops">
                <field name="name"/>
                <field name="owner_name"/>
                <field name="owner_phone"/>
                <field name="route_ids"/>
                <field name="shahtaj_routes_display"/>
                <filter string="Unassigned (no route)" name="unassigned_route"
                        domain="[('route_ids', '=', False)]"/>
                <filter string="Assigned to a route" name="assigned_route"
                        domain="[('route_ids', '!=', False)]"/>
                <filter string="Route tag: Unassigned" name="tag_unassigned"
                        domain="[('shahtaj_route_tag', '=', 'unassigned')]"/>
                <filter string="Route tag: Assigned" name="tag_assigned"
                        domain="[('shahtaj_route_tag', '=', 'assigned')]"/>
                <filter string="Not Visited" name="not_visited"
                        domain="[('shahtaj_visit_tag', '=', 'not_visited')]"/>
                <filter string="Visited" name="visited"
                        domain="[('shahtaj_visit_tag', '=', 'visited')]"/>
                <separator/>
                <filter string="Approved" name="approved"
                        domain="[('shop_approval_state', '=', 'approved')]"/>
                <filter string="Pending" name="pending"
                        domain="[('shop_approval_state', '=', 'pending')]"/>
                <separator/>
                <filter string="Route Tag" name="groupby_route_tag"
                        context="{'group_by': 'shahtaj_route_tag'}"/>
                <filter string="Visit Tag" name="groupby_visit"
                        context="{'group_by': 'shahtaj_visit_tag'}"/>
            </search>
        </field>
    </record>

    <!-- Distributor / back-office shop form -->
    <record id="view_shahtaj_shop_form" model="ir.ui.view">
        <field name="name">res.partner.form.shahtaj.shop</field>
        <field name="model">res.partner</field>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <form string="Shop">
                <header>
                    <button string="Save" special="save" class="oe_highlight" data-hotkey="s"/>
                    <button string="Discard" special="cancel" data-hotkey="j"/>
                    <button name="action_approve_shop" type="object" string="Approve Shop"
                            class="oe_highlight"
                            invisible="shop_approval_state == 'approved'"/>
                    <button name="action_reject_shop" type="object" string="Reject"
                            invisible="shop_approval_state == 'rejected'"/>
                    <button name="action_shahtaj_open_assign_to_route" type="object"
                            string="Assign to Route"
                            groups="shahtaj_oil.group_shahtaj_distributor"/>
                    <button name="action_shahtaj_unassign_route" type="object"
                            string="Clear all routes"
                            invisible="not route_ids"
                            confirm="Remove this shop from all routes? It will get no visit tasks until assigned again from a route."
                            groups="shahtaj_oil.group_shahtaj_distributor"/>
                    <button name="action_view_legacy_balance_move" type="object"
                            string="Legacy Balance Invoice"
                            invisible="not legacy_balance_move_id"
                            groups="shahtaj_oil.group_shahtaj_distributor_financial,account.group_account_readonly,account.group_account_invoice"/>
                    <field name="shahtaj_visit_tag" widget="badge"
                           decoration-warning="shahtaj_visit_tag == 'not_visited'"
                           decoration-success="shahtaj_visit_tag == 'visited'"/>
                    <field name="shahtaj_route_tag" widget="badge"
                           decoration-warning="shahtaj_route_tag == 'unassigned'"
                           decoration-success="shahtaj_route_tag == 'assigned'"/>
                    <field name="shop_approval_state" widget="statusbar"
                           statusbar_visible="pending,approved,rejected"/>
                </header>
                <sheet>
                    <field name="company_type" invisible="1"/>
                    <field name="is_shahtaj_shop" invisible="1"/>
                    <field name="type" invisible="1"/>
                    <field name="allowed_zone_ids" invisible="1"/>
                    <field name="allowed_route_ids" invisible="1"/>
                    <field name="legacy_balance_move_id" invisible="1"/>
                    <field name="currency_id" invisible="1"/>
                    <field name="sale_order_count" invisible="1"/>
                    <field name="account_move_count" invisible="1"/>
                    <field name="credit" invisible="1"/>
                    <field name="partner_latitude" invisible="1"/>
                    <field name="partner_longitude" invisible="1"/>
                    <div class="oe_button_box" name="button_box">
                        <button type="object"
                                name="action_shahtaj_view_sale_orders"
                                class="oe_stat_button"
                                icon="fa-shopping-cart"
                                groups="shahtaj_oil.group_shahtaj_distributor">
                            <field name="sale_order_count" widget="statinfo" string="Sales Orders"/>
                        </button>
                        <button type="object"
                                name="action_view_partner_invoices"
                                class="oe_stat_button"
                                icon="fa-pencil-square-o"
                                groups="shahtaj_oil.group_shahtaj_distributor_financial">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value">
                                    <field name="total_invoiced" widget="monetary"
                                           options="{'currency_field': 'currency_id'}"/>
                                </span>
                                <span class="o_stat_text">Invoiced</span>
                            </div>
                        </button>
                        <button type="object"
                                name="action_shahtaj_view_customer_payments"
                                class="oe_stat_button"
                                icon="fa-money"
                                groups="shahtaj_oil.group_shahtaj_distributor_financial">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value">
                                    <field name="outstanding_balance" widget="monetary"
                                           options="{'currency_field': 'currency_id'}"/>
                                </span>
                                <span class="o_stat_text">Outstanding</span>
                            </div>
                        </button>
                        <button type="object"
                                name="action_shahtaj_view_receivable_entries"
                                class="oe_stat_button"
                                icon="fa-book"
                                groups="shahtaj_oil.group_shahtaj_distributor_financial">
                            <span class="o_stat_text">Receivable Lines</span>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" string="Shop Name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Ali General Store" required="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Owner">
                            <field name="owner_name" placeholder="Optional"/>
                            <field name="owner_phone" widget="phone" placeholder="Optional"/>
                            <field name="owner_cnic_number" placeholder="Optional"/>
                        </group>
                        <group string="Registration">
                            <field name="registered_by_name" readonly="1"/>
                            <field name="registered_by_booker_id" readonly="1"/>
                            <field name="create_date" string="Registered On" readonly="1"/>
                            <field name="shahtaj_visit_tag" widget="badge" readonly="1"/>
                            <field name="shahtaj_field_verified" readonly="1"/>
                            <field name="shahtaj_field_verified_at" readonly="1"
                                   invisible="not shahtaj_field_verified"/>
                            <field name="shahtaj_field_verified_by_id" readonly="1"
                                   invisible="not shahtaj_field_verified"/>
                        </group>
                        <group string="Route assignment">
                            <div class="text-muted" colspan="2"
                                 invisible="route_ids">
                                Not on any route — no visit tasks.
                                Assign shops from <b>Routes</b> (shop checklist), or use
                                <b>Assign to Route</b> above.
                            </div>
                            <field name="shahtaj_routes_display"
                                   string="Zones / Routes"
                                   readonly="1"
                                   invisible="not route_ids"
                                   colspan="2"/>
                            <field name="route_ids" widget="many2many_tags"
                                   readonly="1"
                                   invisible="not route_ids"
                                   options="{'no_create': True}"
                                   string="Routes"/>
                            <field name="route_id" invisible="1"/>
                            <field name="zone_id" invisible="1"/>
                            <field name="registered_by_id" readonly="1" groups="base.group_no_one"/>
                        </group>
                    </group>
                    <group string="Credit and Balance">
                        <group>
                            <field name="shahtaj_shop_category" widget="radio"
                                   options="{'horizontal': true}"/>
                            <field name="use_partner_credit_limit" invisible="1"/>
                            <field name="credit_limit" string="Credit Limit (Rs)"
                                   invisible="shahtaj_shop_category != 'credit'"/>
                            <field name="legacy_balance" string="Legacy Balance (Rs)"
                                   readonly="legacy_balance_move_id"
                                   groups="shahtaj_oil.group_shahtaj_distributor_financial"/>
                            <field name="property_payment_term_id"
                                   string="Payment Terms"
                                   options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="outstanding_balance" string="Outstanding Balance (Rs)"
                                   groups="shahtaj_oil.group_shahtaj_distributor_financial"/>
                            <field name="credit" string="Total Receivable (Odoo)"
                                   groups="account.group_account_invoice,account.group_account_readonly"/>
                            <field name="property_account_receivable_id"
                                   string="Receivable Account"
                                   options="{'no_create': True}"/>
                        </group>
                    </group>
                    <group string="Verification Photos">
                        <group>
                            <field name="owner_cnic_front" widget="image" class="oe_avatar"/>
                            <field name="owner_cnic_back" widget="image" class="oe_avatar"/>
                        </group>
                        <group>
                            <field name="owner_photo" widget="image" class="oe_avatar"/>
                            <field name="shop_exterior_photo" widget="image" class="oe_avatar"
                                   readonly="1"/>
                            <div class="text-muted">
                                Shop exterior photo is captured by the order booker on the
                                first visit (with GPS). Distributors can view it only.
                            </div>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button string="Save" special="save" class="btn-primary" data-hotkey="s"/>
                    <button string="Discard" special="cancel" class="btn-secondary" data-hotkey="j"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Order booker: shops they registered -->
    <record id="view_shahtaj_shop_register_list_booker" model="ir.ui.view">
        <field name="name">res.partner.list.shahtaj.shop.register.booker</field>
        <field name="model">res.partner</field>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <list string="My Registered Shops" create="1" edit="0" delete="0">
                <field name="name" string="Shop Name"/>
                <field name="owner_name"/>
                <field name="owner_phone"/>
                <field name="owner_cnic_number" optional="hide"/>
                <field name="shop_approval_state" widget="badge"
                       decoration-success="shop_approval_state == 'approved'"
                       decoration-warning="shop_approval_state == 'pending'"
                       decoration-danger="shop_approval_state == 'rejected'"/>
                <field name="shahtaj_visit_tag" string="Visit" widget="badge"
                       decoration-warning="shahtaj_visit_tag == 'not_visited'"
                       decoration-success="shahtaj_visit_tag == 'visited'"/>
                <field name="shahtaj_route_tag" string="Route" widget="badge"
                       decoration-warning="shahtaj_route_tag == 'unassigned'"
                       decoration-success="shahtaj_route_tag == 'assigned'"/>
                <field name="shahtaj_routes_display" string="Zones / Routes" optional="show"/>
                <field name="create_date" string="Registered On" optional="show"/>
            </list>
        </field>
    </record>

    <!-- Order booker registration form (same fields, no approval controls) -->
    <record id="view_shahtaj_shop_register_form" model="ir.ui.view">
        <field name="name">res.partner.form.shahtaj.shop.register</field>
        <field name="model">res.partner</field>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <form string="Register New Shop">
                <header>
                    <button string="Register Shop" special="save" class="oe_highlight" data-hotkey="s"
                            invisible="id and shop_approval_state in ('approved', 'rejected')"/>
                    <button string="Discard" special="cancel" data-hotkey="j"/>
                    <field name="shop_approval_state" widget="statusbar"
                           statusbar_visible="pending,approved,rejected"
                           invisible="not id"/>
                </header>
                <sheet>
                    <field name="company_type" invisible="1"/>
                    <field name="is_shahtaj_shop" invisible="1"/>
                    <field name="type" invisible="1"/>
                    <field name="allowed_zone_ids" invisible="1"/>
                    <field name="allowed_route_ids" invisible="1"/>
                    <field name="legacy_balance_move_id" invisible="1"/>
                    <field name="currency_id" invisible="1"/>
                    <field name="registered_by_id" invisible="1"/>
                    <div class="alert alert-info" role="alert" invisible="id">
                        Submit shop details for distributor approval.
                        Zone and route are assigned later by the distributor from Routes.
                    </div>
                    <div class="alert alert-warning" role="alert"
                         invisible="shop_approval_state != 'pending' or not id">
                        Waiting for distributor approval. You can still edit this registration while pending.
                    </div>
                    <div class="alert alert-success" role="alert"
                         invisible="shop_approval_state != 'approved'">
                        This shop has been approved. Visit tasks will appear on your schedule.
                    </div>
                    <div class="alert alert-danger" role="alert"
                         invisible="shop_approval_state != 'rejected'">
                        This registration was rejected. Contact your distributor for details.
                    </div>
                    <div class="oe_title">
                        <label for="name" string="Shop Name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Ali General Store" required="1"
                                   readonly="shop_approval_state in ('approved', 'rejected')"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="owner_name" required="1" placeholder="Owner full name"
                                   readonly="shop_approval_state in ('approved', 'rejected')"/>
                            <field name="owner_phone" required="1" widget="phone"
                                   placeholder="03xx xxxxxxx"
                                   readonly="shop_approval_state in ('approved', 'rejected')"/>
                            <field name="owner_cnic_number"
                                   required="1"
                                   placeholder="Required for on-site register"
                                   readonly="shop_approval_state in ('approved', 'rejected')"/>
                        </group>
                        <group string="Routes (read-only)"
                               invisible="not id or not route_ids">
                            <field name="shahtaj_routes_display"
                                   string="Zones / Routes"
                                   readonly="1"
                                   colspan="2"/>
                            <field name="route_ids" widget="many2many_tags"
                                   readonly="1"
                                   options="{'no_create': True}"/>
                        </group>
                        <field name="route_id" invisible="1"/>
                        <field name="zone_id" invisible="1"/>
                    </group>
                    <group string="Shop GPS (required — marks Visited)">
                        <group>
                            <field name="shahtaj_visit_tag" widget="badge" readonly="1"/>
                            <field name="shahtaj_field_verified" invisible="1"/>
                            <field name="partner_latitude" string="GPS Latitude"
                                   required="1"
                                   placeholder="e.g. 31.5204"
                                   readonly="shop_approval_state in ('approved', 'rejected')"/>
                            <field name="partner_longitude" string="GPS Longitude"
                                   required="1"
                                   placeholder="e.g. 74.3587"
                                   readonly="shop_approval_state in ('approved', 'rejected')"/>
                        </group>
                        <group>
                            <div class="alert alert-info" role="alert">
                                On-site register requires GPS, exterior photo, and CNIC number.
                                The shop is marked <b>Visited</b> immediately.
                            </div>
                        </group>
                    </group>
                    <group string="Credit and Balance (Optional)"
                           invisible="shop_approval_state in ('approved', 'rejected')">
                        <group>
                            <field name="credit_limit" string="Credit Limit (Rs)"
                                   placeholder="Optional"/>
                            <field name="legacy_balance" string="Legacy Balance (Rs)"
                                   placeholder="Optional"/>
                        </group>
                    </group>
                    <group string="Photos">
                        <group>
                            <field name="owner_cnic_front" widget="image" class="oe_avatar"
                                   readonly="shop_approval_state in ('approved', 'rejected')"/>
                            <field name="owner_cnic_back" widget="image" class="oe_avatar"
                                   readonly="shop_approval_state in ('approved', 'rejected')"/>
                        </group>
                        <group>
                            <field name="owner_photo" widget="image" class="oe_avatar"
                                   readonly="shop_approval_state in ('approved', 'rejected')"/>
                            <field name="shop_exterior_photo" widget="image" class="oe_avatar"
                                   required="1"
                                   readonly="shop_approval_state in ('approved', 'rejected')"/>
                            <div class="text-muted">
                                Exterior photo is required with GPS for on-site registration.
                            </div>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button string="Register Shop" special="save" class="btn-primary" data-hotkey="s"/>
                    <button string="Discard" special="cancel" class="btn-secondary" data-hotkey="j"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Distributor: manage all shops (auto-approved) -->
    <record id="action_shahtaj_shop" model="ir.actions.act_window">
        <field name="name">Shops</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_shahtaj_shop', '=', True)]</field>
        <field name="search_view_id" ref="view_shahtaj_shop_search"/>
        <field name="context">{
            'shahtaj_shop_form': True,
            'default_is_shahtaj_shop': True,
            'default_shop_approval_state': 'approved',
            'default_company_type': 'company'
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Register your first retail shop
            </p>
            <p>
                Shop name is enough to create. Assign routes later (Assign to Route).
            <p>
                Create the shop with a name only. Assign routes later from
                <b>Routes</b> (shop checklist) or <b>Assign to Route</b>.
                Unassigned shops do not get visit tasks.
            </p>
            </p>
        </field>
    </record>

    <record id="action_shahtaj_shop_unassigned" model="ir.actions.act_window">
        <field name="name">Unassigned Shops</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[
            ('is_shahtaj_shop', '=', True),
            ('route_ids', '=', False),
        ]</field>
        <field name="search_view_id" ref="view_shahtaj_shop_search"/>
        <field name="context">{
            'shahtaj_shop_form': True,
            'default_is_shahtaj_shop': True,
            'default_shop_approval_state': 'approved',
            'default_company_type': 'company',
            'search_default_unassigned_route': 1,
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No unassigned shops
            </p>
            <p>
                Shops with no route links appear here. Open a route and use
                <b>Manage shops</b>, or select shops and click <b>Assign to Route</b>.
            </p>
        </field>
    </record>

    <record id="action_shahtaj_shop_unassigned_view_list" model="ir.actions.act_window.view">
        <field name="sequence">1</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_shahtaj_shop_list"/>
        <field name="act_window_id" ref="action_shahtaj_shop_unassigned"/>
    </record>

    <record id="action_shahtaj_shop_unassigned_view_form" model="ir.actions.act_window.view">
        <field name="sequence">2</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_shahtaj_shop_form"/>
        <field name="act_window_id" ref="action_shahtaj_shop_unassigned"/>
    </record>

    <record id="action_shahtaj_shop_view_list" model="ir.actions.act_window.view">
        <field name="sequence">1</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_shahtaj_shop_list"/>
        <field name="act_window_id" ref="action_shahtaj_shop"/>
    </record>

    <record id="action_shahtaj_shop_view_form" model="ir.actions.act_window.view">
        <field name="sequence">2</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_shahtaj_shop_form"/>
        <field name="act_window_id" ref="action_shahtaj_shop"/>
    </record>

    <!-- Order booker: list of own shop registrations -->
    <record id="action_shahtaj_shop_register" model="ir.actions.act_window">
        <field name="name">My Registered Shops</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[
            ('is_shahtaj_shop', '=', True),
            ('registered_by_id', '=', uid),
        ]</field>
        <field name="context">{
            'shahtaj_shop_form': True,
            'shahtaj_shop_register': True,
            'default_is_shahtaj_shop': True,
            'default_shop_approval_state': 'pending',
            'default_company_type': 'company',
            'default_registered_by_id': uid,
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No shops registered yet
            </p>
            <p>
                Click <b>New</b> to register a shop for distributor approval.
                Your registrations appear here with pending, approved, or rejected status.
            </p>
        </field>
    </record>

    <record id="action_shahtaj_shop_register_view_list" model="ir.actions.act_window.view">
        <field name="sequence">1</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_shahtaj_shop_register_list_booker"/>
        <field name="act_window_id" ref="action_shahtaj_shop_register"/>
    </record>

    <record id="action_shahtaj_shop_register_view_form" model="ir.actions.act_window.view">
        <field name="sequence">2</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_shahtaj_shop_register_form"/>
