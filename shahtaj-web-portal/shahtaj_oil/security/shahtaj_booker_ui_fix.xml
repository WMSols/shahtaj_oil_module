<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="0">
    <!-- Bookers may read/write shops they registered, are scheduled on, or have visit tasks for. -->
    <record id="rule_shahtaj_shop_booker_own" model="ir.rule">
      <field name="name">Order Booker: assigned and own shops</field>
      <field name="domain_force">[
        '|', '|', '|',
        ('is_shahtaj_shop', '=', False),
        ('registered_by_id', '=', user.id),
        ('route_id.weekly_schedule_ids.order_booker_id', '=', user.id),
        ('shahtaj_visit_task_ids.order_booker_id', '=', user.id),
      ]</field>
    </record>
  </data>
</odoo>
