<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="rule_shahtaj_shop_booker_own" model="ir.rule">
            <field name="name">Order Booker: assigned and own shops</field>
            <field name="domain_force">[
                '|', '|', '|',
                ('is_shahtaj_shop', '=', False),
                ('registered_by_id', '=', user.id),
                ('route_ids.weekly_schedule_ids.order_booker_id', '=', user.id),
                ('shahtaj_visit_task_ids.order_booker_id', '=', user.id),
            ]</field>
        </record>
        <!-- Order bookers may pick any zone/route when registering shops -->
        <delete model="ir.rule" id="rule_shahtaj_route_booker_read"/>
        <delete model="ir.rule" id="rule_shahtaj_zone_booker_read"/>

        <delete model="ir.rule" id="rule_shahtaj_distributor_read_bookers"/>

        <record id="rule_shahtaj_distributor_read_staff" model="ir.rule">
            <field name="name">Distributor: manage order bookers and delivery men</field>
            <field name="model_id" ref="base.model_res_users"/>
            <field name="domain_force">[
                '|', '|',
                ('shahtaj_is_order_booker', '=', True),
                ('shahtaj_is_delivery_man', '=', True),
                ('id', '=', user.id),
            ]</field>
            <field name="groups" eval="[(4, ref('group_shahtaj_distributor'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        <!-- Delivery man: see SOs from assigned bookers OR own DM delivery jobs (M1/M2) -->
        <record id="rule_shahtaj_delivery_man_sale_order" model="ir.rule">
            <field name="name">Delivery Man: assigned booker orders or own delivery jobs</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="domain_force">[
                '|',
                ('shahtaj_order_booker_id', 'in', user.shahtaj_assigned_booker_ids.ids),
                ('shahtaj_dm_delivery_ids.delivery_man_id', '=', user.id),
            ]</field>
            <field name="groups" eval="[(4, ref('group_shahtaj_delivery_man'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Delivery man: see sale order lines for those same orders -->
        <record id="rule_shahtaj_delivery_man_sale_order_line" model="ir.rule">
            <field name="name">Delivery Man: lines for assigned booker orders or own delivery jobs</field>
            <field name="model_id" ref="sale.model_sale_order_line"/>
            <field name="domain_force">[
                '|',
                ('order_id.shahtaj_order_booker_id', 'in', user.shahtaj_assigned_booker_ids.ids),
                ('order_id.shahtaj_dm_delivery_ids.delivery_man_id', '=', user.id),
            ]</field>
            <field name="groups" eval="[(4, ref('group_shahtaj_delivery_man'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Delivery man: see shops (partners) linked to assigned orders -->
        <record id="rule_shahtaj_delivery_man_partner" model="ir.rule">
            <field name="name">Delivery Man: shops from assigned orders</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="domain_force">[
                '|', '|',
                ('is_shahtaj_shop', '=', True),
                ('partner_share', '=', False),
                ('id', '=', user.partner_id.id),
            ]</field>
            <field name="groups" eval="[(4, ref('group_shahtaj_delivery_man'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Delivery man: own user + order bookers (name on delivery form) -->
        <record id="rule_shahtaj_delivery_man_own_user" model="ir.rule">
            <field name="name">Delivery Man: own user and order bookers</field>
            <field name="model_id" ref="base.model_res_users"/>
            <field name="domain_force">[
                '|',
                ('id', '=', user.id),
                ('shahtaj_is_order_booker', '=', True),
            ]</field>
            <field name="groups" eval="[(4, ref('group_shahtaj_delivery_man'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Delivery man: read products (for order lines) -->
        <record id="rule_shahtaj_delivery_man_product" model="ir.rule">
            <field name="name">Delivery Man: read all products</field>
            <field name="model_id" ref="product.model_product_product"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_shahtaj_delivery_man'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        <!-- Delivery Man: own delivery orders only -->
        <record id="rule_shahtaj_dm_delivery_own" model="ir.rule">
            <field name="name">Delivery Man: own delivery orders</field>
            <field name="model_id" ref="model_shahtaj_dm_delivery"/>
            <field name="domain_force">[('delivery_man_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_shahtaj_delivery_man'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_shahtaj_dm_delivery_line_own" model="ir.rule">
            <field name="name">Delivery Man: own delivery lines</field>
            <field name="model_id" ref="model_shahtaj_dm_delivery_line"/>
            <field name="domain_force">[('delivery_id.delivery_man_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_shahtaj_delivery_man'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
    </data>
</odoo>
