<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- Field workers: own reports only -->
        <record id="rule_shahtaj_field_report_booker_own" model="ir.rule">
            <field name="name">Order Booker: own field reports</field>
            <field name="model_id" ref="model_shahtaj_field_report"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_shahtaj_order_booker'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_shahtaj_field_report_dm_own" model="ir.rule">
            <field name="name">Delivery Man: own field reports</field>
            <field name="model_id" ref="model_shahtaj_field_report"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_shahtaj_delivery_man'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Office: all company reports -->
        <record id="rule_shahtaj_field_report_distributor_all" model="ir.rule">
            <field name="name">Distributor: all field reports</field>
            <field name="model_id" ref="model_shahtaj_field_report"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_shahtaj_distributor'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="rule_shahtaj_field_report_native_all" model="ir.rule">
            <field name="name">Native distributor UI: all field reports</field>
            <field name="model_id" ref="model_shahtaj_field_report"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_shahtaj_native_distributor_ui'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- Tags: readable by field + office; managed by office -->
        <record id="rule_shahtaj_field_report_tag_read_all" model="ir.rule">
            <field name="name">Field report tags: read active</field>
            <field name="model_id" ref="model_shahtaj_field_report_tag"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[
                (4, ref('group_shahtaj_order_booker')),
                (4, ref('group_shahtaj_delivery_man')),
                (4, ref('group_shahtaj_distributor')),
                (4, ref('group_shahtaj_native_distributor_ui')),
            ]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_shahtaj_field_report_tag_office_manage" model="ir.rule">
            <field name="name">Field report tags: office manage</field>
            <field name="model_id" ref="model_shahtaj_field_report_tag"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[
                (4, ref('group_shahtaj_distributor')),
                (4, ref('group_shahtaj_native_distributor_ui')),
            ]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

    </data>
</odoo>
