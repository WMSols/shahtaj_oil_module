<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_shahtaj_create_delivery_man_wizard_form" model="ir.ui.view">
        <field name="name">shahtaj.create.delivery.man.wizard.form</field>
        <field name="model">shahtaj.create.delivery.man.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Delivery Man">
                <group>
                    <field name="name" placeholder="e.g. Imran Khan"/>
                    <field name="login" placeholder="e.g. 03001234567 or imran"/>
                    <field name="password" password="True"/>
                    <field name="shahtaj_employee_code" placeholder="e.g. DM-001"/>
                </group>
                <div class="alert alert-info" role="alert">
                    Default access is applied automatically:
                    Internal User + Shahtaj / Delivery Man only.
                </div>
                <footer>
                    <button name="action_create_delivery_man" type="object"
                            string="Create Delivery Man" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_shahtaj_create_delivery_man_wizard" model="ir.actions.act_window">
        <field name="name">Create Delivery Man</field>
        <field name="res_model">shahtaj.create.delivery.man.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
