<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_shahtaj_dm_today_load_form" model="ir.ui.view">
        <field name="name">shahtaj.dm.today.load.form</field>
        <field name="model">shahtaj.dm.today.load</field>
        <field name="arch" type="xml">
            <form string="Today Load" create="false" delete="false">
                <header>
                    <button name="action_pick_today_load" type="object"
                            string="Pick to Van" class="oe_highlight"
                            icon="fa-truck"
                            confirm="Apply free van stock to today’s jobs, then move Pick Now from warehouse onto the van?"/>
                    <button name="action_refresh" type="object"
                            string="Refresh" class="btn-secondary" icon="fa-refresh"/>
                    <button name="action_open_my_deliveries" type="object"
                            string="Today's Jobs" class="btn-secondary"/>
                    <button name="action_open_van_transfer" type="object"
                            string="Van Stock Procedure" class="btn-secondary"
                            icon="fa-exchange"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>Today Load</h1>
                    </div>
                    <group>
                        <group>
                            <field name="load_date"/>
                            <field name="delivery_man_id"/>
                            <field name="shop_count"/>
                        </group>
                        <group>
                            <field name="warehouse_qty_available" string="Warehouse available"/>
                            <field name="van_qty_on_hand" string="On van"/>
                            <field name="total_still_to_pick" string="Still to pick"/>
                        </group>
                    </group>
                    <field name="summary_html" nolabel="1" colspan="2"/>
                    <group string="Stock right now (Warehouse vs Van)">
                        <field name="stock_summary_html" nolabel="1" colspan="2"/>
                    </group>
                    <div class="alert alert-info" role="alert">
                        <b>Van Covers</b> = free van stock applied first ·
                        <b>Pick Now</b> = warehouse → van (defaults to Still Need − Van Covers) ·
                        Today / overdue jobs only. Click <b>Refresh</b> after other picks.
                    </div>
                    <notebook>
                        <page string="Load Van" name="pick">
                            <field name="pick_line_ids">
                                <list editable="bottom" create="false" delete="false">
                                    <field name="product_id" readonly="1" force_save="1"/>
                                    <field name="qty_warehouse_available" string="Warehouse"
                                           readonly="1" force_save="1" sum="Warehouse"/>
                                    <field name="qty_on_van" string="On Van"
                                           readonly="1" force_save="1" sum="On Van"/>
                                    <field name="qty_still_needed" string="Still Need"
                                           readonly="1" force_save="1" sum="Still Need"/>
                                    <field name="qty_van_cover" string="Van Covers"
                                           readonly="1" force_save="1" sum="Van Covers"/>
                                    <field name="qty_to_pick" string="Pick Now"
                                           force_save="1" sum="Pick Now"/>
                                    <field name="qty_ordered" string="Assigned" optional="hide"
                                           readonly="1" force_save="1"/>
                                    <field name="qty_already_picked" string="Picked" optional="hide"
                                           readonly="1" force_save="1"/>
                                    <field name="qty_delivered" string="Delivered" optional="hide"
                                           readonly="1" force_save="1"/>
                                    <field name="product_uom_id" readonly="1" force_save="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Shop Progress" name="shops">
                            <field name="shop_line_ids" readonly="1">
                                <list>
                                    <field name="partner_id"/>
                                    <field name="sale_order_id"/>
                                    <field name="qty_ordered" string="Assigned" sum="Assigned"/>
                                    <field name="qty_picked" sum="Picked"/>
                                    <field name="qty_delivered" sum="Delivered"/>
                                    <field name="qty_left_on_van" string="On van" sum="On van"/>
                                    <field name="qty_still_to_pick" string="Still pick" sum="Still pick"/>
                                    <field name="state" string="Stock" widget="badge"
                                           decoration-danger="state in ('not_ready', 'returned')"
                                           decoration-info="state == 'ready'"
                                           decoration-warning="state in ('picked', 'partial')"
                                           decoration-success="state == 'delivered'"/>
                                    <field name="field_state" string="Stop" widget="badge"
                                           decoration-muted="field_state == 'pending'"
                                           decoration-info="field_state == 'in_transit'"
                                           decoration-warning="field_state == 'not_attended'"
                                           decoration-danger="field_state == 'failed'"
                                           decoration-success="field_state == 'done'"/>
                                    <button name="action_deliver_to_shop" type="object"
                                            string="Deliver (GPS)"
                                            icon="fa-map-marker"
                                            invisible="state not in ('picked', 'partial')"
                                            groups="shahtaj_oil.group_shahtaj_delivery_man"/>
                                    <button name="action_open_delivery" type="object"
                                            string="Open" icon="fa-external-link"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Use delivery model so action loads even if today.load ir.model xml id is late -->
    <record id="action_shahtaj_dm_today_load" model="ir.actions.server">
        <field name="name">Today Load</field>
        <field name="model_id" ref="model_shahtaj_dm_delivery"/>
        <field name="state">code</field>
        <field name="code">action = env['shahtaj.dm.today.load'].action_open()</field>
    </record>

</odoo>
