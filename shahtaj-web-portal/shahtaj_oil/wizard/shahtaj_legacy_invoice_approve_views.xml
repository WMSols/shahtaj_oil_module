<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_shahtaj_legacy_invoice_approve_wizard_form" model="ir.ui.view">
        <field name="name">shahtaj.legacy.invoice.approve.wizard.form</field>
        <field name="model">shahtaj.legacy.invoice.approve.wizard</field>
        <field name="arch" type="xml">
            <form string="Legacy Balance Invoice">
                <group>
                    <field name="shop_count"/>
                    <field name="legacy_total"/>
                    <field name="currency_id" invisible="1"/>
                </group>
                <field name="note" nolabel="1" readonly="1"/>
                <field name="partner_ids" invisible="1"/>
                <footer>
                    <button name="action_approve_with_invoice"
                            type="object"
                            string="Yes — Create Invoice"
                            class="btn-primary"/>
                    <button name="action_approve_without_invoice"
                            type="object"
                            string="No — Approve Only"
                            class="btn-secondary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
