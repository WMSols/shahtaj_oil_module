<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_shahtaj_assign_shops_route_wizard_form" model="ir.ui.view">
        <field name="name">shahtaj.assign.shops.route.wizard.form</field>
        <field name="model">shahtaj.assign.shops.route.wizard</field>
        <field name="arch" type="xml">
            <form string="Assign Shops to Route">
                <div class="alert alert-info" role="alert">
                    Create shops and routes separately, then assign shops here.
                    Unassigned shops do not get visit tasks until they are on a route.
                </div>
                <group>
                    <group>
                        <field name="route_id" options="{'no_create': True}"/>
                        <field name="zone_id"/>
                        <field name="only_unassigned"/>
                    </group>
                </group>
                <group string="Shops">
                    <field name="shop_ids" nolabel="1"
                           options="{'no_create': True}"
                           context="{'shahtaj_shop_form': True}">
                        <list>
                            <field name="name"/>
                            <field name="owner_name" optional="show"/>
                            <field name="route_id" string="Current Route"/>
                            <field name="shop_approval_state" widget="badge"/>
                            <field name="shahtaj_visit_tag" widget="badge" optional="show"/>
                        </list>
                    </field>
                </group>
                <footer>
                    <button name="action_assign" type="object"
                            string="Assign to Route"
                            class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_shahtaj_assign_shops_route_wizard" model="ir.actions.act_window">
        <field name="name">Assign Shops to Route</field>
        <field name="res_model">shahtaj.assign.shops.route.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
