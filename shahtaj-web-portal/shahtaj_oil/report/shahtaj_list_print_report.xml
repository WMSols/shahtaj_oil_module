<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="paperformat_shahtaj_list_print" model="report.paperformat">
        <field name="name">Shahtaj List Print</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">40</field>
        <field name="margin_bottom">20</field>
        <field name="margin_left">8</field>
        <field name="margin_right">8</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">35</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_shahtaj_list_print" model="ir.actions.report">
        <field name="name">List Print</field>
        <field name="model">shahtaj.list.print</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">shahtaj_oil.report_shahtaj_list_print</field>
        <field name="report_file">shahtaj_oil.report_shahtaj_list_print</field>
        <field name="print_report_name">object.title or 'List'</field>
        <field name="paperformat_id" ref="paperformat_shahtaj_list_print"/>
    </record>

    <template id="external_layout_shahtaj_list_print">
        <t t-if="not o" t-set="o" t-value="doc"/>
        <t t-if="not company">
            <t t-set="company" t-value="res_company"/>
        </t>
        <div class="header">
            <div style="text-align: right;">
                <img t-if="company.logo" t-att-src="image_data_uri(company.logo)" style="max-height: 58px; max-width: 180px;" alt="Company"/>
                <div style="font-weight: 700; font-size: 14px; margin-top: 4px;" t-esc="company.name"/>
            </div>
        </div>
        <div class="article" t-att-data-oe-model="o and o._name" t-att-data-oe-id="o and o.id">
            <t t-out="0"/>
        </div>
    </template>

    <template id="report_shahtaj_list_print">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="shahtaj_oil.external_layout_shahtaj_list_print">
                    <div class="page">
                        <h2 t-esc="doc.title"/>
                        <t t-if="doc.filter_lines()">
                            <p t-foreach="doc.filter_lines()" t-as="line" class="mb-0" t-esc="line"/>
                        </t>
                        <p t-else="" class="text-muted mb-0">No filters</p>
                        <t t-if="doc.summary_lines()">
                            <div class="mt-2">
                                <p t-foreach="doc.summary_lines()" t-as="line" class="mb-0 fw-bold" t-esc="line"/>
                            </div>
                        </t>
                        <p class="mt-3 mb-1 fw-bold">Total rows: <t t-esc="len(doc.row_list())"/></p>
                        <table class="table table-sm table-bordered" style="font-size: 9px;">
                            <thead>
                                <tr>
                                    <th style="text-align: center;">
                                        <span style="font-family: 'Lato-Bol', sans-serif; font-weight: 700;">Sr</span>
                                    </th>
                                    <th t-foreach="doc.column_list()" t-as="col">
                                        <span style="font-family: 'Lato-Bol', sans-serif; font-weight: 700;" t-esc="col"/>
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="doc.row_list()" t-as="row">
                                    <tr>
                                        <td style="text-align: center;" t-esc="row_index + 1"/>
                                        <td t-foreach="row['cells'] if isinstance(row, dict) else row" t-as="cell" t-esc="cell"/>
                                    </tr>
                                    <tr t-if="isinstance(row, dict) and row.get('lines')" style="background: #f6f6f6;">
                                        <td style="border-top: none;"/>
                                        <td t-att-colspan="len(row['cells'])" style="border-top: none; padding: 4px 8px 8px;">
                                            <div style="font-weight: 700; margin-bottom: 2px;">Products</div>
                                            <table style="width: auto; border-collapse: collapse;">
                                                <thead>
                                                    <tr>
                                                        <th style="text-align: left; border-bottom: 1px solid #ccc; padding: 1px 16px 1px 2px;">Product</th>
                                                        <th style="text-align: center; min-width: 70px; border-bottom: 1px solid #ccc; padding: 1px 8px;">Qty</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <tr t-foreach="row['lines']" t-as="line">
                                                        <td style="padding: 1px 16px 1px 2px; vertical-align: top;" t-esc="line[-2]"/>
                                                        <td style="padding: 1px 8px; text-align: center; vertical-align: top;" t-esc="line[-1]"/>
                                                    </tr>
                                                </tbody>
                                            </table>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                        <p class="mt-3 text-muted">Printed on <t t-esc="doc.printed_on_label()"/></p>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
